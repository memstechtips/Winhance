<Project>
  <!--
    Auto-imported by every .csproj under tests\ (MSBuild walks up looking
    for Directory.Build.props). Mirrors src\Directory.Build.props so that
    test projects also redirect bin\ and obj\ when extras\dev-build-and-run.ps1
    sets WINHANCE_LOCAL_BUILD_ROOT.

    Why for tests specifically: `dotnet test` launches testhost.exe from the
    test project's bin\ directory. Windows refuses to start executables
    living on a network share (Win32Exception 5 / "Access is denied"),
    so the test binaries MUST end up on a local path when the repo is
    SMB-mapped. Same race-with-MSBuild concern as src too.

    Set BEFORE the SDK is imported. Visual Studio doesn't set the env var,
    so VS-driven test runs still go to tests\<proj>\bin\obj\ as normal.
  -->
  <PropertyGroup Condition="'$(WINHANCE_LOCAL_BUILD_ROOT)' != ''">
    <BaseIntermediateOutputPath>$(WINHANCE_LOCAL_BUILD_ROOT)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(WINHANCE_LOCAL_BUILD_ROOT)\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
  <!--
    Analyzer + house-style enforcement, same settings as src\Directory.Build.props.
    Duplicated rather than imported: this file must NOT import src's, because that one
    also sets Base*OutputPath and the two would fight over the test-binary redirect
    that the comment above explains is load-bearing.

    Test code is analysed under the same .editorconfig as src. The rules that would
    otherwise fire constantly on tests (CA1707 underscores, for Method_Scenario_Expectation
    names) are already silenced there by ID, so no test-specific relaxation is needed.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10.0-Minimum</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.16.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
