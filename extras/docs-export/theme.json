      "BadgeRecommendedBorder": "ControlStrokeColorDefaultBrush",
      "BadgeRecommendedForeground": "SystemFillColorSuccessBrush",
      "BadgeDefaultBackground": "SystemFillColorNeutralBackgroundBrush",
      "BadgeDefaultBorder": "ControlStrokeColorDefaultBrush",
      "BadgeDefaultForeground": "SystemFillColorNeutralBrush",
      "BadgeCustomBackground": "SystemFillColorCautionBackgroundBrush",
      "BadgeCustomBorder": "ControlStrokeColorDefaultBrush",
      "BadgeCustomForeground": "SystemFillColorCautionBrush",
      "BadgePreferenceBackground": "SystemFillColorAttentionBackgroundBrush",
      "BadgePreferenceBorder": "ControlStrokeColorDefaultBrush",
      "BadgePreferenceForeground": "SystemFillColorAttentionBrush",
