        "VerticalAlignment": "Center",
        "BorderThickness": "1"
      }
    },
    "BadgeRecommendedStyle": {
      "target": "Border",
      "basedOn": "BadgePillBase",
      "setters": {
        "Background": "{ThemeResource BadgeRecommendedBackground}",
        "BorderBrush": "{ThemeResource BadgeRecommendedBorder}"
      }
    },
    "BadgeDefaultStyle": {
      "target": "Border",
      "basedOn": "BadgePillBase",
      "setters": {
        "Background": "{ThemeResource BadgeDefaultBackground}",
        "BorderBrush": "{ThemeResource BadgeDefaultBorder}"
