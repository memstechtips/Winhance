      "basedOn": "BadgePillBase",
      "setters": {
        "Background": "{ThemeResource BadgePreferenceBackground}",
        "BorderBrush": "{ThemeResource BadgePreferenceBorder}"
      }
    },
    "BadgeInstalledStyle": {
      "target": "Border",
      "basedOn": "BadgePillBase",
      "setters": {
        "Background": "{ThemeResource BadgeRecommendedBackground}",
        "BorderBrush": "{ThemeResource BadgeRecommendedBorder}"
      }
    },
    "BadgeNonReinstallableStyle": {
