<Project>
  <!--
    Auto-imported by every .csproj under src\ (MSBuild walks up looking
    for Directory.Build.props). Used to redirect bin\ and obj\ to a local
    path when extras\dev-build-and-run.ps1 sets WINHANCE_LOCAL_BUILD_ROOT.

    Why: when the repo lives on an SMB-mapped drive (Z:\ for the primary
    dev box), MSBuild's MakeDir-then-write task ordering races against
    the SMB redirector's namespace cache and breaks the build with
    DirectoryNotFoundException / MSB3191 / CS2012. Building straight to
    a local C:\ path bypasses the race entirely. Visual Studio doesn't
    set the env var, so VS builds in src\<proj>\bin and obj\ as normal.

    Set BEFORE the SDK is imported (Directory.Build.props is auto-loaded
    by Microsoft.Common.props which is the SDK's pre-import) so
    BaseIntermediateOutputPath takes effect for restore + build.
  -->
  <PropertyGroup Condition="'$(WINHANCE_LOCAL_BUILD_ROOT)' != ''">
    <BaseIntermediateOutputPath>$(WINHANCE_LOCAL_BUILD_ROOT)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(WINHANCE_LOCAL_BUILD_ROOT)\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
  <!--
    House-style enforcement. Added 2026-08-17.

    EnforceCodeStyleInBuild is the load-bearing line: IDExxxx style rules are DISABLED
    by default on command-line builds and only run inside Visual Studio without it, so
    without this the .editorconfig would silently do nothing on the SSH test gate.

    AnalysisLevel is PINNED rather than left at the default `latest`, so that installing
    a newer SDK cannot add new warnings on its own and turn a green gate red without
    anyone changing code.

    No TreatWarningsAsErrors — that remains a deliberate repo position. Warnings are
    driven to zero by hand first; promoting to error comes after, once clean.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10.0-Minimum</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.16.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
