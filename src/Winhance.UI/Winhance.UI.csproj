<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows SDK package version - aligns SDK.NET projections with packages -->
    <WindowsSdkPackageVersion>10.0.26100.48</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Winhance.UI</RootNamespace>
    <AssemblyName>Winhance</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only - ARM64 Windows can run x64 apps via emulation -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- CsWin32's tray bindings: NOTIFYICONDATAW's fixed text buffers and ExtractIconEx's HICON* out-parameters. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged deployment (no MSIX) -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained: bundles .NET runtime and App SDK runtime with the app (no separate runtime install needed) -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Precompiles Winhance's own DLLs so start-up skips most JIT work. Applies on publish only. -->
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!-- Clear /CETCOMPAT on the apphost. .NET 9+ defaults to it, opting into Intel CET /
         AMD shadow-stack enforcement. CoreCLR has an unpatched bug (dotnet/runtime#110920)
         where the user-mode-APC path trips a shadow-stack assertion and
         FailFast(0xc0000602)s the process before Main() runs. Affects users on CET-capable
         CPUs (Intel Tiger Lake+, AMD Zen 3+) running Windows without the ntdll CET fix from
         KB5044273 (Oct 2024) - i.e. unpatched LTSC and similar. Same symptom hit #356
         (WPF .NET 9) and #648 (WinUI3 .NET 10), same fault offset 0x10be3e inside
         KERNELBASE!RaiseFailFastException across both. Microsoft's documented workaround:
         https://learn.microsoft.com/en-us/dotnet/core/compatibility/interop/9.0/cet-support
         Trade-off: Winhance.exe specifically loses CET ROP-mitigation. -->
    <CETCompat>false</CETCompat>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required for CommunityToolkit.Mvvm 8.4.0 partial property source generators on .NET 10 -->
    <LangVersion>preview</LangVersion>
    <!-- MRT/PRI generation - requires Visual Studio MSBuild -->
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
    <!-- Application icon -->
    <ApplicationIcon>Assets\AppIcons\winhance-rocket.ico</ApplicationIcon>
    <!-- Use custom Program.cs entry point for single-instance enforcement -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>Winhance.UI.Program</StartupObject>
    <!-- Version information -->
    <Version>26.11.27</Version>
    <FileVersion>26.11.27</FileVersion>
    <AssemblyVersion>26.11.27</AssemblyVersion>
    <InformationalVersion>v26.11.27</InformationalVersion>
    <Copyright>Copyright © Marco du Plessis</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winhance.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.x. From 2.0 the NuGet version equals the release label.
         Keep the Microsoft.WindowsAppSDK *metapackage* - do NOT switch to the
         .WinUI component package. CommunityToolkit.WinUI / Xaml.Behaviors
         transitively depend on the metapackage (FluentIcons.WinUI 2.2 depends
         on the .WinUI component, at a version the metapackage pins), so
         referencing the component package as well pulls in BOTH families and
         the duplicate WinAppSDK build props break the build (MSB4011 + the MSIX
         CustomBeforeMicrosoftCommonTargets error). The metapackage bundles ~38 MB
         of Windows ML DLLs (onnxruntime.dll + DirectML.dll) that Winhance never
         uses; those are stripped from the installer instead - see
         extras/Winhance.Installer.iss. Ref: microsoft/WindowsAppSDK#5969. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- 1.7.260930100 adds the .pri to publish for unpackaged apps (WindowsAppSDK #3718, #6394); WindowsAppSDK 2.6.5
         alone resolves 1.7.251221100, whose publish leaves it out. Its .xbf half needs MSIX tooling: see PublishXbfFiles. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261102100" />
    <!-- CsWinRT - WinRT projections for .NET (needed for CommunityToolkit.WinUI 8.2+) -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Command-line flags Winhance is started with -->
    <PackageReference Include="System.CommandLine" Version="2.0.12" />

    <!-- Icons - Microsoft Fluent System Icons (4000+ icons) -->
    <PackageReference Include="FluentIcons.WinUI" Version="2.2.339.1" />

    <!-- WinUI Controls - 8.2.251219 is the latest stable 8.2.x; floor WinAppSDK 1.6+. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- Primitives ships WrapPanel (used as ItemsPanel on the SettingDescription badge row
         so AC/DC pill rows wrap on narrow windows). Same 8.2.x train as the other WinUI
         Toolkit refs below — version-locked to keep them upgrading together. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />

    <!-- XAML Behaviors for WinUI 3 - Custom behaviors (Behavior<T> base class) -->
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Triggers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />

    <!-- DataGrid 7.1.2 is the last release. The WCT 8.x reorg never ported a DataGrid
         (Microsoft abandoned the original contribution; WCT migration guide green-lights
         using 7.x DataGrid alongside 8.x packages because it has no toolkit dependency).
         Future successor when this hurts: WinUI.TableView (separate migration; different API). -->
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />

    <!-- Win32 Interop - Type-safe P/Invoke for single-instance activation and file dialogs -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- DI - aligned with .NET 10 runtime -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />

    <!-- Pin patched System.Security.Cryptography.Xml. It also floors its Pkcs dependency;
         both transitives are vulnerable (NU1903) below 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winhance.Core\Winhance.Core.csproj" />
    <ProjectReference Include="..\Winhance.Infrastructure\Winhance.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Localization json lives in Core, where the generator reads it; the Link keeps the shipped output layout. -->
  <ItemGroup>
    <Content Include="..\Winhance.Core\Features\Common\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Localization\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Content files (sponsors snapshot + logos) - offline fallback for SponsorsService -->
  <ItemGroup>
    <Content Include="Assets\Sponsors\sponsors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sponsors\logos\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The window icon, and the notification-area icons with a state badge; both are loaded from disk -->
  <ItemGroup>
    <Content Include="Assets\AppIcons\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Images loaded through ms-appx:/// and the icon credits. The SDK's default Content items reach the build folder
       but not publish; removing and re-adding them gives each one CopyToOutputDirectory, which publish follows. -->
  <ItemGroup>
    <Content Remove="Assets\AppIcons\*.png;Assets\ModeIcons\*.png;Assets\ICON-ATTRIBUTION.md" />
    <Content Include="Assets\AppIcons\*.png;Assets\ModeIcons\*.png;Assets\ICON-ATTRIBUTION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Windows update list snapshot - offline fallback for WindowsUpdateListService -->
  <ItemGroup>
    <Content Include="Assets\Updates\updates.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The XAML compiler copies each page's .xbf to the build folder only; publish copies what is in ResolvedFileToPublish.
       The Exclude keeps a file the SDK already lists from being added twice. -->
  <Target Name="PublishXbfFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XbfToPublish Include="@(_ProcessedXamlFilesToCopyLocalWithTargetPath)" Condition="'%(Extension)' == '.xbf'" />
      <ResolvedFileToPublish Include="@(_XbfToPublish)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(_XbfToPublish.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="'@(_XbfToPublish)' == ''" Text="No .xbf files found to publish: the XAML compiler's item name changed." />
  </Target>

  <!-- Embedded resources - uses local UI project files -->
  <ItemGroup>
    <EmbeddedResource Include="Features\Common\Resources\Configs\Winhance_Recommended_Config.winhance">
      <LogicalName>Winhance.UI.Resources.Configs.Winhance_Recommended_Config.winhance</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Features\Common\Resources\Configs\Winhance_Default_Config_Windows10_22H2.winhance">
      <LogicalName>Winhance.UI.Resources.Configs.Winhance_Default_Config_Windows10_22H2.winhance</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Features\Common\Resources\Configs\Winhance_Default_Config_Windows11_25H2.winhance">
      <LogicalName>Winhance.UI.Resources.Configs.Winhance_Default_Config_Windows11_25H2.winhance</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- CsWin32 NativeMethods.txt for P/Invoke generation -->
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>


</Project>





















































