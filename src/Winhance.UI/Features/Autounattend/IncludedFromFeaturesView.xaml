<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Autounattend.IncludedFromFeaturesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:viewModels="using:Winhance.UI.Features.Autounattend.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    x:DefaultBindMode="OneWay">

    <!-- Not in a shared dictionary: x:Bind needs a code-behind class, and the dictionaries App.xaml merges have
         none. -->
    <UserControl.Resources>

        <DataTemplate x:Key="IncludedSettingsCardTemplate" x:DataType="viewModels:IncludedCardViewModel">
            <controls:SettingsCard
                IsTabStop="False"
                AutomationProperties.LocalizedControlType="setting"
                Description="{x:Bind Description, Mode=OneWay}"
                HeaderIcon="{x:Bind IconResourceKey, Converter={StaticResource SectionIconConverter}, ConverterParameter=Color}"
                Padding="16,12,16,12">
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Header, Mode=OneWay}" VerticalAlignment="Center"/>
                        <commonControls:ModeTag Text="{x:Bind Tag, Mode=OneWay}"/>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <HyperlinkButton Content="{x:Bind OpenPageLabel, Mode=OneWay}" Click="{x:Bind OpenPage}"/>
            </controls:SettingsCard>
        </DataTemplate>

        <!-- MinHeight is local because the toolkit sets the card floor from a Style setter. -->
        <DataTemplate x:Key="IncludedNamesCardTemplate" x:DataType="viewModels:IncludedAppsCardViewModel">
            <controls:SettingsCard
                Visibility="{x:Bind ShowsList, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsTabStop="False"
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch"
                BorderThickness="1,0,1,1"
                Padding="{StaticResource SettingsChildCardPadding}"
                MinHeight="0"
                CornerRadius="{x:Bind ListCornerRadius, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind Names, Mode=OneWay}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"/>
            </controls:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="IncludedAppsCardTemplate" x:DataType="viewModels:IncludedAppsCardViewModel">
            <controls:SettingsCard
                IsTabStop="False"
                AutomationProperties.LocalizedControlType="setting"
                HeaderIcon="{x:Bind IconResourceKey, Converter={StaticResource SectionIconConverter}}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
                Padding="16,12,16,12">
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Header, Mode=OneWay}" VerticalAlignment="Center"/>
                        <commonControls:ModeTag Text="{x:Bind Tag, Mode=OneWay}"/>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock
                        Text="{x:Bind Description, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"/>
                </controls:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton
                        Visibility="{x:Bind HasList, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="{x:Bind ListToggleLabel, Mode=OneWay}"
                        Click="{x:Bind ToggleList}"/>
                    <HyperlinkButton Content="{x:Bind OpenPageLabel, Mode=OneWay}" Click="{x:Bind OpenPage}"/>
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>

    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard
            Visibility="{x:Bind ViewModel.ShowsStartedFrom, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            IsTabStop="False"
            AutomationProperties.LocalizedControlType="setting"
            Header="{x:Bind ViewModel.StartedFromHeader, Mode=OneWay}"
            Description="{x:Bind ViewModel.StartedFromDescription, Mode=OneWay}"
            Padding="16,12,16,12">
            <ComboBox
                MinWidth="200"
                ItemsSource="{x:Bind ViewModel.StartSeedOptions, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedSeedIndex, Mode=OneWay}"
                SelectionChanged="OnStartSeedChanged"/>
        </controls:SettingsCard>

        <StackPanel>
            <ContentControl
                Content="{x:Bind ViewModel.RemovedApps}"
                ContentTemplate="{StaticResource IncludedAppsCardTemplate}"
                HorizontalContentAlignment="Stretch"
                IsTabStop="False"/>
            <ContentControl
                Content="{x:Bind ViewModel.RemovedApps}"
                ContentTemplate="{StaticResource IncludedNamesCardTemplate}"
                HorizontalContentAlignment="Stretch"
                IsTabStop="False"/>
        </StackPanel>

        <!-- The installer cards sit here rather than on the grouped list, beside the apps they install. -->
        <StackPanel>
            <ContentControl
                Content="{x:Bind ViewModel.InstalledApps}"
                ContentTemplate="{StaticResource IncludedAppsCardTemplate}"
                HorizontalContentAlignment="Stretch"
                IsTabStop="False"/>
            <ContentControl
                Content="{x:Bind ViewModel.InstalledApps}"
                ContentTemplate="{StaticResource IncludedNamesCardTemplate}"
                HorizontalContentAlignment="Stretch"
                IsTabStop="False"/>
            <StackPanel Visibility="{x:Bind ViewModel.InstalledApps.HasInstallerCards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsCard
                    IsTabStop="False"
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch"
                    BorderThickness="1,0,1,1"
                    Padding="{StaticResource SettingsChildCardPadding}"
                    MinHeight="0"
                    CornerRadius="0">
                    <CheckBox
                        Content="{x:Bind ViewModel.InstalledApps.StageOnMediaLabel, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.InstalledApps.StageOnMedia, Mode=TwoWay}"/>
                </controls:SettingsCard>
                <controls:SettingsCard
                    IsTabStop="False"
                    AutomationProperties.LocalizedControlType="setting"
                    Header="{x:Bind ViewModel.InstalledApps.OwnInstallersName, Mode=OneWay}"
                    BorderThickness="1,0,1,1"
                    Padding="{StaticResource SettingsChildCardPadding}"
                    CornerRadius="{x:Bind ViewModel.InstalledApps.OwnInstallersCornerRadius, Mode=OneWay}">
                    <controls:SettingsCard.Description>
                        <TextBlock
                            Text="{x:Bind ViewModel.InstalledApps.OwnInstallersDescription, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                    </controls:SettingsCard.Description>
                    <Button
                        Content="{x:Bind ViewModel.InstalledApps.AddOwnInstallerLabel, Mode=OneWay}"
                        Click="{x:Bind ViewModel.InstalledApps.AddOwnInstaller}"/>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Visibility="{x:Bind ViewModel.InstalledApps.HasOwnInstallers, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    IsTabStop="False"
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch"
                    BorderThickness="1,0,1,1"
                    Padding="{StaticResource SettingsChildCardPadding}"
                    MinHeight="0"
                    CornerRadius="0,0,4,4">
                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.InstalledApps.OwnInstallerRows, Mode=OneWay}"
                        ItemTemplate="{StaticResource ListRowTemplate}"
                        IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>

        <ContentControl
            Content="{x:Bind ViewModel.OptimizeSettings}"
            ContentTemplate="{StaticResource IncludedSettingsCardTemplate}"
            HorizontalContentAlignment="Stretch"
            IsTabStop="False"/>
        <ContentControl
            Content="{x:Bind ViewModel.CustomizeSettings}"
            ContentTemplate="{StaticResource IncludedSettingsCardTemplate}"
            HorizontalContentAlignment="Stretch"
            IsTabStop="False"/>
    </StackPanel>
</UserControl>
