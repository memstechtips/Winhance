<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Autounattend.AutounattendSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:selectors="using:Winhance.UI.Features.Common.TemplateSelectors"
    xmlns:viewModels="using:Winhance.UI.Features.Autounattend.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    x:DefaultBindMode="OneWay">

    <!-- Not in a shared dictionary: x:Bind needs a code-behind class, and the dictionaries App.xaml merges have
         none. A template named as a StaticResource has to be declared above the template that names it. -->
    <UserControl.Resources>

        <!-- MinHeight is local because the toolkit sets the card floor from a Style setter. The left padding is the
             group row's 54 plus one icon column (24 + 16). -->
        <DataTemplate x:Key="IncludedFeatureRowTemplate" x:DataType="viewModels:IncludedRowViewModel">
            <controls:SettingsCard
                IsTabStop="False"
                AutomationProperties.LocalizedControlType="setting"
                Header="{x:Bind Name, Mode=OneWay}"
                HeaderIcon="{x:Bind IconResourceKey, Converter={StaticResource SectionIconConverter}}"
                BorderThickness="1,0,1,1"
                Padding="94,8,52,8"
                MinHeight="0"
                CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind CountText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
            </controls:SettingsCard>
        </DataTemplate>

        <!-- The child cards stay square: the Optimize and Customize group rows always follow this row. -->
        <DataTemplate x:Key="IncludedExternalAppsRowTemplate" x:DataType="viewModels:ExternalAppsRowViewModel">
            <StackPanel>
                <controls:SettingsCard
                    IsTabStop="False"
                    AutomationProperties.LocalizedControlType="setting"
                    Header="{x:Bind Name, Mode=OneWay}"
                    Description="{x:Bind Description, Mode=OneWay}"
                    HeaderIcon="{x:Bind IconResourceKey, Converter={StaticResource SectionIconConverter}}"
                    BorderThickness="1,0,1,1"
                    Padding="94,8,52,8"
                    MinHeight="0"
                    CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind CountText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"/>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Visibility="{x:Bind IsWarning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    IsTabStop="False"
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch"
                    BorderThickness="1,0,1,1"
                    Padding="94,8,52,8"
                    MinHeight="0"
                    CornerRadius="0">
                    <commonControls:QuietInfoBar
                        IsOpen="{x:Bind IsWarning, Mode=OneWay}"
                        Severity="Warning"
                        Message="{x:Bind WarningText}"
                        IsClosable="False"/>
                </controls:SettingsCard>
                <StackPanel Visibility="{x:Bind HasInstallerCards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsCard
                        IsTabStop="False"
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        BorderThickness="1,0,1,1"
                        Padding="94,8,52,8"
                        MinHeight="0"
                        CornerRadius="0">
                        <!-- AnimatedIcon.State: the check glyph would otherwise mirror this card's hover state. -->
                        <CheckBox
                            Content="{x:Bind StageOnMediaLabel, Mode=OneWay}"
                            IsChecked="{x:Bind StageOnMedia, Mode=TwoWay}"
                            AnimatedIcon.State="Normal"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        IsTabStop="False"
                        AutomationProperties.LocalizedControlType="setting"
                        Header="{x:Bind OwnInstallersName, Mode=OneWay}"
                        BorderThickness="1,0,1,1"
                        Padding="94,8,52,8"
                        MinHeight="0"
                        CornerRadius="0">
                        <controls:SettingsCard.Description>
                            <TextBlock
                                Text="{x:Bind OwnInstallersDescription, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </controls:SettingsCard.Description>
                        <Button
                            Content="{x:Bind AddOwnInstallerLabel, Mode=OneWay}"
                            Click="{x:Bind AddOwnInstaller}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Visibility="{x:Bind HasOwnInstallers, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsTabStop="False"
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        BorderThickness="1,0,1,1"
                        Padding="94,8,52,8"
                        MinHeight="0"
                        CornerRadius="0">
                        <ItemsControl ItemsSource="{x:Bind OwnInstallerRows, Mode=OneWay}" ItemTemplate="{StaticResource ListRowTemplate}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <selectors:IncludedRowTemplateSelector
            x:Key="IncludedRowTemplateSelector"
            FeatureTemplate="{StaticResource IncludedFeatureRowTemplate}"
            ExternalAppsTemplate="{StaticResource IncludedExternalAppsRowTemplate}"/>

        <DataTemplate x:Key="IncludedGroupRowTemplate" x:DataType="viewModels:IncludedRowViewModel">
            <StackPanel>
                <commonControls:ClickableSettingsCard
                    Invoked="{x:Bind ToggleExpander}"
                    IsTabStop="True"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                    AutomationProperties.LocalizedControlType="setting"
                    Header="{x:Bind Name, Mode=OneWay}"
                    HeaderIcon="{x:Bind IconResourceKey, Converter={StaticResource SectionIconConverter}, ConverterParameter=Color}"
                    BorderThickness="1,0,1,1"
                    Padding="54,8,52,8"
                    MinHeight="0"
                    CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
                    <!-- Hide the built-in chevron IsClickEnabled adds; the row draws its own below. -->
                    <commonControls:ClickableSettingsCard.Resources>
                        <x:Double x:Key="SettingsCardActionIconMaxSize">0</x:Double>
                        <Thickness x:Key="SettingsCardActionIconMargin">0</Thickness>
                    </commonControls:ClickableSettingsCard.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind CountText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                        <Grid Width="20" Height="20">
                            <FontIcon
                                Glyph="&#xE70E;"
                                FontSize="{StaticResource CardExpanderChevronFontSize}"
                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <FontIcon
                                Glyph="&#xE70D;"
                                FontSize="{StaticResource CardExpanderChevronFontSize}"
                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </commonControls:ClickableSettingsCard>
                <ItemsControl
                    ItemsSource="{x:Bind Children}"
                    ItemTemplateSelector="{StaticResource IncludedRowTemplateSelector}"
                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <commonControls:SettingsListView
        x:Name="SettingsList"
        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
        HasNoSearchResults="{x:Bind HasNoSearchResults, Mode=OneWay}"
        Footer="{x:Bind Footer, Mode=OneWay}">
        <commonControls:SettingsListView.Header>
            <StackPanel Margin="0,0,0,8">
                <commonControls:ClickableSettingsCard
                    Invoked="{x:Bind ViewModel.ToggleIncludedExpander}"
                    IsTabStop="True"
                    AutomationProperties.Name="{x:Bind ViewModel.IncludedTitle, Mode=OneWay}"
                    AutomationProperties.LocalizedControlType="setting"
                    Header="{x:Bind ViewModel.IncludedTitle, Mode=OneWay}"
                    HeaderIcon="{x:Bind ViewModel.IncludedIcon, Converter={StaticResource IconConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="{x:Bind ViewModel.IncludedCornerRadius, Mode=OneWay}"
                    Padding="{StaticResource SettingsCardPadding}">
                    <commonControls:ClickableSettingsCard.Resources>
                        <x:Double x:Key="SettingsCardActionIconMaxSize">0</x:Double>
                        <Thickness x:Key="SettingsCardActionIconMargin">0</Thickness>
                    </commonControls:ClickableSettingsCard.Resources>
                    <commonControls:ClickableSettingsCard.Description>
                        <TextBlock
                            Text="{x:Bind ViewModel.IncludedDescription, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                    </commonControls:ClickableSettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.IncludedCountText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                        <Grid Width="20" Height="20">
                            <FontIcon
                                Glyph="&#xE70E;"
                                FontSize="{StaticResource CardExpanderChevronFontSize}"
                                Visibility="{x:Bind ViewModel.IsIncludedExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <FontIcon
                                Glyph="&#xE70D;"
                                FontSize="{StaticResource CardExpanderChevronFontSize}"
                                Visibility="{x:Bind ViewModel.IsIncludedExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </commonControls:ClickableSettingsCard>
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.IncludedGroups, Mode=OneWay}"
                    ItemTemplate="{StaticResource IncludedGroupRowTemplate}"
                    Visibility="{x:Bind ViewModel.IsIncludedExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </commonControls:SettingsListView.Header>
    </commonControls:SettingsListView>
</UserControl>
