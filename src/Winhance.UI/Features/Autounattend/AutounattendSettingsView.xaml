<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Autounattend.AutounattendSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:local="using:Winhance.UI.Features.Autounattend"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    x:DefaultBindMode="OneWay">

    <commonControls:SettingsListView
        x:Name="SettingsList"
        ScrollMemoryKey="Autounattend"
        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
        HasNoSearchResults="{x:Bind HasNoSearchResults, Mode=OneWay}">
        <commonControls:SettingsListView.Header>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Margin="0,0,0,8">
                <TextBlock
                    Text="{x:Bind ViewModel.IncludedTitle, Mode=OneWay}"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <TextBlock
                    Text="{x:Bind ViewModel.IncludedDescription, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="1,0,0,4"/>

                <local:IncludedFromFeaturesView/>
            </StackPanel>
        </commonControls:SettingsListView.Header>
    </commonControls:SettingsListView>
</UserControl>
