<?xml version="1.0" encoding="utf-8"?>
<winControls:SectionPage
    x:Class="Winhance.UI.Features.Autounattend.AutounattendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:autounattend="using:Winhance.UI.Features.Autounattend"
    NavigationCacheMode="Disabled">

    <!-- The page has one section, so the shell draws its view where the other pages draw their section cards.
         Not cached: the view reloads the cards on every visit. -->
    <winControls:SectionPageShell x:Name="Shell" PageIcon="TextBulletListSquareSparkle">
        <winControls:SectionPageShell.SectionContent>
            <autounattend:AutounattendSettingsView x:Name="SettingsView"/>
        </winControls:SectionPageShell.SectionContent>
    </winControls:SectionPageShell>
</winControls:SectionPage>
