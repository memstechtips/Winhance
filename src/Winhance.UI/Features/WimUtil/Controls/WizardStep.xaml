<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.WimUtil.Controls.WizardStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:local="using:Winhance.UI.Features.WimUtil.Controls"
    x:DefaultBindMode="OneWay">

    <StackPanel>
        <!-- A disabled control shows no tooltip, so the reason sits on a wrapper. -->
        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind local:WizardStep.LockedReason(State.IsAvailable, State.StatusText)}">
            <commonControls:ClickableSettingsCard
                Invoked="OnHeaderInvoked"
                IsTabStop="True"
                IsEnabled="{x:Bind State.IsAvailable}"
                AutomationProperties.Name="{x:Bind State.AccessibleName}"
                AutomationProperties.HelpText="{x:Bind State.StatusText}"
                MinHeight="72"
                CornerRadius="{x:Bind local:WizardStep.HeaderCornerRadius(State.IsExpanded)}"
                ShowsActionIcon="False">
                <commonControls:ClickableSettingsCard.Header>
                    <Grid ColumnSpacing="12"
                          Opacity="{x:Bind local:WizardStep.AvailableOpacity(State.IsAvailable)}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fluentIcons:FluentIcon x:Name="StepFluentIcon"
                                                Icon="{x:Bind State.Icon}"
                                                IconVariant="Regular"
                                                FontSize="36"
                                                VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind State.AccessibleName}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind State.StatusText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </commonControls:ClickableSettingsCard.Header>

                <Grid Width="20" Height="20">
                    <fluentIcons:FluentIcon x:Name="LockIcon"
                                            x:Load="{x:Bind State.IsLocked}"
                                            Icon="LockClosed" IconVariant="Color" FontSize="{StaticResource CardIconFontSize}"/>
                    <fluentIcons:FluentIcon x:Name="CompleteIcon"
                                            x:Load="{x:Bind local:WizardStep.ShowsCheck(State.IsComplete, State.IsLocked)}"
                                            Icon="CheckmarkCircle" IconVariant="Color"
                                            FontSize="{StaticResource StatusIconFontSize}"/>
                    <fluentIcons:FluentIcon x:Name="ExpandChevronIcon"
                                            x:Load="{x:Bind local:WizardStep.ShowsChevron(State.IsComplete, State.IsLocked)}"
                                            Icon="{x:Bind local:WizardStep.ChevronIcon(State.IsExpanded)}"
                                            IconVariant="Regular"
                                            FontSize="{StaticResource CardExpanderChevronFontSize}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Grid>
            </commonControls:ClickableSettingsCard>
        </Grid>

        <Border x:Name="BodyCard"
                Visibility="{x:Bind State.IsExpanded}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="{StaticResource JoinedCardCornerRadius}"
                Padding="60,16,16,16">
            <ContentControl Content="{x:Bind Body}"
                            IsEnabled="{x:Bind State.IsAvailable}"
                            IsTabStop="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"/>
        </Border>
    </StackPanel>
</UserControl>
