<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.WimUtil.Controls.WizardStepRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:local="using:Winhance.UI.Features.WimUtil.Controls"
    xmlns:models="using:Winhance.UI.Features.WimUtil.Models"
    x:DefaultBindMode="OneWay"
    IsTabStop="False">

    <UserControl.Resources>
        <x:Double x:Key="StepRailRowHeight">52</x:Double>
        <x:Double x:Key="StepRailMarkerSize">32</x:Double>

        <Style x:Key="StepRailItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,0,12,0"/>
            <Setter Property="MinHeight" Value="{StaticResource StepRailRowHeight}"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Border Width="232"
            Padding="0,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
        <ListView x:Name="RailList"
                  ItemsSource="{x:Bind Steps}"
                  ItemContainerStyle="{StaticResource StepRailItemStyle}"
                  SelectionMode="Single"
                  SingleSelectionFollowsFocus="False"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  SelectionChanged="OnSelectionChanged"
                  ContainerContentChanging="OnContainerContentChanging"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  TabNavigation="Once">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:WizardStepState">
                    <Grid x:DefaultBindMode="OneWay"
                          Height="{StaticResource StepRailRowHeight}"
                          ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Runs from this marker down to the next one, across the row boundary; a Canvas does not clip. -->
                        <Canvas Visibility="{x:Bind HasNextStep}">
                            <Rectangle Canvas.Left="15" Canvas.Top="44" Width="2" Height="16"
                                       Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       Visibility="{x:Bind local:WizardStepRail.PendingVisibility(IsComplete)}"/>
                            <Rectangle Canvas.Left="15" Canvas.Top="44" Width="2" Height="16"
                                       Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                       Visibility="{x:Bind IsComplete}"/>
                        </Canvas>

                        <Grid Width="{StaticResource StepRailMarkerSize}"
                              Height="{StaticResource StepRailMarkerSize}"
                              VerticalAlignment="Center">
                            <Grid Visibility="{x:Bind local:WizardStepRail.PendingVisibility(IsComplete)}">
                                <Ellipse StrokeThickness="1.5" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
                                <fluentIcons:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" FontSize="18"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind UsesFluentIcon}"/>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                          Visibility="{x:Bind HasGlyph}"/>
                            </Grid>
                            <Grid Visibility="{x:Bind IsComplete}">
                                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <fluentIcons:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" FontSize="18"
                                                        Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind UsesFluentIcon}"/>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                          Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                          Visibility="{x:Bind HasGlyph}"/>
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Title}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   FontSize="16"
                                   FontWeight="{x:Bind local:WizardStepRail.LabelWeight(IsCurrent)}"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Title}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Border>
</UserControl>
