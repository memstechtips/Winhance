<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winhance.UI.Features.SoftwareApps.SoftwareAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Enabled"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:vm="using:Winhance.UI.Features.SoftwareApps.ViewModels"
    xmlns:winhanceControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:helpers="using:Winhance.UI.Features.Common.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Each view has its own icon cell size. AppItemViewModel decodes icons at CardViewIconSize; change
             both together. -->
        <x:Double x:Key="CompactIconSize">20</x:Double>
        <x:Double x:Key="DataGridIconSize">20</x:Double>

        <!-- A Color FluentIcon carries padding inside its draw box, so it renders smaller than its FontSize.
             The fallback icon (Apps, PuzzlePiece or StarSettings) is sized slightly over its 20px cell
             (22, about 1px each side, absorbed by the icon spacing) so it reads like a real 20px app image. -->
        <x:Double x:Key="CompactAppsIconSize">22</x:Double>
        <x:Double x:Key="DataGridAppsIconSize">22</x:Double>

        <!-- Card-view cell width. The card view's wrap grid renders every cell at this
             width and wraps when the next cell would overflow, so cards never
             grow as you widen the window. Column count:
                 cols = floor((panel_width + ColumnSpacing) / (CardItemWidth + ColumnSpacing))
             Bigger value → fewer columns. Below two columns the cells shrink
             to CardMinItemWidth to keep two, and a single column fills the row. -->
        <x:Double x:Key="CardItemWidth">420</x:Double>
        <x:Double x:Key="CardMinItemWidth">320</x:Double>
        <!-- Compact-view cell width (fixed). Like CardItemWidth, every row renders
             at exactly this width and wraps when the next would overflow; the
             code-behind turns the leftover width into symmetric side padding
             (Microsoft Store pattern). Kept narrower than the Card view so a wide window still fits
             several columns of single-line rows. -->
        <x:Double x:Key="CompactItemWidth">320</x:Double>
        <!-- Upper bound on a compact row's name so names trim at a similar length across rows. The star name
             column, not this cap, is what keeps the trailing warning or link inside the cell. Scaled with
             CompactItemWidth in ApplyTextScaling. -->
        <x:Double x:Key="CompactNameMaxWidth">210</x:Double>
        <x:Double x:Key="CardViewIconSize">36</x:Double>
        <!-- The card fallback icon, over its 36px cell for the same padding reason as CompactAppsIconSize. -->
        <x:Double x:Key="CardViewAppsIconSize">38</x:Double>
        <CornerRadius x:Key="CardViewCornerRadius">8</CornerRadius>
        <Thickness x:Key="CardViewPadding">12,10</Thickness>

        <!-- The wrap grid forces every cell to CardCellHeight so cards are uniform across rows. CardContentHeight is
             the room inside the card (cell minus Border padding 10+10 and thickness 1+1, or 2+2 when Checked): the
             name row (its website button is taller than the name), a 2-line description and the chip row. -->
        <x:Double x:Key="CardContentHeight">100</x:Double>
        <x:Double x:Key="CardCellHeight">124</x:Double>
        <!-- Card-view selection target. Wrapping the whole card in a templated
             ToggleButton is what makes "click anywhere on the card" reliably
             toggle selection; Border + Tapped from the data template does not fire.
             The ToggleButton's IsChecked is bound two-way to AppItemViewModel.IsSelected,
             so the inner CheckBox visual indicator only needs OneWay binding and
             can stay IsHitTestVisible=False (no double-toggle). -->
        <!-- The icon-only link beside an app's name. -->
        <Style x:Key="WebsiteLinkStyle" TargetType="HyperlinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardViewCornerRadius}"
                                Padding="{StaticResource CardViewPadding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- First column header: left-rounded corners with select-all checkbox -->
        <Style x:Key="FirstColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorDisabledBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HeaderBackground"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4,0,0,4"/>
                            <CheckBox Tag="SelectAll"
                                      MinWidth="20"
                                      Margin="8,4,4,4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Middle column headers: no rounding, with sort indicators -->
        <Style x:Key="ColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorDisabledBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SortStates">
                                    <VisualState x:Name="Unsorted"/>
                                    <VisualState x:Name="SortAscending">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SortDescending">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="SortIconRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HeaderBackground"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <Grid Padding="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <fluentIcons:FluentIcon x:Name="SortIcon"
                                                        Grid.Column="1"
                                                        Icon="ChevronUp"
                                                        IconVariant="Regular"
                                                        FontSize="10"
                                                        Margin="{StaticResource InlineLeadingMargin}"
                                                        VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Visibility="Collapsed">
                                    <fluentIcons:FluentIcon.RenderTransform>
                                        <RotateTransform x:Name="SortIconRotation"/>
                                    </fluentIcons:FluentIcon.RenderTransform>
                                </fluentIcons:FluentIcon>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LastColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
        </Style>

        <!-- Spacer column header: right-rounded corners with card background -->
        <Style x:Key="SpacerColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="0,4,4,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Removes the header-to-row separator line -->
        <SolidColorBrush x:Key="GridLinesBrush" Color="Transparent"/>

        <!-- Removes cell focus visuals (white/black rectangles on click) -->
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent"/>

        <!-- DataGridRow style with accent selection border.
             Uses standard WinUI 3 brushes instead of DataGrid-internal theme resources
             (DataGridRow*BackgroundColor etc. are not in scope at page level). -->
        <Style x:Key="SelectionRowStyle" TargetType="controls:DataGridRow">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DataGridRow">
                        <primitives:DataGridFrozenGrid x:Name="RowRoot">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="NormalAlternatingRow"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NormalSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverUnfocusedSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="UnfocusedSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="BackgroundRectangle" Grid.ColumnSpan="2"
                                       Fill="Transparent"/>

                            <!-- Accent selection border overlay -->
                            <Border x:Name="SelectionBorder"
                                    Grid.ColumnSpan="2"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource SelectionCornerRadius}"
                                    Margin="0,0,4,0"
                                    BorderBrush="Transparent"/>

                            <primitives:DataGridCellsPresenter x:Name="CellsPresenter" Grid.Column="1"
                                                                primitives:DataGridFrozenGrid.IsFrozen="True"
                                                                MinHeight="32"
                                                                AutomationProperties.AccessibilityView="Raw"/>
                            <primitives:DataGridDetailsPresenter x:Name="DetailsPresenter" Grid.Row="1" Grid.Column="1"
                                                                  Background="Transparent"
                                                                  AutomationProperties.AccessibilityView="Raw"/>
                        </primitives:DataGridFrozenGrid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default cell template stacks a currency outline, a two-stroke focus outline, an invalid outline and a
             grid line around the content: eight elements a cell, all transparent here (the brushes above, no
             validation, GridLinesVisibility None). DataGridCell null-checks its one named part, RightGridLine. -->
        <Style x:Key="AppCellStyle" TargetType="controls:DataGridCell">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DataGridCell">
                        <ContentPresenter Background="{TemplateBinding Background}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- External Software's package search. Its box shares the header box's text, so typing in either fills both. -->
        <DataTemplate x:Key="PackageSearchTemplate" x:DataType="vm:SoftwareAppsViewModel">
            <StackPanel Spacing="{StaticResource FieldLabelSpacing}">
                <AutoSuggestBox PlaceholderText="{x:Bind PackageSearchPlaceholder, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind PackageSearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                MaxWidth="560"
                                HorizontalAlignment="Stretch"
                                Text="{x:Bind SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="PackageSearchStatusText"
                           x:Load="{x:Bind ExternalAppsViewModel.HasPackageSearchStatus, Mode=OneWay}"
                           Text="{x:Bind ExternalAppsViewModel.PackageSearchStatus, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AppCardTemplate" x:DataType="vm:AppItemViewModel">
            <!-- While scrolling, the grid draws the tick and name first (phase 0) and fills in the icon and
                 description (1), then the badges (2), over the next frames. -->
            <!-- Wrap the whole card in a templated ToggleButton so clicking
                 anywhere on it toggles selection. ToggleButton.IsChecked
                 binds two-way to IsSelected; the inner CheckBox is purely a
                 visual indicator (IsHitTestVisible=False, OneWay). -->
            <!-- A disabled control shows no tooltip, so the reason sits on a wrapper. -->
            <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind NoPackageTooltip, Mode=OneWay}">
                <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                              Style="{StaticResource CardToggleButtonStyle}"
                              IsEnabled="{x:Bind IsSelectable, Mode=OneWay}"
                              IsTabStop="False"
                              AutomationProperties.Name="{x:Bind Name}">
                    <!-- MinHeight (not Height) so the inner content can grow past the default 84dp when Windows'
                         "Make text bigger" scale is applied; the code-behind scales the grid's row height to match. -->
                    <Grid ColumnSpacing="12" MinHeight="{StaticResource CardContentHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                  IsHitTestVisible="False"
                                  IsTabStop="False"
                                  MinWidth="0"
                                  VerticalAlignment="Center"/>

                        <Grid Grid.Column="1"
                              Width="{StaticResource CardViewIconSize}"
                              Height="{StaticResource CardViewIconSize}"
                              VerticalAlignment="Center">
                            <Image x:Name="CardIcon" x:Load="{x:Bind HasIcon, Mode=OneWay}" x:Phase="1"
                                   Source="{x:Bind IconSource, Mode=OneWay}"
                                   Stretch="Uniform"/>
                            <fluentIcons:FluentIcon x:Name="CardFallbackIcon" x:Load="{x:Bind NeedsFallbackIcon, Mode=OneWay}" x:Phase="1"
                                                    Icon="{x:Bind FallbackIcon}" IconVariant="Color"
                                                    FontSize="{StaticResource CardViewAppsIconSize}"/>
                        </Grid>

                        <!-- Content: name row, description, then status badges below
                             the description — mirrors the Optimize/Customize settings
                             card layout. -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: name + website button -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           ToolTipService.ToolTip="{x:Bind DescriptionTooltip, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource BodyTextBlockFontSize}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="{StaticResource InlineTrailingMargin}"
                                           VerticalAlignment="Center"/>
                                <HyperlinkButton x:Name="CardWebsiteLink" x:Load="{x:Bind HasWebsite}" x:Phase="1" Grid.Column="1"
                                                 NavigateUri="{x:Bind WebsiteUri}" ToolTipService.ToolTip="{x:Bind WebsiteUrl}"
                                                 AutomationProperties.Name="{x:Bind OpenWebsiteLabel, Mode=OneWay}"
                                                 Style="{StaticResource WebsiteLinkStyle}">
                                    <fluentIcons:FluentIcon Icon="Open" IconVariant="Regular" FontSize="{StaticResource CardIconFontSize}"/>
                                </HyperlinkButton>
                            </Grid>

                            <!-- Row 1: description -->
                            <TextBlock Grid.Row="1" x:Phase="1"
                                       x:Name="DescriptionText"
                                       x:Load="{x:Bind HasDescription, Mode=OneWay}"
                                       Text="{x:Bind Description}"
                                       FontSize="{StaticResource CaptionTextBlockFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       Margin="{StaticResource DescriptionTopMargin}"/>

                            <!-- Row 2: status badges. The description row is the star row, so a short card
                                 shortens the description and never cuts a chip. A narrow card wraps the pills onto a
                                 second line instead of clipping the last one. -->
                            <ctk:WrapPanel Grid.Row="2" HorizontalSpacing="{StaticResource BadgeRowSpacing}" VerticalSpacing="{StaticResource BadgeRowSpacing}" Margin="0,6,0,0">
                                <Border Style="{StaticResource BadgeWarningStyle}"
                                        x:Name="WarningBadge" x:Load="{x:Bind HasInstabilityWarning, Mode=OneWay}" x:Phase="2"
                                        ToolTipService.ToolTip="{x:Bind InstabilityWarningTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <fluentIcons:FluentIcon Icon="ErrorCircle" IconVariant="Color" FontSize="{StaticResource StatusChipIconFontSize}"
                                                                Margin="{StaticResource StatusChipIconMargin}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind InstabilityWarningLabel, Mode=OneWay}"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource BadgeCustomForeground}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource BadgeInstalledStyle}"
                                        x:Name="InstalledBadge" x:Load="{x:Bind IsInstalledUpToDate, Mode=OneWay}" x:Phase="2" ToolTipService.ToolTip="{x:Bind InstalledStatusTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <fluentIcons:FluentIcon Icon="CheckmarkCircle" IconVariant="Color" FontSize="{StaticResource StatusChipIconFontSize}"
                                                                Margin="{StaticResource StatusChipIconMargin}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind InstalledStatusText, Mode=OneWay}"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource BadgePreferenceStyle}"
                                        x:Name="UpdateBadge" x:Load="{x:Bind HasUpdate, Mode=OneWay}" x:Phase="2"
                                        ToolTipService.ToolTip="{x:Bind UpdateAvailableTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <fluentIcons:FluentIcon Icon="Clock" IconVariant="Color" FontSize="{StaticResource StatusChipIconFontSize}"
                                                                Margin="{StaticResource StatusChipIconMargin}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind UpdateAvailableLabel, Mode=OneWay}"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource BadgePreferenceForeground}"/>
                                    </StackPanel>
                                </Border>
                            </ctk:WrapPanel>
                        </Grid>
                    </Grid>
                </ToggleButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AppSelectCellTemplate" x:DataType="vm:AppItemViewModel">
            <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind NoPackageTooltip, Mode=OneWay}">
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          IsEnabled="{x:Bind IsSelectable, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                          MinWidth="20"
                          HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AppUpdateCellTemplate" x:DataType="vm:AppItemViewModel">
            <Grid>
                <TextBlock x:Name="UpdateVersionText" x:Load="{x:Bind HasUpdate, Mode=OneWay}"
                           Text="{x:Bind AvailableVersion, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AppNameCellTemplate" x:DataType="vm:AppItemViewModel">
            <!-- Left-aligned with a star name column: the name sizes to its text but trims before the trailing icon is pushed out. -->
            <Grid HorizontalAlignment="Left" ColumnSpacing="4" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                  Opacity="{x:Bind IsSelectable, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"
                  ToolTipService.ToolTip="{x:Bind NoPackageTooltip, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="{StaticResource DataGridIconSize}" Height="{StaticResource DataGridIconSize}"
                      VerticalAlignment="Center" Margin="-4,0,0,0">
                    <Image x:Name="CellIcon" x:Load="{x:Bind HasIcon, Mode=OneWay}"
                           Source="{x:Bind IconSource, Mode=OneWay}"
                           Width="{StaticResource DataGridIconSize}" Height="{StaticResource DataGridIconSize}"
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <fluentIcons:FluentIcon x:Name="CellFallbackIcon" x:Load="{x:Bind NeedsFallbackIcon, Mode=OneWay}"
                                            Icon="{x:Bind FallbackIcon}" IconVariant="Color"
                                            FontSize="{StaticResource DataGridAppsIconSize}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind DescriptionTooltip, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <fluentIcons:FluentIcon x:Name="CellWarning" x:Load="{x:Bind HasInstabilityWarning, Mode=OneWay}"
                                        Icon="ErrorCircle" IconVariant="Color" FontSize="{StaticResource StatusIconFontSize}" Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind InstabilityWarningTooltip, Mode=OneWay}"/>
                <HyperlinkButton x:Name="CellWebsiteLink" x:Load="{x:Bind HasWebsite}" Grid.Column="2"
                                 NavigateUri="{x:Bind WebsiteUri}" ToolTipService.ToolTip="{x:Bind WebsiteUrl}"
                                 AutomationProperties.Name="{x:Bind OpenWebsiteLabel, Mode=OneWay}"
                                 Style="{StaticResource WebsiteLinkStyle}">
                    <fluentIcons:FluentIcon Icon="Open" IconVariant="Regular" FontSize="{StaticResource CardIconFontSize}"/>
                </HyperlinkButton>
            </Grid>
        </DataTemplate>

        <CollectionViewSource x:Name="WindowsSectionsSource" IsSourceGrouped="True" ItemsPath="Apps"
                              Source="{x:Bind ViewModel.WindowsAppsViewModel.Sections, Mode=OneWay}"/>
        <CollectionViewSource x:Name="ExternalCategoriesSource" IsSourceGrouped="True" ItemsPath="Apps"
                              Source="{x:Bind ViewModel.ExternalAppsViewModel.Categories, Mode=OneWay}"/>

        <!-- Bare containers: the card and row draw their own states, and the padding is half the gap between cells,
             because ItemsWrapGrid has no spacing of its own. The code-behind reads the gap from these too. -->
        <Thickness x:Key="CardCellPadding">8</Thickness>
        <Style x:Key="AppCardItemStyle" TargetType="GridViewItem">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="{StaticResource CardCellPadding}"/>
            <Setter Property="FocusVisualMargin" Value="{StaticResource CardCellPadding}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppGroupHeaderContainerStyle" TargetType="GridViewHeaderItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewHeaderItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppGroupHeaderTemplate" x:DataType="vm:AppCategory">
            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="8,0,8,0"/>
        </DataTemplate>
        <!-- A compact section is one card: its header and its rows share the card fill, like an expanded Expander with
             no fold. The list holds the section's lines (AppSectionLine), so it builds only the lines in view. -->
        <x:Double x:Key="CompactColumnSpacing">8</x:Double>
        <x:Double x:Key="CompactRowSpacing">2</x:Double>
        <Thickness x:Key="AppSectionBorderThickness">1</Thickness>
        <Thickness x:Key="AppSectionDividerThickness">0,1,0,0</Thickness>
        <Thickness x:Key="AppSectionBodyPadding">12,6,12,10</Thickness>
        <x:Double x:Key="AppSectionSpacing">12</x:Double>
        <Style x:Key="AppSectionItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppSectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <DataTemplate x:Key="AppSectionHeaderTemplate" x:DataType="vm:AppCategory">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,10">
                <fluentIcons:FluentIcon Icon="{x:Bind SectionIcon, Mode=OneTime}" IconVariant="Regular" FontSize="{StaticResource CardIconFontSize}"/>
                <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontWeight="SemiBold" FontSize="{StaticResource BodyTextBlockFontSize}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <!-- ItemsRepeater draws neither a Padding nor a border, so the rows' inset and divider live on the Border
             around it. -->
        <DataTemplate x:Key="AppSectionLineTemplate" x:DataType="vm:AppSectionLine">
            <Border Style="{StaticResource AppSectionCardStyle}" CornerRadius="{x:Bind Corners, Mode=OneTime}" BorderThickness="{x:Bind Edges, Mode=OneTime}" Margin="{x:Bind Gap, Mode=OneTime}">
                <StackPanel>
                    <ContentPresenter x:Name="Header" x:Load="{x:Bind IsFirst, Mode=OneTime}" Content="{x:Bind Section, Mode=OneTime}" ContentTemplate="{StaticResource AppSectionHeaderTemplate}"/>
                    <Border Padding="{x:Bind BodyPadding, Mode=OneTime}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="{x:Bind Divider, Mode=OneTime}">
                        <ItemsRepeater ItemsSource="{x:Bind Apps, Mode=OneTime}"
                                       AutomationProperties.Name="{x:Bind Section.DisplayName, Mode=OneTime}">
                            <!-- Written inside the repeater, not shared from the resources: the recycle pool lives on
                                 the template, and in WinAppSDK 1.8.7 a repeater given a new ItemsSource leaves its rows
                                 in the pool still marked as its own, so another repeater sharing the pool throws when
                                 it takes one. -->
                            <ItemsRepeater.ItemTemplate>
                                <!-- One row for both tabs: Windows apps carry the instability warning and external apps the website link, never
                                     both, so they share the trailing column. -->
                                <DataTemplate x:DataType="vm:AppItemViewModel">
                                    <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind NoPackageTooltip, Mode=OneWay}">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="4,3" FontSize="16"
                                                  IsEnabled="{x:Bind IsSelectable, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind Name}">
                                            <!-- Left-aligned Grid with a star name column: the row sits at its natural width, so the warning
                                                 sits right after the name, but the name gets only what the icons and warning leave, so a long
                                                 name ellipsizes instead of pushing the warning out of the cell. A horizontal StackPanel or an
                                                 Auto name column measures the name at infinite width and never trims. -->
                                            <Grid HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,1,0,0">
                                                    <fluentIcons:FluentIcon Icon="{x:Bind StatusIcon, Mode=OneWay}" IconVariant="Color"
                                                                            FontSize="{StaticResource StatusIconFontSize}" VerticalAlignment="Center"
                                                                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"/>
                                                    <Grid Width="{StaticResource CompactIconSize}" Height="{StaticResource CompactIconSize}" Margin="0,2,0,0"
                                                          ToolTipService.ToolTip="{x:Bind DescriptionTooltip, Mode=OneWay}" VerticalAlignment="Center">
                                                        <Image x:Name="RowIcon" x:Load="{x:Bind HasIcon, Mode=OneWay}"
                                                               Source="{x:Bind IconSource, Mode=OneWay}"
                                                               Width="{StaticResource CompactIconSize}" Height="{StaticResource CompactIconSize}"
                                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <fluentIcons:FluentIcon x:Name="RowFallbackIcon" x:Load="{x:Bind NeedsFallbackIcon, Mode=OneWay}"
                                                                                Icon="{x:Bind FallbackIcon}" IconVariant="Color"
                                                                                FontSize="{StaticResource CompactAppsIconSize}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" FontSize="{StaticResource ItemTitleFontSize}" Margin="{StaticResource InlineLeadingMargin}"
                                                           MaxWidth="{StaticResource CompactNameMaxWidth}" ToolTipService.ToolTip="{x:Bind DescriptionTooltip, Mode=OneWay}"/>
                                                <fluentIcons:FluentIcon x:Name="RowWarning" x:Load="{x:Bind HasInstabilityWarning, Mode=OneWay}"
                                                                        Icon="ErrorCircle" IconVariant="Color" FontSize="{StaticResource StatusIconFontSize}" Grid.Column="2"
                                                                        VerticalAlignment="Center" Margin="{StaticResource InlineLeadingMargin}"
                                                                        ToolTipService.ToolTip="{x:Bind InstabilityWarningTooltip, Mode=OneWay}"/>
                                                <HyperlinkButton x:Name="RowWebsiteLink" x:Load="{x:Bind HasWebsite}" Grid.Column="2" Margin="{StaticResource InlineLeadingMargin}"
                                                                 NavigateUri="{x:Bind WebsiteUri}" ToolTipService.ToolTip="{x:Bind WebsiteUrl}"
                                                                 AutomationProperties.Name="{x:Bind OpenWebsiteLabel, Mode=OneWay}"
                                                                 Style="{StaticResource WebsiteLinkStyle}">
                                                    <fluentIcons:FluentIcon Icon="Open" IconVariant="Regular" FontSize="{StaticResource CardIconFontSize}"/>
                                                </HyperlinkButton>
                                            </Grid>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <winhanceControls:UniformWrapLayout ItemWidth="{StaticResource CompactItemWidth}"
                                                                    ColumnSpacing="{StaticResource CompactColumnSpacing}"
                                                                    RowSpacing="{StaticResource CompactRowSpacing}"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PageRootPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Action Bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="BuilderActionStates">
                <VisualState x:Name="NoAccent"/>
                <VisualState x:Name="InstallAccent">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsInstallAccent, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InstallButton.Style" Value="{StaticResource AccentButtonStyle}"/>
                        <Setter Target="InstallButton.IsHitTestVisible" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RemoveAccent">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsRemoveAccent, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RemoveButton.Style" Value="{StaticResource AccentButtonStyle}"/>
                        <Setter Target="RemoveButton.IsHitTestVisible" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowHeightStates">
                <VisualState x:Name="TallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="{StaticResource ShortWindowHeight}"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ShortState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionBar.Margin" Value="0,8,0,8"/>
                        <Setter Target="WindowsAppsTab.Padding" Value="12,4"/>
                        <Setter Target="ExternalAppsTab.Padding" Value="12,4"/>
                        <Setter Target="TabContentArea.Margin" Value="14,56,12,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Row 0: Page Header with Icon (title left, search right) -->
        <winhanceControls:PageHeader
            Grid.Row="0"
            Icon="Apps"
            Title="{x:Bind ViewModel.PageTitle}"
            Description="{x:Bind ViewModel.PageDescription}">
            <winhanceControls:PageHeader.Actions>
                <AutoSuggestBox
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                    helpers:AutoSuggestBoxExtensions.PlaceholderEllipsis="True"
                    QueryIcon="Find"
                    Width="220"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </winhanceControls:PageHeader.Actions>
        </winhanceControls:PageHeader>

        <!-- Row 1: Action Bar (right-aligned) -->
        <!-- Labels drop to icons, with tooltips, when the row does not fit (SoftwareAppsPage.FitActionBar). -->
        <StackPanel x:Name="ActionBar" Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}" HorizontalAlignment="Right" Margin="0,12,0,16">
            <!-- Normal mode: Install Button -->
            <Button x:Name="InstallButton"
                    x:Load="{x:Bind ViewModel.IsActionButtonVisible, Mode=OneWay}"
                    Command="{x:Bind ViewModel.InstallSelectedItemsCommand}"
                    IsEnabled="{x:Bind ViewModel.CanInstallItems, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="ArrowDownload" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="InstallLabel" Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"/>
                </StackPanel>
            </Button>
            <!-- Normal mode: Remove Button -->
            <Button x:Name="RemoveButton"
                    x:Load="{x:Bind ViewModel.IsActionButtonVisible, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RemoveSelectedItemsCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRemoveItems, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="RemoveLabel" Text="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"/>
                </StackPanel>
            </Button>

            <!-- Review mode: Install action toggle -->
            <ToggleButton x:Name="InstallActionToggle"
                          x:Load="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.CurrentInstallAction, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.InstallButtonText}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.InstallButtonText}"
                          Padding="10,6,12,6">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="ArrowDownload" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="InstallToggleLabel" Text="{x:Bind ViewModel.InstallButtonText}"/>
                </StackPanel>
            </ToggleButton>
            <!-- Review mode: Remove action toggle -->
            <ToggleButton x:Name="RemoveActionToggle"
                          x:Load="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.CurrentRemoveAction, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"
                          Padding="10,6,12,6">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="RemoveToggleLabel" Text="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"/>
                </StackPanel>
            </ToggleButton>
            <Button x:Name="InstallOptionsButton"
                    x:Load="{x:Bind ViewModel.IsExternalAppsTabSelected, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ExternalAppsViewModel.EditDefaultInstallOptionsCommand}"
                    AutomationProperties.Name="{x:Bind ViewModel.InstallOptionsButtonText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.InstallOptionsButtonText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="InstallOptionsLabel" Text="{x:Bind ViewModel.InstallOptionsButtonText, Mode=OneWay}"/>
                </StackPanel>
            </Button>
            <AppBarSeparator/>
            <Button Command="{x:Bind ViewModel.RefreshInstallationStatusCommand}"
                    AutomationProperties.Name="{x:Bind ViewModel.RefreshButtonText}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RefreshButtonText}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="RefreshLabel" Text="{x:Bind ViewModel.RefreshButtonText}"/>
                </StackPanel>
            </Button>
            <!-- Layout, sort and filter in one menu. In Table view a column header sorts, so the sort items are
                 disabled there and a disabled hint item says why: a disabled item shows no tooltip. -->
            <DropDownButton x:Name="ViewMenuButton"
                            AutomationProperties.Name="{x:Bind ViewModel.ViewMenuText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ViewMenuText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="Eye" IconVariant="Regular" FontSize="{StaticResource ActionBarIconFontSize}"/>
                    <TextBlock x:Name="ViewMenuLabel" Text="{x:Bind ViewModel.ViewMenuText, Mode=OneWay}"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem GroupName="AppsViewMode"
                                             Text="{x:Bind ViewModel.ViewModeCardTooltip, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsCardView, Mode=OneWay}"
                                             Click="ViewCard_Click"/>
                        <RadioMenuFlyoutItem GroupName="AppsViewMode"
                                             Text="{x:Bind ViewModel.ViewModeTableTooltip, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsTableView, Mode=OneWay}"
                                             Click="ViewTable_Click"/>
                        <RadioMenuFlyoutItem GroupName="AppsViewMode"
                                             Text="{x:Bind ViewModel.ViewModeCompactTooltip, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsCompactView, Mode=OneWay}"
                                             Click="ViewCompact_Click"/>
                        <MenuFlyoutSeparator/>
                        <RadioMenuFlyoutItem GroupName="AppsSortMode"
                                             Text="{x:Bind ViewModel.SortInstalledFirstText, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsSortInstalledFirst, Mode=OneWay}"
                                             IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                                             Click="SortInstalledFirst_Click"/>
                        <RadioMenuFlyoutItem GroupName="AppsSortMode"
                                             Text="{x:Bind ViewModel.SortNameAscText, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsSortNameAsc, Mode=OneWay}"
                                             IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                                             Click="SortNameAsc_Click"/>
                        <RadioMenuFlyoutItem GroupName="AppsSortMode"
                                             Text="{x:Bind ViewModel.SortNameDescText, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsSortNameDesc, Mode=OneWay}"
                                             IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                                             Click="SortNameDesc_Click"/>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.SortTableHintText, Mode=OneWay}"
                                        IsEnabled="False"
                                        Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay}"/>
                        <MenuFlyoutSeparator/>
                        <RadioMenuFlyoutItem GroupName="AppsFilter"
                                             Text="{x:Bind ViewModel.FilterAllText, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}"
                                             Click="FilterAll_Click"/>
                        <RadioMenuFlyoutItem GroupName="AppsFilter"
                                             Text="{x:Bind ViewModel.FilterInstalledText, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsFilterInstalled, Mode=OneWay}"
                                             Click="FilterInstalled_Click"/>
                        <RadioMenuFlyoutItem GroupName="AppsFilter"
                                             Text="{x:Bind ViewModel.FilterUpdatesText, Mode=OneWay}"
                                             IsChecked="{x:Bind ViewModel.IsFilterUpdates, Mode=OneWay}"
                                             Visibility="{x:Bind ViewModel.IsExternalAppsTabSelected, Mode=OneWay}"
                                             Click="FilterUpdates_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="ExportListMenuItem"
                                        Text="{x:Bind ViewModel.ExportListText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ExportListCommand}"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Row 2: Content Container with rounded corners and background -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
            CornerRadius="{StaticResource SectionBandCornerRadius}"
            Margin="0,0,0,4">
            <Grid>
                <!-- Tab Navigation Container -->
                <Border Margin="12,12,12,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6"
                        Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Windows Apps Tab -->
                        <Grid Grid.Column="0">
                            <!-- Selection background (visible when selected) -->
                            <Border x:Name="WindowsAppsTabSelectionBackground"
                                    x:Load="{x:Bind ViewModel.IsWindowsAppsTabSelected, Mode=OneWay}"
                                    CornerRadius="{StaticResource SelectionCornerRadius}"
                                    Margin="2"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    IsHitTestVisible="False"/>
                            <!-- Accent indicator on left -->
                            <Border x:Name="WindowsAppsTabAccent"
                                    x:Load="{x:Bind ViewModel.IsWindowsAppsTabSelected, Mode=OneWay}"
                                    Width="3"
                                    Height="18"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="{StaticResource TabAccentMargin}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False"/>
                            <!-- Tab button (transparent) -->
                            <Button x:Name="WindowsAppsTab"
                                    Command="{x:Bind ViewModel.SelectWindowsAppsTabCommand}"
                                    AutomationProperties.Name="{x:Bind ViewModel.WindowsAppsTabText}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,10">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                                    <Viewbox Width="18" Height="18">
                                        <fluentIcons:FluentIcon Icon="Apps" IconVariant="Regular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.WindowsAppsTabText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Review mode badge -->
                            <InfoBadge x:Name="WindowsAppsTabBadge"
                                       x:Load="{x:Bind HasTabBadge(ViewModel.IsInReviewMode, ViewModel.WindowsAppsSelectedCount), Mode=OneWay}"
                                       Value="{x:Bind ViewModel.WindowsAppsSelectedCount, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,2,8,0"/>
                        </Grid>

                        <!-- Separator -->
                        <Border Grid.Column="1"
                                Width="1"
                                Margin="4,8"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                        <!-- External Apps Tab -->
                        <Grid Grid.Column="2">
                            <!-- Selection background (visible when selected) -->
                            <Border x:Name="ExternalAppsTabSelectionBackground"
                                    x:Load="{x:Bind ViewModel.IsExternalAppsTabSelected, Mode=OneWay}"
                                    CornerRadius="{StaticResource SelectionCornerRadius}"
                                    Margin="2"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    IsHitTestVisible="False"/>
                            <!-- Accent indicator on left -->
                            <Border x:Name="ExternalAppsTabAccent"
                                    x:Load="{x:Bind ViewModel.IsExternalAppsTabSelected, Mode=OneWay}"
                                    Width="3"
                                    Height="18"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="{StaticResource TabAccentMargin}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False"/>
                            <!-- Tab button (transparent) -->
                            <Button x:Name="ExternalAppsTab"
                                    Command="{x:Bind ViewModel.SelectExternalAppsTabCommand}"
                                    AutomationProperties.Name="{x:Bind ViewModel.ExternalAppsTabText}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,10">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                                    <Viewbox Width="18" Height="18">
                                        <fluentIcons:FluentIcon x:Name="ExternalAppsTabIcon" Icon="ArrowDownload" IconVariant="Regular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.ExternalAppsTabText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Review mode badge -->
                            <InfoBadge x:Name="ExternalAppsTabBadge"
                                       x:Load="{x:Bind HasTabBadge(ViewModel.IsInReviewMode, ViewModel.ExternalAppsSelectedCount), Mode=OneWay}"
                                       Value="{x:Bind ViewModel.ExternalAppsSelectedCount, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,2,8,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Content Area (below tabs) -->
                <Grid x:Name="TabContentArea" Margin="14,70,12,0">
                    <!-- Windows Apps Content; the code-behind builds only the selected tab's panel -->
                    <Grid x:Name="WindowsAppsPanel" x:Load="{x:Bind IsWindowsAppsPanelLoaded, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Stacked: a note from the last install or removal can still be open when a banner appears. -->
                        <StackPanel Grid.Row="0">
                            <!-- Review Mode Banner for Windows Apps -->
                            <InfoBar x:Name="WindowsAppsReviewBanner"
                                     x:Load="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                                     Severity="Warning"
                                     IsClosable="False"
                                     Message="{x:Bind ViewModel.ReviewWindowsAppsBannerText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>

                            <!-- Builder Mode Banner for Windows Apps (mutually exclusive with review banner) -->
                            <InfoBar x:Name="WindowsAppsBuilderBanner"
                                     x:Load="{x:Bind ViewModel.IsBuilderModeActive, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.IsBuilderModeActive, Mode=OneWay}"
                                     Severity="Warning"
                                     IsClosable="False"
                                     Message="{x:Bind ViewModel.BuilderWindowsAppsBannerText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>

                            <!-- Closing a note writes the flag back, so the next install or removal can raise it again. -->
                            <InfoBar x:Name="EnableHandedOffNote"
                                     x:Load="{x:Bind ViewModel.WindowsAppsViewModel.IsEnableHandedOffNoteVisible, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.WindowsAppsViewModel.IsEnableHandedOffNoteVisible, Mode=TwoWay}"
                                     Severity="Informational"
                                     Message="{x:Bind ViewModel.WindowsAppsViewModel.EnableHandedOffNoteText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>
                            <InfoBar x:Name="RemovalDeferredNote"
                                     x:Load="{x:Bind ViewModel.WindowsAppsViewModel.IsRemovalDeferredNoteVisible, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.WindowsAppsViewModel.IsRemovalDeferredNoteVisible, Mode=TwoWay}"
                                     Severity="Informational"
                                     Message="{x:Bind ViewModel.WindowsAppsViewModel.RemovalDeferredNoteText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>
                        </StackPanel>

                        <!-- Collapsed until the load or refresh finishes, so the loader below stands alone. -->
                        <Grid x:Name="WindowsAppsContent"
                              Grid.Row="1"
                              x:Load="{x:Bind ViewModel.WindowsAppsViewModel.IsContentReady, Mode=OneWay}">

                        <!-- DataGrid View -->
                        <Grid x:Name="WindowsAppsTableView" x:Load="{x:Bind IsShown(ShownView, 'WindowsAppsTableView'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <winhanceControls:SelectAllBar Margin="8,8,0,0" Source="{x:Bind ViewModel.WindowsAppsViewModel}"/>
                        <controls:DataGrid x:Name="WindowsAppsDataGrid"
                                           Grid.Row="1"
                                           Loaded="WindowsAppsDataGrid_Loaded"
                                           Unloaded="AppsDataGrid_Unloaded"
                                           PreviewKeyDown="AppsDataGrid_PreviewKeyDown"
                                           ItemsSource="{x:Bind ViewModel.WindowsAppsViewModel.ItemsView, Mode=OneWay}"
                                           AutoGenerateColumns="False"
                                           CanUserSortColumns="True"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="True"
                                           GridLinesVisibility="None"
                                           HeadersVisibility="Column"
                                           SelectionMode="Extended"
                                           IsReadOnly="True"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Disabled"
                                           Background="Transparent"
                                           RowBackground="Transparent"
                                           AlternatingRowBackground="Transparent"
                                           BorderThickness="0"
                                           Padding="0,0,0,0"
                                           ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                                           RowStyle="{StaticResource SelectionRowStyle}"
                                           CellStyle="{StaticResource AppCellStyle}"
                                           Sorting="DataGrid_Sorting">
                            <controls:DataGrid.Columns>
                                <!-- Selection Column with Select All header -->
                                <controls:DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="False"
                                                                  HeaderStyle="{StaticResource FirstColumnHeaderStyle}"
                                                                  CellTemplate="{StaticResource AppSelectCellTemplate}"
                                                                  CellEditingTemplate="{StaticResource AppSelectCellTemplate}"/>

                                <!-- Name Column -->
                                <controls:DataGridTemplateColumn Header="Name" Width="*" Tag="Name" CellTemplate="{StaticResource AppNameCellTemplate}"/>

                                <!-- Description Column. Header text is localized in code-behind (ApplyColumnHeaders). -->
                                <controls:DataGridTemplateColumn Header="Description" Width="2*" Tag="Description">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind DescriptionTooltip, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Type Column -->
                                <controls:DataGridTemplateColumn Header="Type" Width="*" Tag="ItemTypeDescription">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind ItemTypeDescription, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Status Column -->
                                <controls:DataGridTemplateColumn Header="Status" Width="*" Tag="IsInstalled"
                                                                  HeaderStyle="{StaticResource LastColumnHeaderStyle}">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}" VerticalAlignment="Center">
                                                <fluentIcons:FluentIcon Icon="{x:Bind StatusIcon, Mode=OneWay}" IconVariant="Color"
                                                                        FontSize="{StaticResource StatusIconFontSize}" VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind StatusColumnText, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                        </Grid>

                        <!-- Grouped GridViews virtualize: only the rows in view get containers, so a list of ~400 apps
                             builds in a frame. The code-behind centres the columns and loads only the shown view. -->
                        <GridView x:Name="WindowsAppsCardView" x:Load="{x:Bind IsShown(ShownView, 'WindowsAppsCardView'), Mode=OneWay}"
                                  ItemsSource="{x:Bind WindowsSectionsSource.View, Mode=OneWay}"
                                  ItemTemplate="{StaticResource AppCardTemplate}"
                                  ItemContainerStyle="{StaticResource AppCardItemStyle}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick"
                                  ContainerContentChanging="AppGrid_ContainerContentChanging"
                                  SizeChanged="CardView_SizeChanged"
                                  Loaded="AppList_Loaded"
                                  Padding="{StaticResource AppListPadding}">
                            <GridView.Header>
                                <winhanceControls:SelectAllBar Margin="8,0,8,20" Source="{x:Bind ViewModel.WindowsAppsViewModel}"/>
                            </GridView.Header>
                            <GridView.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource AppGroupHeaderTemplate}" HeaderContainerStyle="{StaticResource AppGroupHeaderContainerStyle}"/>
                            </GridView.GroupStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Half a screen of cards each side instead of the default two: the extra screens held about 40 MB. -->
                                    <ItemsWrapGrid Orientation="Horizontal" GroupPadding="0,0,0,12" AreStickyGroupHeadersEnabled="False" CacheLength="1" Loaded="CardPanel_Loaded"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <ListView x:Name="WindowsAppsCompactView" x:Load="{x:Bind IsShown(ShownView, 'WindowsAppsCompactView'), Mode=OneWay}"
                                  ItemsSource="{x:Bind WindowsSectionLines, Mode=OneWay}"
                                  ItemTemplate="{StaticResource AppSectionLineTemplate}"
                                  ItemContainerStyle="{StaticResource AppSectionItemStyle}"
                                  SelectionMode="None" IsTabStop="False" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled"
                                  SizeChanged="SectionList_SizeChanged"
                                  Loaded="AppList_Loaded"
                                  Padding="{StaticResource AppListPadding}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel CacheLength="0.5"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.Header>
                                <winhanceControls:SelectAllBar Margin="0,0,0,16" Source="{x:Bind ViewModel.WindowsAppsViewModel}"/>
                            </ListView.Header>
                        </ListView>

                        </Grid>

                        <!-- Loader for Windows Apps -->
                        <Grid x:Name="WindowsAppsLoader"
                              Grid.Row="1"
                              x:Load="{x:Bind helpers:LoadWhen.Not(ViewModel.WindowsAppsViewModel.IsContentReady), Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource LoaderSpacing}">
                                <winhanceControls:RocketLoader IsActive="{x:Bind ViewModel.WindowsAppsViewModel.IsContentReady, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.WindowsAppsViewModel.StatusText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- External Apps Content -->
                    <Grid x:Name="ExternalAppsPanel" x:Load="{x:Bind IsExternalAppsPanelLoaded, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Stacked: the Chocolatey note can be open under a banner. -->
                        <StackPanel Grid.Row="0">
                            <!-- Review Mode Banner for External Apps -->
                            <InfoBar x:Name="ExternalAppsReviewBanner"
                                     x:Load="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                                     Severity="Warning"
                                     IsClosable="False"
                                     Message="{x:Bind ViewModel.ReviewExternalAppsBannerText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>

                            <!-- Builder Mode Banner for External Apps (Config and Autounattend targets) -->
                            <InfoBar x:Name="ExternalAppsBuilderBanner"
                                     x:Load="{x:Bind ViewModel.IsBuilderModeActive, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.IsBuilderModeActive, Mode=OneWay}"
                                     Severity="Warning"
                                     IsClosable="False"
                                     Message="{x:Bind ViewModel.BuilderExternalAppsBannerText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>

                            <InfoBar x:Name="ChocolateyNote"
                                     x:Load="{x:Bind ViewModel.ExternalAppsViewModel.IsChocolateyNoteVisible, Mode=OneWay}"
                                     IsOpen="{x:Bind ViewModel.ExternalAppsViewModel.IsChocolateyNoteVisible, Mode=OneWay}"
                                     Severity="Informational"
                                     IsClosable="False"
                                     Message="{x:Bind ViewModel.ExternalAppsViewModel.ChocolateyNoteText, Mode=OneWay}"
                                     Margin="{StaticResource BannerBottomMargin}"/>
                        </StackPanel>

                        <!-- Collapsed until the load or refresh finishes, so the loader below stands alone. -->
                        <Grid x:Name="ExternalAppsContent"
                              Grid.Row="1"
                              x:Load="{x:Bind ViewModel.ExternalAppsViewModel.IsContentReady, Mode=OneWay}"
                              Loaded="ExternalAppsContent_Loaded">

                        <!-- DataGrid View -->
                        <Grid x:Name="ExternalAppsTableView" x:Load="{x:Bind IsShown(ShownView, 'ExternalAppsTableView'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="{StaticResource ItemStackSpacing}" Margin="8,8,0,0">
                                <ContentControl Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource PackageSearchTemplate}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False"
                                                Loaded="PackageSearch_Loaded" Unloaded="PackageSearch_Unloaded"/>
                                <winhanceControls:SelectAllBar Source="{x:Bind ViewModel.ExternalAppsViewModel}"/>
                            </StackPanel>
                        <controls:DataGrid x:Name="ExternalAppsDataGrid"
                                           Grid.Row="1"
                                           Loaded="ExternalAppsDataGrid_Loaded"
                                           Unloaded="AppsDataGrid_Unloaded"
                                           PreviewKeyDown="AppsDataGrid_PreviewKeyDown"
                                           ItemsSource="{x:Bind ViewModel.ExternalAppsViewModel.ItemsView, Mode=OneWay}"
                                           AutoGenerateColumns="False"
                                           CanUserSortColumns="True"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="True"
                                           GridLinesVisibility="None"
                                           HeadersVisibility="Column"
                                           SelectionMode="Extended"
                                           IsReadOnly="True"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Disabled"
                                           Background="Transparent"
                                           RowBackground="Transparent"
                                           AlternatingRowBackground="Transparent"
                                           BorderThickness="0"
                                           Padding="0,0,0,12"
                                           ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                                           RowStyle="{StaticResource SelectionRowStyle}"
                                           CellStyle="{StaticResource AppCellStyle}"
                                           Sorting="DataGrid_Sorting">
                            <controls:DataGrid.Columns>
                                <!-- Selection Column with Select All header -->
                                <controls:DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="False"
                                                                  HeaderStyle="{StaticResource FirstColumnHeaderStyle}"
                                                                  CellTemplate="{StaticResource AppSelectCellTemplate}"
                                                                  CellEditingTemplate="{StaticResource AppSelectCellTemplate}"/>

                                <!-- Name Column -->
                                <controls:DataGridTemplateColumn Header="Name" Width="1.2*" Tag="Name" CellTemplate="{StaticResource AppNameCellTemplate}"/>

                                <!-- Description Column -->
                                <controls:DataGridTemplateColumn Header="Description" Width="1.6*" Tag="Description">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind DescriptionTooltip, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Group/Category Column. Header text is localized in code-behind (ApplyColumnHeaders). -->
                                <controls:DataGridTemplateColumn Header="Group" Width="1.2*" Tag="CategoryDisplayName">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind CategoryDisplayName, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <controls:DataGridTemplateColumn Header="Version" Width="0.8*" Tag="VersionSortKey">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Update" Width="0.8*" Tag="HasUpdate" CellTemplate="{StaticResource AppUpdateCellTemplate}"/>
                                <controls:DataGridTemplateColumn Header="Installed on" Width="0.8*" Tag="InstalledOn">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind InstalledOnText, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="Size" Width="0.6*" Tag="SizeBytes">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" Margin="{StaticResource ColumnGapMargin}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <!-- Status Column -->
                                <controls:DataGridTemplateColumn Header="Status" Width="160" Tag="IsInstalled">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:AppItemViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}" VerticalAlignment="Center">
                                                <fluentIcons:FluentIcon Icon="{x:Bind StatusIcon, Mode=OneWay}" IconVariant="Color"
                                                                        FontSize="{StaticResource StatusIconFontSize}" VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind StatusColumnText, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Scrollbar spacer column -->
                                <controls:DataGridTemplateColumn Width="16" CanUserResize="False" CanUserSort="False"
                                                                  HeaderStyle="{StaticResource SpacerColumnHeaderStyle}">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                        </Grid>

                        <GridView x:Name="ExternalAppsCardView" x:Load="{x:Bind IsShown(ShownView, 'ExternalAppsCardView'), Mode=OneWay}"
                                  ItemsSource="{x:Bind ExternalCategoriesSource.View, Mode=OneWay}"
                                  ItemTemplate="{StaticResource AppCardTemplate}"
                                  ItemContainerStyle="{StaticResource AppCardItemStyle}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick"
                                  ContainerContentChanging="AppGrid_ContainerContentChanging"
                                  SizeChanged="CardView_SizeChanged"
                                  Loaded="AppList_Loaded"
                                  Padding="{StaticResource AppListPadding}">
                            <GridView.Header>
                                <StackPanel Spacing="20" Margin="8,0,8,20">
                                    <ContentControl Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource PackageSearchTemplate}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False"
                                                Loaded="PackageSearch_Loaded" Unloaded="PackageSearch_Unloaded"/>
                                    <winhanceControls:SelectAllBar Source="{x:Bind ViewModel.ExternalAppsViewModel}"/>
                                </StackPanel>
                            </GridView.Header>
                            <GridView.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource AppGroupHeaderTemplate}" HeaderContainerStyle="{StaticResource AppGroupHeaderContainerStyle}"/>
                            </GridView.GroupStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Half a screen of cards each side instead of the default two: the extra screens held about 40 MB. -->
                                    <ItemsWrapGrid Orientation="Horizontal" GroupPadding="0,0,0,24" AreStickyGroupHeadersEnabled="False" CacheLength="1" Loaded="CardPanel_Loaded"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <ListView x:Name="ExternalAppsCompactView" x:Load="{x:Bind IsShown(ShownView, 'ExternalAppsCompactView'), Mode=OneWay}"
                                  ItemsSource="{x:Bind ExternalSectionLines, Mode=OneWay}"
                                  ItemTemplate="{StaticResource AppSectionLineTemplate}"
                                  ItemContainerStyle="{StaticResource AppSectionItemStyle}"
                                  SelectionMode="None" IsTabStop="False" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled"
                                  SizeChanged="SectionList_SizeChanged"
                                  Loaded="AppList_Loaded"
                                  Padding="{StaticResource AppListPadding}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel CacheLength="0.5"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.Header>
                                <StackPanel Spacing="{StaticResource GroupStackSpacing}" Margin="0,0,0,16">
                                    <ContentControl Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource PackageSearchTemplate}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False"
                                                Loaded="PackageSearch_Loaded" Unloaded="PackageSearch_Unloaded"/>
                                    <winhanceControls:SelectAllBar Source="{x:Bind ViewModel.ExternalAppsViewModel}"/>
                                </StackPanel>
                            </ListView.Header>
                        </ListView>

                        <ProgressBar x:Name="BackgroundWorkBar"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Top"
                                     x:Load="{x:Bind ViewModel.ExternalAppsViewModel.IsWorkingInBackground, Mode=OneWay}"/>

                        </Grid>

                        <!-- Loader for External Apps -->
                        <Grid x:Name="ExternalAppsLoader"
                              Grid.Row="1"
                              x:Load="{x:Bind helpers:LoadWhen.Not(ViewModel.ExternalAppsViewModel.IsContentReady), Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource LoaderSpacing}">
                                <winhanceControls:RocketLoader IsActive="{x:Bind ViewModel.ExternalAppsViewModel.IsContentReady, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.ExternalAppsViewModel.StatusText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <winhanceControls:RocketLoader x:Name="TabLoader" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
