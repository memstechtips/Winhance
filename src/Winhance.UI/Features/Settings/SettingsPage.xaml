<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winhance.UI.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Settings"
    xmlns:viewModels="using:Winhance.UI.Features.Settings.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls">


    <Grid Padding="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header with Icon -->
        <commonControls:PageHeader
            Grid.Row="0"
            Icon="Settings"
            Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
            Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}"/>

        <!-- Row 1: Content Container with rounded corners -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
            CornerRadius="8"
            Margin="0,16,0,12">
            <ScrollViewer
                Padding="0,24,0,24"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        Margin="{StaticResource SettingsContentMargin}"
                        Spacing="{StaticResource SettingsCardSpacing}">

                        <!-- General Settings Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.GeneralLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <!-- Language Setting -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.LanguageHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.LanguageDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="LocalLanguage" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="LanguageComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectedValue="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                SelectedValuePath="Value"
                                FlowDirection="LeftToRight">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" TextReadingOrder="UseFlowDirection"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:SettingsCard>

                        <!-- Theme Setting -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.ThemeHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.ThemeDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="PaintBrushSparkle" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.InstallScopeHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.InstallScopeDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="PeopleTeam" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                IsOn="{x:Bind ViewModel.InstallAppsForAllUsers, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.InstallScopeHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <!-- Background and updates Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.BackgroundLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.CloseToTrayHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.CloseToTrayDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="Dismiss" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="CloseToTraySwitch"
                                IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.CloseToTrayHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.MinimizeToTrayHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.MinimizeToTrayDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowMinimize" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="MinimizeToTraySwitch"
                                IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.MinimizeToTrayHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.StartInTrayHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.StartInTrayDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="Power" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="StartInTraySwitch"
                                IsOn="{x:Bind ViewModel.StartInTrayAtSignIn, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanStartInTrayAtSignIn, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.StartInTrayHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.UpdateCheckHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.UpdateCheckDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="UpdateCheckComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.UpdateCheckOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedUpdateCheckOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"
                                AutomationProperties.Name="{x:Bind ViewModel.UpdateCheckHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.UpdateActionHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.UpdateActionDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="Alert" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="UpdateActionComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.UpdateActionOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedUpdateActionOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"
                                AutomationProperties.Name="{x:Bind ViewModel.UpdateActionHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <!-- Configuration Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.ConfigurationLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <!-- Import/Export Configuration -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.BackupRestoreHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.BackupRestoreDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ImportConfigCommand}">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="I" Modifiers="Control"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button
                                    Content="{x:Bind ViewModel.ExportButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ExportConfigCommand}">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="E" Modifiers="Control"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <!-- System Protection Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.SystemProtectionLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <!-- Create Restore Point -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.SystemProtectionHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.SystemProtectionDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ShieldTask" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing
                                    IsActive="{x:Bind ViewModel.IsCreatingRestorePoint, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsCreatingRestorePoint, Mode=OneWay}"
                                    Width="20" Height="20"/>
                                <Button
                                    Content="{x:Bind ViewModel.CreateRestorePointButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                    Visibility="{x:Bind ViewModel.IsCreatingRestorePoint, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
