<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winhance.UI.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Settings"
    xmlns:viewModels="using:Winhance.UI.Features.Settings.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:helpers="using:Winhance.UI.Features.Common.Helpers"
    xmlns:interfaces="using:Winhance.Core.Features.Common.Interfaces"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="ExpanderInfoBarStyle" TargetType="InfoBar"/>
        <local:BackgroundRowTemplateSelector x:Key="BackgroundRowTemplateSelector">
            <local:BackgroundRowTemplateSelector.ModeTemplate>
                <DataTemplate x:DataType="viewModels:ModeRow">
                    <controls:SettingsCard
                        Header="{x:Bind Vm.ModeHeader, Mode=OneWay}"
                        Description="{x:Bind Vm.ModeDescription, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon>
                            <fluentIcons:FluentIcon Icon="Settings" IconVariant="Regular"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="KeepRemovedModeComboBox"
                            MinWidth="260"
                            IsEnabled="{x:Bind Enabled}"
                            ItemsSource="{x:Bind Vm.ModeOptions}"
                            SelectedItem="{x:Bind Vm.SelectedModeOption, Mode=TwoWay}"
                            DisplayMemberPath="DisplayText"
                            AutomationProperties.Name="{x:Bind Vm.ModeHeader, Mode=OneWay}"/>
                    </controls:SettingsCard>
                </DataTemplate>
            </local:BackgroundRowTemplateSelector.ModeTemplate>
            <local:BackgroundRowTemplateSelector.EmptyListTemplate>
                <DataTemplate x:DataType="viewModels:EmptyListRow">
                    <InfoBar
                        x:Name="KeepRemovedEmptyInfoBar"
                        Style="{StaticResource ExpanderInfoBarStyle}"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Margin="{StaticResource ExpanderInfoBarMargin}"
                        Message="{x:Bind Message}">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="KeepRemovedOpenSoftwareAppsButton"
                                Content="{x:Bind ActionText}"
                                Command="{x:Bind Action}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </DataTemplate>
            </local:BackgroundRowTemplateSelector.EmptyListTemplate>
            <local:BackgroundRowTemplateSelector.FolderSafeTemplate>
                <DataTemplate x:DataType="viewModels:FolderSafeRow">
                    <InfoBar
                        x:Name="TaskSafetyProtectedInfoBar"
                        Style="{StaticResource ExpanderInfoBarStyle}"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Success"
                        Margin="{StaticResource ExpanderInfoBarMargin}"
                        Message="{x:Bind Message}"/>
                </DataTemplate>
            </local:BackgroundRowTemplateSelector.FolderSafeTemplate>
            <local:BackgroundRowTemplateSelector.FolderUnsafeTemplate>
                <DataTemplate x:DataType="viewModels:FolderUnsafeRow">
                    <InfoBar
                        x:Name="TaskSafetyNeedsRepairInfoBar"
                        Style="{StaticResource ExpanderInfoBarStyle}"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Margin="{StaticResource ExpanderInfoBarMargin}"
                        Message="{x:Bind Message}">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="TaskSafetyRepairButton"
                                Content="{x:Bind ActionText}"
                                Command="{x:Bind Action}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </DataTemplate>
            </local:BackgroundRowTemplateSelector.FolderUnsafeTemplate>
            <local:BackgroundRowTemplateSelector.CategoryTemplate>
                <DataTemplate x:DataType="viewModels:CategoryRow">
                    <controls:SettingsCard
                        Header="{x:Bind Title}"
                        Description="{x:Bind Detail}"
                        HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGroupSpacing}" VerticalAlignment="Center">
                            <StackPanel Spacing="{StaticResource BadgeRowSpacing}" VerticalAlignment="Center">
                                <Border x:Name="ActivePill" x:Load="{x:Bind Active}" HorizontalAlignment="Right" Style="{StaticResource BadgeInstalledStyle}">
                                    <TextBlock Text="{x:Bind TaskStatus}"
                                               Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                </Border>
                                <Border x:Name="InactivePill" x:Load="{x:Bind Inactive}" HorizontalAlignment="Right" Style="{StaticResource BadgeDefaultStyle}">
                                    <TextBlock Text="{x:Bind TaskStatus}" Style="{StaticResource BadgeTextStyle}"/>
                                </Border>
                                <Border x:Name="ScriptPresentPill" x:Load="{x:Bind ShowScriptPresent}" HorizontalAlignment="Right" Style="{StaticResource BadgeInstalledStyle}">
                                    <TextBlock Text="{x:Bind ScriptStatus}"
                                               Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                </Border>
                                <Border x:Name="ScriptMissingPill" x:Load="{x:Bind ShowScriptMissing}" HorizontalAlignment="Right" Style="{StaticResource BadgeDefaultStyle}">
                                    <TextBlock Text="{x:Bind ScriptStatus}" Style="{StaticResource BadgeTextStyle}"/>
                                </Border>
                            </StackPanel>
                            <DropDownButton x:Name="BackgroundTaskActionsButton" x:Load="{x:Bind HasTaskActions}" Content="{x:Bind ActionsText}" VerticalAlignment="Center">
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="{StaticResource ControlRowSpacing}">
                                            <Button x:Name="ToolToggleButton" x:Load="{x:Bind CanToggle}" Content="{x:Bind ToggleText}" Command="{x:Bind Toggle}" CommandParameter="{x:Bind}"/>
                                            <Button x:Name="ToolRepairButton" x:Load="{x:Bind CanRepair}" Content="{x:Bind RepairText}" Command="{x:Bind Repair}" CommandParameter="{x:Bind}"/>
                                            <Button x:Name="ToolRemoveButton" x:Load="{x:Bind CanRemove}" Content="{x:Bind RemoveText}" Command="{x:Bind Remove}" CommandParameter="{x:Bind}"/>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="ToolStopButton" x:Load="{x:Bind CanStop}" Content="{x:Bind StopText}" Command="{x:Bind Stop}" CommandParameter="{x:Bind}"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </local:BackgroundRowTemplateSelector.CategoryTemplate>
            <local:BackgroundRowTemplateSelector.TaskTemplate>
                <DataTemplate x:DataType="viewModels:TaskRow">
                    <controls:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Detail}" Opacity="{x:Bind Opacity}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}">
                            <Button x:Name="TaskPrimaryButton" x:Load="{x:Bind HasPrimary}" Content="{x:Bind PrimaryText}" Command="{x:Bind Primary}" CommandParameter="{x:Bind}"/>
                            <Button x:Name="TaskSecondaryButton" x:Load="{x:Bind HasSecondary}" Content="{x:Bind SecondaryText}" Command="{x:Bind Secondary}"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </local:BackgroundRowTemplateSelector.TaskTemplate>
        </local:BackgroundRowTemplateSelector>
    </Page.Resources>


    <Grid Padding="{StaticResource PageRootPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header with Icon -->
        <commonControls:PageHeader
            Grid.Row="0"
            Icon="Settings"
            Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
            Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}"/>

        <!-- Row 1: Content Container with rounded corners -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
            CornerRadius="{StaticResource SectionBandCornerRadius}"
            Margin="0,16,0,12">
            <ScrollViewer
                x:Name="PageScrollViewer"
                Padding="0,24,0,24"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        Margin="{StaticResource SettingsContentMargin}"
                        Spacing="{StaticResource SettingsCardSpacing}">

                        <!-- General Settings Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.GeneralLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <!-- Language Setting -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.LanguageHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.LanguageDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="LocalLanguage" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="LanguageComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectedValue="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                SelectedValuePath="Value"
                                FlowDirection="LeftToRight">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="interfaces:ComboBoxDisplayOption">
                                        <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextReadingOrder="UseFlowDirection"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:SettingsCard>

                        <!-- Theme Setting -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.ThemeHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.ThemeDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="PaintBrushSparkle" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"/>
                        </controls:SettingsCard>

                        <!-- System Protection Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.SystemProtectionLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <!-- Create Restore Point -->
                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.SystemProtectionHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.SystemProtectionDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ShieldTask" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGroupSpacing}" VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="RestorePointRing"
                                    x:Load="{x:Bind ViewModel.IsCreatingRestorePoint, Mode=OneWay}"
                                    IsActive="True"
                                    Width="20" Height="20"/>
                                <Button
                                    x:Name="CreateRestorePointButton"
                                    x:Load="{x:Bind helpers:LoadWhen.Not(ViewModel.IsCreatingRestorePoint), Mode=OneWay}"
                                    Content="{x:Bind ViewModel.CreateRestorePointButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CreateRestorePointCommand}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <!-- Background and updates Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.BackgroundLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <controls:SettingsExpander
                            x:Name="TrayExpander"
                            Header="{x:Bind ViewModel.TrayHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.TrayDescription, Mode=OneWay}"
                            IsExpanded="True">
                            <controls:SettingsExpander.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="Power" IconVariant="Regular"/>
                            </controls:SettingsExpander.HeaderIcon>
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Header="{x:Bind ViewModel.CloseToTrayHeader, Mode=OneWay}"
                                    Description="{x:Bind ViewModel.CloseToTrayDescription, Mode=OneWay}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <fluentIcons:FluentIcon Icon="Dismiss" IconVariant="Regular"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        x:Name="CloseToTraySwitch"
                                        IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.CloseToTrayHeader, Mode=OneWay}"/>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Header="{x:Bind ViewModel.MinimizeToTrayHeader, Mode=OneWay}"
                                    Description="{x:Bind ViewModel.MinimizeToTrayDescription, Mode=OneWay}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <fluentIcons:FluentIcon Icon="ArrowMinimize" IconVariant="Regular"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        x:Name="MinimizeToTraySwitch"
                                        IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.MinimizeToTrayHeader, Mode=OneWay}"/>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Header="{x:Bind ViewModel.StartInTrayHeader, Mode=OneWay}"
                                    Description="{x:Bind ViewModel.StartInTrayDescription, Mode=OneWay}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <fluentIcons:FluentIcon Icon="Power" IconVariant="Regular"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        x:Name="StartInTraySwitch"
                                        IsOn="{x:Bind ViewModel.StartInTrayAtSignIn, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.CanStartInTrayAtSignIn, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.StartInTrayHeader, Mode=OneWay}"/>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.UpdateCheckHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.UpdateCheckDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="UpdateCheckComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.UpdateCheckOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedUpdateCheckOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"
                                AutomationProperties.Name="{x:Bind ViewModel.UpdateCheckHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.UpdateActionHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.UpdateActionDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="Alert" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="UpdateActionComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.UpdateActionOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedUpdateActionOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"
                                AutomationProperties.Name="{x:Bind ViewModel.UpdateActionHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.WinhanceUpdateActionHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.WinhanceUpdateActionDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowDownload" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="WinhanceUpdateActionComboBox"
                                MinWidth="200"
                                ItemsSource="{x:Bind ViewModel.WinhanceUpdateActionOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedWinhanceUpdateActionOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"
                                AutomationProperties.Name="{x:Bind ViewModel.WinhanceUpdateActionHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <TextBlock
                            Text="{x:Bind ViewModel.ConfigsProfilesLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.ConfigFileHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.ConfigFileDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}">
                                <Button
                                    Content="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ImportConfigCommand}">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="I" Modifiers="Control"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button
                                    Content="{x:Bind ViewModel.ExportButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ExportConfigCommand}">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="E" Modifiers="Control"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsExpander
                            Header="{x:Bind ViewModel.ProfilesHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.ProfilesDescription, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Profiles}"
                            IsExpanded="True">
                            <controls:SettingsExpander.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="PersonSettings" IconVariant="Regular"/>
                            </controls:SettingsExpander.HeaderIcon>
                            <Grid>
                                <ProgressRing
                                    x:Name="ProfileBusyRing"
                                    x:Load="{x:Bind ViewModel.IsProfileBusy, Mode=OneWay}"
                                    IsActive="True"
                                    Width="20" Height="20"/>
                            </Grid>
                            <controls:SettingsExpander.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ProfileRow">
                                    <controls:SettingsCard>
                                        <controls:SettingsCard.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderTagSpacing}">
                                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                <Border x:Name="CleanBadge" x:Load="{x:Bind ShowCleanBadge}" Style="{StaticResource BadgeInstalledStyle}">
                                                    <TextBlock Text="{x:Bind Badge}"
                                                               Style="{StaticResource BadgeTextStyle}"
                                                               Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </Border>
                                                <Border x:Name="AttentionBadge" x:Load="{x:Bind ShowAttentionBadge}" Style="{StaticResource BadgeWarningStyle}">
                                                    <TextBlock Text="{x:Bind Badge}"
                                                               Style="{StaticResource BadgeTextStyle}"
                                                               Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </Border>
                                            </StackPanel>
                                        </controls:SettingsCard.Header>
                                        <controls:SettingsCard.Description>
                                            <StackPanel>
                                                <TextBlock x:Name="ProfileDescription" x:Load="{x:Bind HasDescription}" Text="{x:Bind Description}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                                <TextBlock x:Name="ProfileFailedText"
                                                           x:Load="{x:Bind HasFailed}"
                                                           Text="{x:Bind FailedText}"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </StackPanel>
                                        </controls:SettingsCard.Description>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}">
                                            <Button Content="{x:Bind ApplyText}" Command="{x:Bind Apply}" CommandParameter="{x:Bind Profile}" Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Content="{x:Bind EditText}" Command="{x:Bind Edit}" CommandParameter="{x:Bind Profile}"/>
                                            <Button Content="{x:Bind ExportText}" Command="{x:Bind Export}" CommandParameter="{x:Bind Profile}"/>
                                            <Button x:Name="ProfileDeleteButton" x:Load="{x:Bind CanDelete}" Content="{x:Bind DeleteText}" Command="{x:Bind Delete}" CommandParameter="{x:Bind Profile}"/>
                                        </StackPanel>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </controls:SettingsExpander.ItemTemplate>
                        </controls:SettingsExpander>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.ReapplyHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.ReapplyDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowRepeatAll" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="ReapplyAtSignInSwitch"
                                IsOn="{x:Bind ViewModel.ReapplyAtSignIn, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanReapplyAtSignIn, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ReapplyHeader, Mode=OneWay}"/>
                        </controls:SettingsCard>

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.ReapplyAtSignIn, Mode=OneWay}"
                            IsClosable="False"
                            Severity="Warning"
                            Message="{x:Bind ViewModel.ReapplyWarning, Mode=OneWay}"/>

                        <controls:SettingsCard
                            Header="{x:Bind ViewModel.SaveProfileHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.SaveProfileDescription, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="DocumentSave" IconVariant="Regular"/>
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}">
                                <TextBox
                                    MinWidth="200"
                                    MaxLength="{x:Bind ViewModel.ProfileNameMaxLength}"
                                    Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{x:Bind ViewModel.ProfileNamePlaceholder, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.ProfileNamePlaceholder, Mode=OneWay}"/>
                                <Button
                                    Content="{x:Bind ViewModel.SaveProfileButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.SaveProfileCommand}"/>
                                <Button
                                    Content="{x:Bind ViewModel.AddProfileFromFileButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.AddProfileFromFileCommand}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <!-- Background tasks Group -->
                        <TextBlock
                            Text="{x:Bind ViewModel.BackgroundTasksLabel, Mode=OneWay}"
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <controls:SettingsExpander
                            x:Name="KeepRemovedExpander"
                            Header="{x:Bind ViewModel.KeepRemovedHeader, Mode=OneWay}"
                            Description="{x:Bind ViewModel.KeepRemovedDescription, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.KeepRemovedChildren}"
                            ItemTemplate="{StaticResource BackgroundRowTemplateSelector}"
                            IsExpanded="True">
                            <controls:SettingsExpander.HeaderIcon>
                                <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular"/>
                            </controls:SettingsExpander.HeaderIcon>
                            <ToggleSwitch
                                x:Name="KeepRemovedSwitch"
                                IsOn="{x:Bind ViewModel.KeepRemovedEnabled, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.KeepRemovedHeader, Mode=OneWay}"/>
                        </controls:SettingsExpander>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
