<?xml version="1.0" encoding="utf-8"?>
<winControls:SectionPage
    x:Class="Winhance.UI.Features.Customize.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winControls="using:Winhance.UI.Features.Common.Controls"
    NavigationCacheMode="Enabled">

    <!-- Every element this page draws lives in SectionPageShell, which the other section page
         uses too. What is genuinely this page's own is the icon, its ViewModel, and its
         section-to-detail map - see CustomizePage.xaml.cs. -->
    <winControls:SectionPageShell x:Name="Shell" PageIcon="DesignIdeas"/>
</winControls:SectionPage>
