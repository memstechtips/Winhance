<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Winhance.UI.Features.Common.Converters">


    <!-- Boolean Converters -->
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

    <!-- Null/Empty Converters -->
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>

    <!-- Icon Converters -->
    <converters:IconConverter x:Key="IconConverter"/>
    <converters:SectionIconConverter x:Key="SectionIconConverter"/>
    <converters:StringToGeometryConverter x:Key="StringToGeometryConverter"/>

    <!-- Badge Converters -->

</ResourceDictionary>
