<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Winhance.UI.Features.Common.Converters"
    xmlns:fluentIcons="using:FluentIcons.WinUI">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Pill colours alias WinUI's status pairs (Recommended = Success, Default = Neutral,
             Custom = Caution, Preference = Attention, Danger = Critical), so they follow the
             theme, the accent colour and High Contrast. Each theme repeats the aliases because a
             StaticResource only re-resolves per theme dictionary. -->
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="BadgeRecommendedBackground" ResourceKey="SystemFillColorSuccessBackgroundBrush"/>
            <StaticResource x:Key="BadgeRecommendedBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeRecommendedForeground" ResourceKey="SystemFillColorSuccessBrush"/>
            <StaticResource x:Key="BadgeDefaultBackground" ResourceKey="SystemFillColorNeutralBackgroundBrush"/>
            <StaticResource x:Key="BadgeDefaultBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeDefaultForeground" ResourceKey="SystemFillColorNeutralBrush"/>
            <StaticResource x:Key="BadgeCustomBackground" ResourceKey="SystemFillColorCautionBackgroundBrush"/>
            <StaticResource x:Key="BadgeCustomBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeCustomForeground" ResourceKey="SystemFillColorCautionBrush"/>
            <StaticResource x:Key="BadgePreferenceBackground" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
            <StaticResource x:Key="BadgePreferenceBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgePreferenceForeground" ResourceKey="SystemFillColorAttentionBrush"/>
            <StaticResource x:Key="BadgeDangerBackground" ResourceKey="SystemFillColorCriticalBackgroundBrush"/>
            <StaticResource x:Key="BadgeDangerBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeDangerForeground" ResourceKey="SystemFillColorCriticalBrush"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="BadgeRecommendedBackground" ResourceKey="SystemFillColorSuccessBackgroundBrush"/>
            <StaticResource x:Key="BadgeRecommendedBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeRecommendedForeground" ResourceKey="SystemFillColorSuccessBrush"/>
            <StaticResource x:Key="BadgeDefaultBackground" ResourceKey="SystemFillColorNeutralBackgroundBrush"/>
            <StaticResource x:Key="BadgeDefaultBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeDefaultForeground" ResourceKey="SystemFillColorNeutralBrush"/>
            <StaticResource x:Key="BadgeCustomBackground" ResourceKey="SystemFillColorCautionBackgroundBrush"/>
            <StaticResource x:Key="BadgeCustomBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeCustomForeground" ResourceKey="SystemFillColorCautionBrush"/>
            <StaticResource x:Key="BadgePreferenceBackground" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
            <StaticResource x:Key="BadgePreferenceBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgePreferenceForeground" ResourceKey="SystemFillColorAttentionBrush"/>
            <StaticResource x:Key="BadgeDangerBackground" ResourceKey="SystemFillColorCriticalBackgroundBrush"/>
            <StaticResource x:Key="BadgeDangerBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeDangerForeground" ResourceKey="SystemFillColorCriticalBrush"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="BadgeRecommendedBackground" ResourceKey="SystemFillColorSuccessBackgroundBrush"/>
            <StaticResource x:Key="BadgeRecommendedBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeRecommendedForeground" ResourceKey="SystemFillColorSuccessBrush"/>
            <StaticResource x:Key="BadgeDefaultBackground" ResourceKey="SystemFillColorNeutralBackgroundBrush"/>
            <StaticResource x:Key="BadgeDefaultBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeDefaultForeground" ResourceKey="SystemFillColorNeutralBrush"/>
            <StaticResource x:Key="BadgeCustomBackground" ResourceKey="SystemFillColorCautionBackgroundBrush"/>
            <StaticResource x:Key="BadgeCustomBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeCustomForeground" ResourceKey="SystemFillColorCautionBrush"/>
            <StaticResource x:Key="BadgePreferenceBackground" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
            <StaticResource x:Key="BadgePreferenceBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgePreferenceForeground" ResourceKey="SystemFillColorAttentionBrush"/>
            <StaticResource x:Key="BadgeDangerBackground" ResourceKey="SystemFillColorCriticalBackgroundBrush"/>
            <StaticResource x:Key="BadgeDangerBorder"     ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="BadgeDangerForeground" ResourceKey="SystemFillColorCriticalBrush"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>


    <!-- Pill Border Base -->
    <!--
    Height is pinned so CornerRadius can match half of it and produce a true
    capsule shape. WinUI 3 Border.CornerRadius does not always clamp large
    values (e.g. 999) to half the rendered height — especially with a 1px
    BorderThickness — so fixing both values explicitly is the reliable way
    to guarantee a pill look.
    -->
    <Style x:Key="BadgePillBase" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="7,0,9,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- State-Specific Pill Styles -->
    <Style x:Key="BadgeRecommendedStyle" TargetType="Border" BasedOn="{StaticResource BadgePillBase}">
        <Setter Property="Background"  Value="{ThemeResource BadgeRecommendedBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BadgeRecommendedBorder}"/>
    </Style>

    <Style x:Key="BadgeDefaultStyle" TargetType="Border" BasedOn="{StaticResource BadgePillBase}">
        <Setter Property="Background"  Value="{ThemeResource BadgeDefaultBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BadgeDefaultBorder}"/>
    </Style>

    <Style x:Key="BadgePreferenceStyle" TargetType="Border" BasedOn="{StaticResource BadgePillBase}">
        <Setter Property="Background"  Value="{ThemeResource BadgePreferenceBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BadgePreferenceBorder}"/>
    </Style>


    <!-- Software Apps Status Pill Styles -->
    <!-- Status badges on the Software Apps cards. Same BadgePillBase capsule as the
         settings badges so the two views share one visual vocabulary. -->
    <Style x:Key="BadgeInstalledStyle" TargetType="Border" BasedOn="{StaticResource BadgePillBase}">
        <Setter Property="Background"  Value="{ThemeResource BadgeRecommendedBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BadgeRecommendedBorder}"/>
    </Style>

    <Style x:Key="BadgeNonReinstallableStyle" TargetType="Border" BasedOn="{StaticResource BadgePillBase}">
        <Setter Property="Background"  Value="{ThemeResource BadgeDangerBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BadgeDangerBorder}"/>
    </Style>

    <Style x:Key="BadgeWarningStyle" TargetType="Border" BasedOn="{StaticResource BadgePillBase}">
        <Setter Property="Background"  Value="{ThemeResource BadgeCustomBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BadgeCustomBorder}"/>
    </Style>

    <!-- NEW badge beside setting and section names, in the system accent colour. -->
    <Style x:Key="NewBadgeBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NewBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Text Style -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- Technical Details table badges. Here rather than in TechnicalDetailsStyles.xaml
         because they need the Badge*Foreground brushes and BadgeTextStyle defined above,
         and that dictionary is merged into App.xaml before this one. -->
    <Style x:Key="TechDetail.Table.BadgeRecommendedIcon" TargetType="PathIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource BadgeRecommendedForeground}"/>
    </Style>

    <Style x:Key="TechDetail.Table.BadgeDefaultIcon" TargetType="PathIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource BadgeDefaultForeground}"/>
    </Style>

    <Style x:Key="TechDetail.Table.BadgeRecommendedText" TargetType="TextBlock"
           BasedOn="{StaticResource BadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BadgeRecommendedForeground}"/>
    </Style>

    <Style x:Key="TechDetail.Table.BadgeDefaultText" TargetType="TextBlock"
           BasedOn="{StaticResource BadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BadgeDefaultForeground}"/>
    </Style>

    <!-- Quick-Set Buttons -->
    <!--
    Small borderless icon buttons placed in front of every setting's control. Visible
    only when UserPreferences.ShowInfoBadges is on. The green star matches the
    Recommended InfoBadge; the grey 2x2-grid icon matches the Default InfoBadge —
    keeping the Recommended/Default visual vocabulary consistent across InfoBadge
    pills, Quick Actions menu items, and these per-card buttons.

    Hover/press: the icon child carries its own Foreground brush (BadgeRecommendedForeground
    / BadgeDefaultForeground) so the default ButtonForegroundPointerOver override on the
    ContentPresenter has no effect — the green/grey stays while the usual background
    hover tint still renders.
    -->
    <Style x:Key="QuickSetButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="QuickSetRecommendedButtonStyle" TargetType="Button"
           BasedOn="{StaticResource QuickSetButtonBase}">
        <Setter Property="Foreground" Value="{ThemeResource BadgeRecommendedForeground}"/>
    </Style>

    <Style x:Key="QuickSetDefaultButtonStyle" TargetType="Button"
           BasedOn="{StaticResource QuickSetButtonBase}">
        <Setter Property="Foreground" Value="{ThemeResource BadgeDefaultForeground}"/>
    </Style>

</ResourceDictionary>
