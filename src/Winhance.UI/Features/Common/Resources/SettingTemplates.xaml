<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Winhance.UI.Features.Common.Resources.SettingTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Winhance.UI.Features.Optimize.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:commonViewModels="using:Winhance.UI.Features.Common.ViewModels"
    xmlns:converters="using:Winhance.UI.Features.Common.Converters"
    xmlns:selectors="using:Winhance.UI.Features.Common.TemplateSelectors"
    xmlns:coreModels="using:Winhance.Core.Features.Common.Models"
    xmlns:fluentIcons="using:FluentIcons.WinUI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TechnicalDetailsStyles.xaml"/>
        <ResourceDictionary Source="IconSizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Common spacing for settings cards -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <converters:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter"/>

    <converters:BadgePillTemplateSelector x:Key="BadgePillTemplateSelector">

        <converters:BadgePillTemplateSelector.RecommendedTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeRecommendedStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource BadgeRecommendedIconPath}"
                                  Height="12" Width="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.RecommendedTemplate>

        <converters:BadgePillTemplateSelector.DefaultTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeDefaultStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource BadgeDefaultIconPath}"
                                  Height="12" Width="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource BadgeDefaultForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeDefaultForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.DefaultTemplate>


        <converters:BadgePillTemplateSelector.PreferenceTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgePreferenceStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource BadgePreferenceIconPath}"
                                  Height="12" Width="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource BadgePreferenceForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgePreferenceForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.PreferenceTemplate>

    </converters:BadgePillTemplateSelector>

    <!-- Common layout values for settings pages -->
    <x:Double x:Key="SettingsContentMaxWidth">1000</x:Double>
    <Thickness x:Key="SettingsContentMargin">24,0,24,0</Thickness>

    <!-- SettingsCard internal spacing overrides for tighter layout -->
    <!-- Reduce padding around the icon area -->
    <Thickness x:Key="SettingsCardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,16,0</Thickness>
    <x:Double x:Key="SettingsCardHeaderIconMaxSize">24</x:Double>
    <Thickness x:Key="SettingsExpanderItemPadding">16,12,16,12</Thickness>

    <!-- Style for settings section headers -->
    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Style.Setters>
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style.Setters>
    </Style>

    <DataTemplate x:Key="ListTextFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <StackPanel Spacing="4">
            <TextBox
                Header="{x:Bind Label}"
                Text="{x:Bind Text, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Label}"/>
            <TextBlock
                Text="{x:Bind Error}"
                Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ListPasswordFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <PasswordBox
            Header="{x:Bind Label}"
            Password="{x:Bind Text, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Label}"/>
    </DataTemplate>

    <!-- SelectedIndex, not SelectedValue: WinUI cannot match a SelectedValue that is an app value
         (microsoft-ui-xaml #5922), so the closed box would stay blank until the user picks. -->
    <DataTemplate x:Key="ListSelectionFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <ComboBox
            Header="{x:Bind Label}"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind Options}"
            SelectedIndex="{x:Bind OptionIndex, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Label}"/>
    </DataTemplate>

    <DataTemplate x:Key="ListCheckBoxFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <CheckBox
            Content="{x:Bind Label}"
            IsChecked="{x:Bind Checked, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Tooltip}"/>
    </DataTemplate>

    <selectors:ListFieldTemplateSelector
        x:Key="ListFieldTemplateSelector"
        TextTemplate="{StaticResource ListTextFieldTemplate}"
        PasswordTemplate="{StaticResource ListPasswordFieldTemplate}"
        SelectionTemplate="{StaticResource ListSelectionFieldTemplate}"
        CheckBoxTemplate="{StaticResource ListCheckBoxFieldTemplate}"/>

    <DataTemplate x:Key="ListRowTemplate" x:DataType="commonViewModels:ListRowViewModel">
        <controls:SettingsCard
            IsTabStop="False"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch"
            MinHeight="0">
            <!-- A CheckBox's check glyph is an AnimatedIcon that mirrors AnimatedIcon.State from the nearest ancestor
                 that sets one, and the toolkit card moves its own on hover. The accept animation has no "PointerOver"
                 frame, so the glyph cut to a drawn check while the pointer crossed the card. -->
            <StackPanel Spacing="8" AnimatedIcon.State="Normal">
                <ItemsControl
                    ItemsSource="{x:Bind Fields}"
                    ItemTemplateSelector="{StaticResource ListFieldTemplateSelector}"
                    HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button
                    Content="{x:Bind RemoveLabel}"
                    Click="{x:Bind Remove}"
                    IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                    HorizontalAlignment="Right"/>
            </StackPanel>
        </controls:SettingsCard>
    </DataTemplate>

    <!-- IsThreeState stays false: a click can only hand back true or false, and a parent with mixed children
         still renders indeterminate from the IncludeState getter alone. -->
    <DataTemplate x:Key="IncludeBoxTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <CheckBox
                IsChecked="{x:Bind IncludeState, Mode=TwoWay}"
                IsThreeState="False"
                AutomationProperties.Name="{x:Bind IncludeAutomationName, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind IncludeToolTip, Mode=OneWay}"
                MinWidth="0"
                Padding="0"
                VerticalAlignment="Center"/>
            <Grid Width="16" Height="16" VerticalAlignment="Center"
                  Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}">
                <fluentIcons:FluentIcon Icon="Link" IconVariant="Regular" FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <fluentIcons:FluentIcon Icon="LinkOff" IconVariant="Regular" FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SettingItemTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Visibility="{x:Bind EffectiveIsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,2">
            <!-- IsIncluded is true outside authoring, so the card is disabled only while authoring leaves it out. -->
            <Grid>
                <controls:SettingsCard
                    IsTabStop="False"
                    IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                    AutomationProperties.LocalizedControlType="setting"
                    HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                    Padding="{x:Bind CardPadding, Mode=OneWay}">
                    <controls:SettingsCard.Description>
                        <commonControls:SettingDescriptionWithBadges
                            DescriptionText="{x:Bind Description}"
                            BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                            ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                            <Border
                                Visibility="{x:Bind ShowNewBadge, Mode=OneWay}"
                                Style="{StaticResource NewBadgeBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind NewBadgeText}"
                                    Style="{StaticResource NewBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                        IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                </controls:SettingsCard>

                <!-- Applying overlay with spinner -->
                <Border
                    Visibility="{x:Bind IsApplying, Mode=OneWay}"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    CornerRadius="4">
                    <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                </Border>

                <!-- Lock overlay covering entire SettingsCard -->
                <Grid Visibility="{x:Bind IsLocked, Mode=OneWay}">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                        </TransitionCollection>
                    </Grid.Transitions>
                    <!-- Semi-transparent background layer -->
                    <Border
                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                        CornerRadius="4"/>
                    <!-- Button layer with full opacity -->
                    <Button
                        Command="{x:Bind UnlockCommand}"
                        AutomationProperties.Name="{x:Bind ClickToUnlockText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16">
                                <Path
                                    Data="{StaticResource PrivacyIconPath}"
                                    Fill="#FFA500"
                                    Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock
                                Text="{x:Bind ClickToUnlockText}"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- A sibling of the card, not a child, so the box stays live while the card is disabled. -->
                <ContentControl
                    Content="{x:Bind}"
                    ContentTemplate="{StaticResource IncludeBoxTemplate}"
                    Visibility="{x:Bind ShowIncludeCheckbox, Mode=OneWay}"
                    IsTabStop="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"/>
            </Grid>

            <ContentControl
                Visibility="{x:Bind HasRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                IsTabStop="False"
                HorizontalContentAlignment="Stretch">
                <controls:SettingsCard
                    IsTabStop="False"
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,4,4"
                    Margin="0,-1,0,0"
                    MinHeight="0"
                    Padding="{x:Bind RowPadding, Mode=OneWay}">
                    <!-- AnimatedIcon.State: the banner's CheckBox glyph would otherwise mirror this card's hover state. -->
                    <StackPanel Spacing="8" AnimatedIcon.State="Normal">
                        <ItemsRepeater ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ListRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <commonControls:QuietInfoBar
                            Visibility="{x:Bind ShowPasswordBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            IsOpen="{x:Bind ShowPasswordBanner, Mode=OneWay}"
                            Severity="Informational"
                            Message="{x:Bind SavePasswordsNote, Mode=OneWay}"
                            IsClosable="False">
                            <CheckBox
                                Content="{x:Bind SavePasswordsLabel, Mode=OneWay}"
                                IsChecked="{x:Bind SavePasswords, Mode=TwoWay}"
                                Margin="0,0,0,8"/>
                        </commonControls:QuietInfoBar>
                    </StackPanel>
                </controls:SettingsCard>
            </ContentControl>

            <!-- Technical Details panel -->
            <commonControls:TechnicalDetailsPanel
                Matrix="{x:Bind TechnicalDetailMatrix, Mode=OneWay}"
                IsExpanded="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                IsBarVisible="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay}"
                HeaderLabel="{x:Bind TechnicalDetailsLabel, Mode=OneWay}"
                BarCornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                ToggleCommand="{x:Bind ToggleTechnicalDetailsCommand}"
                RegeditCommand="{x:Bind OpenRegeditCommand}"/>

            <!-- Status banner below the settings card (QuietInfoBar suppresses
                 InfoBarAutomationPeer's hardcoded Assertive live setting) -->
            <Border Visibility="{x:Bind HasStatusBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">
                <commonControls:QuietInfoBar
                    IsOpen="{x:Bind HasStatusBanner, Mode=OneWay}"
                    Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                    Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                    IconSource="{x:Bind StatusBannerIconSource, Mode=OneWay}"
                    IsClosable="False"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    Margin="0,-1,0,0"
                    CornerRadius="0,0,4,4"/>
            </Border>

            <!-- Review mode diff banner (shown when a config diff exists for this setting) -->
            <Border Visibility="{x:Bind HasReviewDiff, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">
                <InfoBar
                    IsOpen="{x:Bind HasReviewDiff, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    AutomationProperties.LiveSetting="Off"
                    Margin="0,-1,0,0"
                    CornerRadius="0,0,4,4">
                    <InfoBar.Content>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,8,4">
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ReviewDiffMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="1"
                                Content="Apply"
                                GroupName="{x:Bind SettingId}"
                                IsChecked="{x:Bind IsReviewApproved, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="2"
                                Content="Don't apply"
                                GroupName="{x:Bind SettingId}"
                                IsChecked="{x:Bind IsReviewRejected, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>
            </Border>

            <!-- Review mode action banner (shown for action settings like wallpaper alongside a diff) -->
            <Border Visibility="{x:Bind HasReviewAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">
                <InfoBar
                    IsOpen="{x:Bind HasReviewAction, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    AutomationProperties.LiveSetting="Off"
                    Margin="0,-1,0,0"
                    CornerRadius="0,0,4,4">
                    <InfoBar.Content>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,8,4">
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ReviewActionMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="1"
                                Content="Apply"
                                GroupName="{x:Bind ReviewActionGroupName}"
                                IsChecked="{x:Bind IsReviewActionApproved, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="2"
                                Content="Don't apply"
                                GroupName="{x:Bind ReviewActionGroupName}"
                                IsChecked="{x:Bind IsReviewActionRejected, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SettingExpanderItemTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Visibility="{x:Bind EffectiveIsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,2">
            <!-- Parent setting card with expand/collapse chevron -->
            <Grid>
                <!-- IsEnabled is bound on the inner SettingsCardItem (the actual input
                     control) rather than the SettingsCard root. The card itself stays
                     interactive so its click-to-expand handler keeps working in Review
                     Mode and while authoring leaves it out, which keeps its children
                     reachable; only the toggle/dropdown inside dims out.
                     IsTabStop is true so keyboard users can Tab onto the card and press
                     Enter/Space to expand (SettingsCard's IsClickEnabled invokes the Click
                     handler on those keys). AutomationProperties.Name is what Narrator
                     announces when the card is focused. -->
                <controls:SettingsCard
                    IsClickEnabled="True"
                    Click="{x:Bind ToggleExpander}"
                    IsTabStop="True"
                    AutomationProperties.Name="{x:Bind Name}"
                    AutomationProperties.LocalizedControlType="setting"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="{x:Bind ParentCornerRadius, Mode=OneWay}"
                    Padding="{x:Bind CardPadding, Mode=OneWay}">
                    <!-- Hide the built-in > action icon that appears with IsClickEnabled -->
                    <controls:SettingsCard.Resources>
                        <x:Double x:Key="SettingsCardActionIconMaxSize">0</x:Double>
                        <Thickness x:Key="SettingsCardActionIconMargin">0</Thickness>
                    </controls:SettingsCard.Resources>

                    <!-- This card stays enabled so it can expand, and only the toolkit's disabled state dims a HeaderIcon;
                         an IconSourceElement can bind Opacity. The 1px lift matches IconConverter's path icon margin. -->
                    <controls:SettingsCard.HeaderIcon>
                        <IconSourceElement
                            IconSource="{x:Bind Converter={StaticResource IconConverter}}"
                            Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"
                            Margin="0,0,0,1"/>
                    </controls:SettingsCard.HeaderIcon>

                    <controls:SettingsCard.Description>
                        <commonControls:SettingDescriptionWithBadges
                            Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"
                            DescriptionText="{x:Bind Description}"
                            BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                            ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                    </controls:SettingsCard.Description>

                    <controls:SettingsCard.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                    Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}">
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                            <Border
                                Visibility="{x:Bind ShowNewBadge, Mode=OneWay}"
                                Style="{StaticResource NewBadgeBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind NewBadgeText}"
                                    Style="{StaticResource NewBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </controls:SettingsCard.Header>

                    <!-- Parent's input control + expand/collapse chevron -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                            IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                        <Grid Width="20" Height="20">
                            <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource CardExpanderChevronFontSize}"
                                      Visibility="{x:Bind IsExpanderExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource CardExpanderChevronFontSize}"
                                      Visibility="{x:Bind IsExpanderExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>

                </controls:SettingsCard>

                <!-- Applying overlay with spinner -->
                <Border
                    Visibility="{x:Bind IsApplying, Mode=OneWay}"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    CornerRadius="4">
                    <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                </Border>

                <!-- Lock overlay covering entire SettingsExpander -->
                <Grid Visibility="{x:Bind IsLocked, Mode=OneWay}">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                        </TransitionCollection>
                    </Grid.Transitions>
                    <!-- Semi-transparent background layer -->
                    <Border
                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                        CornerRadius="4"/>
                    <!-- Button layer with full opacity -->
                    <Button
                        Command="{x:Bind UnlockCommand}"
                        AutomationProperties.Name="{x:Bind ClickToUnlockText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16">
                                <Path
                                    Data="{StaticResource PrivacyIconPath}"
                                    Fill="#FFA500"
                                    Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock
                                Text="{x:Bind ClickToUnlockText}"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ContentControl
                    Content="{x:Bind}"
                    ContentTemplate="{StaticResource IncludeBoxTemplate}"
                    Visibility="{x:Bind ShowIncludeCheckbox, Mode=OneWay}"
                    IsTabStop="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"/>
            </Grid>

            <!-- Technical Details panel -->
            <commonControls:TechnicalDetailsPanel
                Matrix="{x:Bind TechnicalDetailMatrix, Mode=OneWay}"
                IsExpanded="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                IsBarVisible="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay}"
                HeaderLabel="{x:Bind TechnicalDetailsLabel, Mode=OneWay}"
                BarCornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                ToggleCommand="{x:Bind ToggleTechnicalDetailsCommand}"
                RegeditCommand="{x:Bind OpenRegeditCommand}"/>

            <!-- Status banner -->
            <Border Visibility="{x:Bind HasStatusBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">
                <commonControls:QuietInfoBar
                    IsOpen="{x:Bind HasStatusBanner, Mode=OneWay}"
                    Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                    Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                    IconSource="{x:Bind StatusBannerIconSource, Mode=OneWay}"
                    IsClosable="False"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    Margin="0,-1,0,0"
                    CornerRadius="0,0,4,4"/>
            </Border>

            <!-- Review mode diff banner -->
            <Border Visibility="{x:Bind HasReviewDiff, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">
                <InfoBar
                    IsOpen="{x:Bind HasReviewDiff, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    AutomationProperties.LiveSetting="Off"
                    Margin="0,-1,0,0"
                    CornerRadius="0,0,4,4">
                    <InfoBar.Content>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,8,4">
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ReviewDiffMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="1"
                                Content="Apply"
                                GroupName="{x:Bind SettingId}"
                                IsChecked="{x:Bind IsReviewApproved, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="2"
                                Content="Don't apply"
                                GroupName="{x:Bind SettingId}"
                                IsChecked="{x:Bind IsReviewRejected, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>
            </Border>

            <!-- Review mode action banner -->
            <Border Visibility="{x:Bind HasReviewAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">
                <InfoBar
                    IsOpen="{x:Bind HasReviewAction, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    AutomationProperties.LiveSetting="Off"
                    Margin="0,-1,0,0"
                    CornerRadius="0,0,4,4">
                    <InfoBar.Content>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,8,4">
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ReviewActionMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="1"
                                Content="Apply"
                                GroupName="{x:Bind ReviewActionGroupName}"
                                IsChecked="{x:Bind IsReviewActionApproved, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                            <RadioButton
                                Grid.Column="2"
                                Content="Don't apply"
                                GroupName="{x:Bind ReviewActionGroupName}"
                                IsChecked="{x:Bind IsReviewActionRejected, Mode=TwoWay}"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>
            </Border>

            <!-- Children rendered below the expander with full template support (tech details, banners) -->
            <ItemsRepeater ItemsSource="{x:Bind Children}"
                           Visibility="{x:Bind IsExpanderExpanded, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SettingItemViewModel">
                        <StackPanel Visibility="{x:Bind EffectiveIsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <!-- MinHeight is a local attribute: the toolkit's 68 comes from a Style setter no
                                     per-card resource can reach. -->
                                <controls:SettingsCard
                                    IsTabStop="False"
                                    IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                                    AutomationProperties.LocalizedControlType="setting"
                                    HeaderIcon="{x:Bind ChildHeaderIcon, Mode=OneWay}"
                                    CornerRadius="{x:Bind ChildCornerRadius, Mode=OneWay}"
                                    BorderThickness="1,0,1,1"
                                    MinHeight="{x:Bind ChildMinHeight, Mode=OneWay}"
                                    ContentAlignment="{x:Bind ChildContentAlignment, Mode=OneWay}"
                                    HorizontalContentAlignment="{x:Bind ChildContentHorizontalAlignment, Mode=OneWay}"
                                    Padding="{x:Bind ChildCardPadding, Mode=OneWay}">
                                    <controls:SettingsCard.Description>
                                        <commonControls:SettingDescriptionWithBadges
                                            Visibility="{x:Bind IsCompactRow, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            DescriptionText="{x:Bind Description}"
                                            BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                            ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                                    </controls:SettingsCard.Description>
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ChildHeader}" VerticalAlignment="Center"/>
                                            <Border
                                                Visibility="{x:Bind ShowNewBadge, Mode=OneWay}"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock
                                                    Text="{x:Bind NewBadgeText}"
                                                    Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                                        IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                        AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                                </controls:SettingsCard>

                                <!-- Applying overlay -->
                                <Border
                                    Visibility="{x:Bind IsApplying, Mode=OneWay}"
                                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                                </Border>

                                <ContentControl
                                    Content="{x:Bind}"
                                    ContentTemplate="{StaticResource IncludeBoxTemplate}"
                                    Visibility="{x:Bind ShowIncludeCheckbox, Mode=OneWay}"
                                    IsTabStop="False"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="54,0,0,0"/>
                            </Grid>

                            <controls:SettingsCard
                                Visibility="{x:Bind ShowsOptionTiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsTabStop="False"
                                IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                                AutomationProperties.LocalizedControlType="setting"
                                CornerRadius="{x:Bind BrowseRowCornerRadius, Mode=OneWay}"
                                BorderThickness="1,0,1,1"
                                MinHeight="{x:Bind ChildMinHeight, Mode=OneWay}"
                                Padding="{x:Bind ChildCardPadding, Mode=OneWay}">
                                <controls:SettingsCard.Header>
                                    <TextBlock Text="{x:Bind BrowseRowHeader}" VerticalAlignment="Center"/>
                                </controls:SettingsCard.Header>
                                <commonControls:SettingTileSelection Setting="{x:Bind}" Part="Browse"
                                    IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"/>
                            </controls:SettingsCard>

                            <ContentControl
                                Visibility="{x:Bind HasRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,4,4"
                                    Margin="0,-1,0,0"
                                    Padding="54,8,52,12">
                                    <StackPanel Spacing="8" AnimatedIcon.State="Normal">
                                        <ItemsRepeater ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ListRowTemplate}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8"/>
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                        <commonControls:QuietInfoBar
                                            Visibility="{x:Bind ShowPasswordBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            IsOpen="{x:Bind ShowPasswordBanner, Mode=OneWay}"
                                            Severity="Informational"
                                            Message="{x:Bind SavePasswordsNote, Mode=OneWay}"
                                            IsClosable="False">
                                            <CheckBox
                                                Content="{x:Bind SavePasswordsLabel, Mode=OneWay}"
                                                IsChecked="{x:Bind SavePasswords, Mode=TwoWay}"
                                                Margin="0,0,0,8"/>
                                        </commonControls:QuietInfoBar>
                                    </StackPanel>
                                </Border>
                            </ContentControl>

                            <!-- Technical Details panel -->
                            <commonControls:TechnicalDetailsPanel
                                Matrix="{x:Bind TechnicalDetailMatrix, Mode=OneWay}"
                                IsExpanded="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                                IsBarVisible="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay}"
                                HeaderLabel="{x:Bind TechnicalDetailsLabel, Mode=OneWay}"
                                BarCornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                                ToggleCommand="{x:Bind ToggleTechnicalDetailsCommand}"
                                RegeditCommand="{x:Bind OpenRegeditCommand}"/>

                            <!-- Status banner -->
                            <Border Visibility="{x:Bind HasStatusBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,8">
                                <commonControls:QuietInfoBar
                                    IsOpen="{x:Bind HasStatusBanner, Mode=OneWay}"
                                    Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                                    Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                                    IconSource="{x:Bind StatusBannerIconSource, Mode=OneWay}"
                                    IsClosable="False"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="True"
                                    Margin="0,-1,0,0"
                                    CornerRadius="0,0,4,4"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </DataTemplate>

    <!-- ListViewItem container style for settings lists - removes default padding/margins -->
    <Style x:Key="SettingsListViewItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group header template for settings lists -->
    <DataTemplate x:Key="SettingsGroupHeaderTemplate">
        <TextBlock
            Text="{Binding Key}"
            Visibility="{Binding HasVisibleItems, Converter={StaticResource BooleanToVisibilityConverter}}"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
    </DataTemplate>

</ResourceDictionary>
