<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Winhance.UI.Features.Common.Resources.SettingTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Winhance.UI.Features.Optimize.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:commonControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:commonViewModels="using:Winhance.UI.Features.Common.ViewModels"
    xmlns:converters="using:Winhance.UI.Features.Common.Converters"
    xmlns:selectors="using:Winhance.UI.Features.Common.TemplateSelectors"
    xmlns:coreModels="using:Winhance.Core.Features.Common.Models"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:helpers="using:Winhance.UI.Features.Common.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TechnicalDetailsStyles.xaml"/>
        <ResourceDictionary Source="IconSizes.xaml"/>
        <ResourceDictionary Source="LayoutTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Common spacing for settings cards -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <converters:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter"/>

    <converters:BadgePillTemplateSelector x:Key="BadgePillTemplateSelector">

        <converters:BadgePillTemplateSelector.RecommendedTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeRecommendedStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillSpacing}">
                        <fluentIcons:FluentIcon Style="{StaticResource BadgeRecommendedIcon}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.RecommendedTemplate>

        <converters:BadgePillTemplateSelector.DefaultTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeDefaultStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillSpacing}">
                        <fluentIcons:FluentIcon Style="{StaticResource BadgeDefaultIcon}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeDefaultForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.DefaultTemplate>


        <converters:BadgePillTemplateSelector.PreferenceTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgePreferenceStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillSpacing}">
                        <fluentIcons:FluentIcon Style="{StaticResource BadgePreferenceIcon}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgePreferenceForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.PreferenceTemplate>

    </converters:BadgePillTemplateSelector>

    <!-- Common layout values for settings pages -->
    <x:Double x:Key="SettingsContentMaxWidth">1000</x:Double>
    <Thickness x:Key="SettingsContentMargin">24,0,24,0</Thickness>

    <!-- SettingsCard internal spacing overrides for tighter layout -->
    <!-- Reduce padding around the icon area -->
    <Thickness x:Key="SettingsCardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,16,0</Thickness>
    <x:Double x:Key="SettingsCardHeaderIconMaxSize">24</x:Double>
    <Thickness x:Key="SettingsExpanderItemPadding">16,12,16,12</Thickness>
    <Thickness x:Key="SettingsChildCardPadding">54,12,52,12</Thickness>

    <!-- Style for settings section headers -->
    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Style.Setters>
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style.Setters>
    </Style>

    <DataTemplate x:Key="ListTextFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <StackPanel Spacing="{StaticResource FieldLabelSpacing}">
            <TextBox
                Header="{x:Bind Label}"
                Text="{x:Bind Text, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Label}"/>
            <TextBlock
                x:Name="ListFieldError"
                x:Load="{x:Bind HasError, Mode=OneWay}"
                Text="{x:Bind Error}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>

    <!-- A script box: takes newlines, wraps, opens several lines high and reads in the code panels' font. -->
    <DataTemplate x:Key="ListMultiLineTextFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <TextBox
            Header="{x:Bind Label}"
            Text="{x:Bind Text, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            FontFamily="Consolas,Cascadia Code,Courier New"
            MinHeight="160"
            MaxHeight="420"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="{x:Bind Label}"/>
    </DataTemplate>

    <DataTemplate x:Key="ListPasswordFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <PasswordBox
            Header="{x:Bind Label}"
            Password="{x:Bind Text, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Label}"/>
    </DataTemplate>

    <!-- SelectedIndex, not SelectedValue: WinUI cannot match a SelectedValue that is an app value
         (microsoft-ui-xaml #5922), so the closed box would stay blank until the user picks. -->
    <DataTemplate x:Key="ListSelectionFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <ComboBox
            Header="{x:Bind Label}"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind Options}"
            SelectedIndex="{x:Bind OptionIndex, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Label}"/>
    </DataTemplate>

    <DataTemplate x:Key="ListCheckBoxFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <CheckBox
            Content="{x:Bind Label}"
            IsChecked="{x:Bind Checked, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Tooltip}"/>
    </DataTemplate>

    <DataTemplate x:Key="ListFileFieldTemplate" x:DataType="commonViewModels:ListFieldViewModel">
        <TextBox
            Header="{x:Bind Label}"
            Text="{x:Bind Text, Mode=OneWay}"
            IsReadOnly="True"
            AutomationProperties.Name="{x:Bind Label}"/>
    </DataTemplate>

    <selectors:ListFieldTemplateSelector
        x:Key="ListFieldTemplateSelector"
        TextTemplate="{StaticResource ListTextFieldTemplate}"
        MultiLineTextTemplate="{StaticResource ListMultiLineTextFieldTemplate}"
        PasswordTemplate="{StaticResource ListPasswordFieldTemplate}"
        SelectionTemplate="{StaticResource ListSelectionFieldTemplate}"
        CheckBoxTemplate="{StaticResource ListCheckBoxFieldTemplate}"
        FileTemplate="{StaticResource ListFileFieldTemplate}"/>

    <DataTemplate x:Key="ListRowTemplate" x:DataType="commonViewModels:ListRowViewModel">
        <controls:SettingsCard
            IsTabStop="False"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch"
            MinHeight="0">
            <StackPanel Spacing="{StaticResource ItemStackSpacing}">
                <!-- Bounded: the fields the catalog declares for one row -->
                <ItemsControl
                    ItemsSource="{x:Bind Fields}"
                    ItemTemplateSelector="{StaticResource ListFieldTemplateSelector}"
                    HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource ItemStackSpacing}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button
                    Content="{x:Bind RemoveLabel}"
                    Click="{x:Bind Remove}"
                    IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                    HorizontalAlignment="Right"/>
            </StackPanel>
        </controls:SettingsCard>
    </DataTemplate>

    <!-- One DNS server per line, its boxes side by side the way Windows Settings stacks them: address, encryption,
         template, fallback. -->
    <DataTemplate x:Key="FieldRowTemplate" x:DataType="commonViewModels:ListRowViewModel">
        <!-- Bounded: the fields the catalog declares for one row -->
        <ItemsControl
            ItemsSource="{x:Bind Fields}"
            ItemTemplateSelector="{StaticResource ListFieldTemplateSelector}"
            IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGroupSpacing}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Width" Value="220"/>
                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </DataTemplate>

    <!-- IsThreeState stays false: a click can only hand back true or false, and a parent with mixed children
         still renders indeterminate from the IncludeState getter alone. -->
    <DataTemplate x:Key="IncludeBoxTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{StaticResource IconLabelSpacing}">
            <CheckBox
                IsChecked="{x:Bind IncludeState, Mode=TwoWay}"
                IsThreeState="False"
                AutomationProperties.Name="{x:Bind IncludeAutomationName, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind IncludeToolTip, Mode=OneWay}"
                MinWidth="0"
                Padding="0"
                VerticalAlignment="Center"/>
            <fluentIcons:FluentIcon Icon="{x:Bind IncludeIcon, Mode=OneWay}" IconVariant="Regular" FontSize="{StaticResource CardIconFontSize}"
                                    Width="16" Height="16" VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- QuietInfoBar keeps Narrator from reading each banner aloud when a page opens. -->
    <Style x:Key="SettingCardBannerStyle" TargetType="commonControls:QuietInfoBar">
        <Setter Property="IsOpen" Value="True"/>
        <Setter Property="IsClosable" Value="False"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- A state banner hangs under its card, sharing the card's bottom edge. -->
    <Style x:Key="JoinedSettingCardBannerStyle" TargetType="commonControls:QuietInfoBar" BasedOn="{StaticResource SettingCardBannerStyle}">
        <Setter Property="Margin" Value="{StaticResource JoinedCardMargin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource JoinedCardCornerRadius}"/>
    </Style>

    <DataTemplate x:Key="SettingCardBannersTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Margin="{StaticResource BannerBottomMargin}">
            <commonControls:QuietInfoBar
                x:Name="StatusBanner"
                x:Load="{x:Bind HasStatusBanner, Mode=OneWay}"
                Style="{StaticResource JoinedSettingCardBannerStyle}"
                Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                IconSource="{x:Bind StatusBannerIconSource, Mode=OneWay}"/>
            <commonControls:QuietInfoBar
                x:Name="WallpaperExportBanner"
                x:Load="{x:Bind ShowWallpaperExportBanner, Mode=OneWay}"
                Style="{StaticResource JoinedSettingCardBannerStyle}"
                Severity="Informational"
                Message="{x:Bind WallpaperExportNote, Mode=OneWay}"/>
            <!-- Ask before a config writes this setting. A change nobody can answer keeps Apply off. -->
            <commonControls:QuietInfoBar
                x:Name="ReviewDiffBanner"
                x:Load="{x:Bind HasReviewDiff, Mode=OneWay}"
                Style="{StaticResource JoinedSettingCardBannerStyle}"
                Severity="Warning">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,8,4">
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind ReviewDiffMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>
                        <RadioButton
                            Grid.Column="1"
                            Content="{x:Bind ReviewApplyLabel, Mode=OneWay}"
                            GroupName="{x:Bind SettingId}"
                            IsChecked="{x:Bind IsReviewApproved, Mode=TwoWay}"
                            Margin="{StaticResource ReviewChoiceMargin}"
                            MinWidth="0"
                            VerticalAlignment="Center"/>
                        <RadioButton
                            Grid.Column="2"
                            Content="{x:Bind ReviewDontApplyLabel, Mode=OneWay}"
                            GroupName="{x:Bind SettingId}"
                            IsChecked="{x:Bind IsReviewRejected, Mode=TwoWay}"
                            Margin="{StaticResource ReviewChoiceMargin}"
                            MinWidth="0"
                            VerticalAlignment="Center"/>
                    </Grid>
            </commonControls:QuietInfoBar>
            <!-- An action setting such as the wallpaper, asked separately from its diff -->
            <commonControls:QuietInfoBar
                x:Name="ReviewActionBanner"
                x:Load="{x:Bind HasReviewAction, Mode=OneWay}"
                Style="{StaticResource JoinedSettingCardBannerStyle}"
                Severity="Warning">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,8,4">
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind ReviewActionMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>
                        <RadioButton
                            Grid.Column="1"
                            Content="{x:Bind ReviewApplyLabel, Mode=OneWay}"
                            GroupName="{x:Bind ReviewActionGroupName}"
                            IsChecked="{x:Bind IsReviewActionApproved, Mode=TwoWay}"
                            Margin="{StaticResource ReviewChoiceMargin}"
                            MinWidth="0"
                            VerticalAlignment="Center"/>
                        <RadioButton
                            Grid.Column="2"
                            Content="{x:Bind ReviewDontApplyLabel, Mode=OneWay}"
                            GroupName="{x:Bind ReviewActionGroupName}"
                            IsChecked="{x:Bind IsReviewActionRejected, Mode=TwoWay}"
                            Margin="{StaticResource ReviewChoiceMargin}"
                            MinWidth="0"
                            VerticalAlignment="Center"/>
                    </Grid>
            </commonControls:QuietInfoBar>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SettingItemTemplate" x:DataType="viewModels:SettingItemViewModel">
        <!-- Collapsed, not unloaded, when filtered out: x:Load here made every search keystroke tear down and
             rebuild dozens of cards in one pass, which crashed XAML. The bottom margin is the gap between cards,
             since ItemsStackPanel has no Spacing. -->
        <Grid>
            <StackPanel x:Name="CardBody"
                        Visibility="{x:Bind EffectiveIsVisible, Mode=OneWay}"
                        Margin="{StaticResource CardBodyMargin}">
                <!-- IsIncluded is true outside authoring, so the card is disabled only while authoring leaves it out. -->
                <Grid>
                    <controls:SettingsCard
                        IsTabStop="False"
                        IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind DisabledReason, Mode=OneWay}"
                        AutomationProperties.LocalizedControlType="setting"
                        AutomationProperties.AutomationId="{x:Bind SettingId}"
                        HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                        Padding="{x:Bind CardPadding, Mode=OneWay}">
                        <controls:SettingsCard.Description>
                            <commonControls:SettingDescriptionWithBadges x:Phase="1"
                                DescriptionText="{x:Bind Description}"
                                Link="{x:Bind GroupPolicyLink, Mode=OneWay}"
                                BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderTagSpacing}">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                <Border
                                    x:Name="NewBadge"
                                    x:Load="{x:Bind ShowNewBadge, Mode=OneWay}"
                                    Style="{StaticResource NewBadgeBorderStyle}">
                                    <TextBlock
                                        Text="{x:Bind NewBadgeText}"
                                        Style="{StaticResource NewBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                            IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                    </controls:SettingsCard>

                    <!-- Applying overlay with spinner -->
                    <Border
                        x:Name="ApplyingOverlay"
                        x:Load="{x:Bind IsApplying, Mode=OneWay}"
                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                    </Border>


                    <!-- A sibling of the card, not a child, so the box stays live while the card is disabled. -->
                    <ContentControl
                        Content="{x:Bind}"
                        ContentTemplate="{StaticResource IncludeBoxTemplate}"
                        x:Name="IncludeBox"
                        x:Load="{x:Bind ShowIncludeCheckbox, Mode=OneWay}"
                        IsTabStop="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="{StaticResource IncludeBoxMargin}"/>
                </Grid>

                <ContentControl
                    x:Name="RowsCard"
                    x:Load="{x:Bind HasRows, Mode=OneWay}"
                    IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard
                        IsTabStop="False"
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        BorderThickness="1,0,1,1"
                        CornerRadius="{StaticResource JoinedCardCornerRadius}"
                        Margin="{StaticResource JoinedCardMargin}"
                        MinHeight="0"
                        Padding="{x:Bind RowPadding, Mode=OneWay}">
                        <StackPanel Spacing="{StaticResource ItemStackSpacing}">
                            <!-- Nested: a SettingsListView item, the setting's card -->
                            <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ListRowTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{StaticResource ItemStackSpacing}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <commonControls:QuietInfoBar
                                x:Name="PasswordBanner"
                                x:Load="{x:Bind ShowPasswordBanner, Mode=OneWay}"
                                Style="{StaticResource SettingCardBannerStyle}"
                                Severity="Informational"
                                Message="{x:Bind SavePasswordsNote, Mode=OneWay}">
                                <CheckBox
                                    Content="{x:Bind SavePasswordsLabel, Mode=OneWay}"
                                    IsChecked="{x:Bind SavePasswords, Mode=TwoWay}"
                                    Margin="{StaticResource BlockBottomMargin}"/>
                            </commonControls:QuietInfoBar>
                        </StackPanel>
                    </controls:SettingsCard>
                </ContentControl>

                <!-- The fields hang under the card like the List rows: greyed until the pencil, then Apply writes them
                     together. -->
                <ContentControl
                    x:Name="FieldsCard"
                    x:Load="{x:Bind HasFields, Mode=OneWay}"
                    IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard
                        IsTabStop="False"
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        BorderThickness="1,0,1,1"
                        CornerRadius="{StaticResource JoinedCardCornerRadius}"
                        Margin="{StaticResource JoinedCardMargin}"
                        MinHeight="0"
                        Padding="{x:Bind RowPadding, Mode=OneWay}">
                        <StackPanel Spacing="{StaticResource GroupStackSpacing}">
                            <!-- Bounded: the field rows the catalog declares for the setting -->
                            <ItemsControl
                                ItemsSource="{x:Bind FieldRows, Mode=OneWay}"
                                ItemTemplate="{StaticResource FieldRowTemplate}"
                                IsEnabled="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{StaticResource ItemStackSpacing}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock
                                x:Name="FieldsError"
                                x:Load="{x:Bind ShowFieldsError, Mode=OneWay}"
                                Text="{x:Bind FieldsErrorText}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"/>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{StaticResource ControlRowSpacing}"
                                HorizontalAlignment="Right"
                                x:Name="FieldButtons"
                                x:Load="{x:Bind ShowFieldButtons, Mode=OneWay}">
                                <Button
                                    Content="{x:Bind ApplyFieldsText}"
                                    Command="{x:Bind ApplyFieldsCommand}"
                                    IsEnabled="{x:Bind CanApplyFields, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"/>
                                <Button
                                    Content="{x:Bind CancelFieldsText}"
                                    Command="{x:Bind CancelFieldsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>
                </ContentControl>

                <!-- Technical Details panel -->
                <commonControls:TechnicalDetailsPanel
                    x:Name="TechnicalDetails"
                    x:Load="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay}"
                    Matrix="{x:Bind TechnicalDetailMatrix, Mode=OneWay}"
                    IsExpanded="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                    HeaderLabel="{x:Bind TechnicalDetailsLabel, Mode=OneWay}"
                    BarCornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                    ToggleCommand="{x:Bind ToggleTechnicalDetailsCommand}"
                    RegeditCommand="{x:Bind OpenRegeditCommand}"/>

                <ContentControl
                    x:Name="CardBanners"
                    x:Load="{x:Bind ShowsCardBanners(HasStatusBanner, HasReviewBanners, ShowWallpaperExportBanner), Mode=OneWay}"
                    Content="{x:Bind}"
                    ContentTemplate="{StaticResource SettingCardBannersTemplate}"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch"/>


            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SettingExpanderItemTemplate" x:DataType="viewModels:SettingItemViewModel">
        <Grid>
            <StackPanel x:Name="CardBody"
                        Visibility="{x:Bind EffectiveIsVisible, Mode=OneWay}"
                        Margin="{StaticResource CardBodyMargin}">
                <!-- Parent setting card with expand/collapse chevron -->
                <Grid>
                    <!-- IsEnabled is bound on the inner SettingsCardItem (the actual input
                         control) rather than the SettingsCard root. The card itself stays
                         interactive so its click-to-expand handler keeps working in Review
                         Mode and while authoring leaves it out, which keeps its children
                         reachable; only the toggle/dropdown inside dims out.
                         While a child is on screen the card is a tab stop so keyboard users can press
                         Enter/Space to expand (ClickableSettingsCard raises Invoked on those keys,
                         as it does for a click and for Narrator). With every child hidden it is a plain card.
                         AutomationProperties.Name is what Narrator announces when the card is focused. -->
                    <commonControls:ClickableSettingsCard
                        Invoked="{x:Bind ToggleExpander}"
                        IsClickEnabled="{x:Bind HasVisibleChildren, Mode=OneWay}"
                        IsTabStop="{x:Bind HasVisibleChildren, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind DisabledReason, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Name}"
                        AutomationProperties.LocalizedControlType="setting"
                        AutomationProperties.AutomationId="{x:Bind SettingId}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{x:Bind ParentCornerRadius, Mode=OneWay}"
                        Padding="{x:Bind CardPadding, Mode=OneWay}"
                        ShowsActionIcon="False">

                        <!-- This card stays enabled so it can expand, and only the toolkit's disabled state dims a HeaderIcon;
                             an IconSourceElement can bind Opacity. -->
                        <commonControls:ClickableSettingsCard.HeaderIcon>
                            <IconSourceElement x:Phase="1"
                                IconSource="{x:Bind Converter={StaticResource IconConverter}}"
                                Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"/>
                        </commonControls:ClickableSettingsCard.HeaderIcon>

                        <commonControls:ClickableSettingsCard.Description>
                            <commonControls:SettingDescriptionWithBadges x:Phase="1"
                                Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"
                                DescriptionText="{x:Bind Description}"
                                Link="{x:Bind GroupPolicyLink, Mode=OneWay}"
                                BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                        </commonControls:ClickableSettingsCard.Description>

                        <commonControls:ClickableSettingsCard.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderTagSpacing}"
                                        Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                <Border
                                    x:Name="NewBadge"
                                    x:Load="{x:Bind ShowNewBadge, Mode=OneWay}"
                                    Style="{StaticResource NewBadgeBorderStyle}">
                                    <TextBlock
                                        Text="{x:Bind NewBadgeText}"
                                        Style="{StaticResource NewBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>
                        </commonControls:ClickableSettingsCard.Header>

                        <!-- Parent's input control + expand/collapse chevron -->
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                                IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                            <fluentIcons:FluentIcon x:Name="ExpanderChevron"
                                                    x:Load="{x:Bind HasVisibleChildren, Mode=OneWay}"
                                                    Width="20" Height="20"
                                                    Icon="{x:Bind helpers:ExpandChevron.For(IsExpanderExpanded), Mode=OneWay}"
                                                    IconVariant="Regular"
                                                    FontSize="{StaticResource CardExpanderChevronFontSize}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                    </commonControls:ClickableSettingsCard>

                    <!-- Applying overlay with spinner -->
                    <Border
                        x:Name="ApplyingOverlay"
                        x:Load="{x:Bind IsApplying, Mode=OneWay}"
                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                    </Border>


                    <ContentControl
                        Content="{x:Bind}"
                        ContentTemplate="{StaticResource IncludeBoxTemplate}"
                        x:Name="IncludeBox"
                        x:Load="{x:Bind ShowIncludeCheckbox, Mode=OneWay}"
                        IsTabStop="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="{StaticResource IncludeBoxMargin}"/>
                </Grid>

                <!-- Technical Details panel -->
                <commonControls:TechnicalDetailsPanel
                    x:Name="TechnicalDetails"
                    x:Load="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay}"
                    Matrix="{x:Bind TechnicalDetailMatrix, Mode=OneWay}"
                    IsExpanded="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                    HeaderLabel="{x:Bind TechnicalDetailsLabel, Mode=OneWay}"
                    BarCornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                    ToggleCommand="{x:Bind ToggleTechnicalDetailsCommand}"
                    RegeditCommand="{x:Bind OpenRegeditCommand}"/>

                <ContentControl
                    x:Name="CardBanners"
                    x:Load="{x:Bind ShowsCardBanners(HasStatusBanner, HasReviewBanners, ShowWallpaperExportBanner), Mode=OneWay}"
                    Content="{x:Bind}"
                    ContentTemplate="{StaticResource SettingCardBannersTemplate}"
                    IsTabStop="False"
                    HorizontalContentAlignment="Stretch"/>



                <!-- Children rendered below the expander with full template support (tech details, banners) -->
                <!-- Bounded: the child settings the catalog declares under this parent -->
                <ItemsControl ItemsSource="{x:Bind Children}"
                              x:Name="ChildCards"
                              x:Load="{x:Bind IsExpanderExpanded, Mode=OneWay}"
                              IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SettingItemViewModel">
                            <StackPanel Visibility="{x:Bind EffectiveIsVisible, Mode=OneWay}">
                                <Grid>
                                    <!-- MinHeight is a local attribute: the toolkit's 68 comes from a Style setter no
                                         per-card resource can reach. -->
                                    <controls:SettingsCard
                                        IsTabStop="False"
                                        IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind DisabledReason, Mode=OneWay}"
                                        AutomationProperties.LocalizedControlType="setting"
                                        AutomationProperties.AutomationId="{x:Bind SettingId}"
                                        HeaderIcon="{x:Bind ChildHeaderIcon, Mode=OneWay}"
                                        CornerRadius="{x:Bind ChildCornerRadius, Mode=OneWay}"
                                        BorderThickness="1,0,1,1"
                                        MinHeight="{x:Bind ChildMinHeight, Mode=OneWay}"
                                        ContentAlignment="{x:Bind ChildContentAlignment, Mode=OneWay}"
                                        HorizontalContentAlignment="{x:Bind ChildContentHorizontalAlignment, Mode=OneWay}"
                                        Padding="{x:Bind ChildCardPadding, Mode=OneWay}">
                                        <controls:SettingsCard.Description>
                                            <Grid>
                                                <commonControls:SettingDescriptionWithBadges
                                                    x:Name="ChildDescription"
                                                    x:Load="{x:Bind ShowsChildDescription}"
                                                    DescriptionText="{x:Bind ChildDescriptionText, Mode=OneWay}"
                                                    Link="{x:Bind GroupPolicyLink, Mode=OneWay}"
                                                    BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                                    ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                                            </Grid>
                                        </controls:SettingsCard.Description>
                                        <controls:SettingsCard.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderTagSpacing}">
                                                <TextBlock Text="{x:Bind ChildHeader}" VerticalAlignment="Center"/>
                                                <Border
                                                    x:Name="ChildNewBadge"
                                                    x:Load="{x:Bind ShowNewBadge, Mode=OneWay}"
                                                    Style="{StaticResource NewBadgeBorderStyle}">
                                                    <TextBlock
                                                        Text="{x:Bind NewBadgeText}"
                                                        Style="{StaticResource NewBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                        </controls:SettingsCard.Header>
                                        <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                                            IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                                    </controls:SettingsCard>

                                    <!-- Applying overlay -->
                                    <Border
                                        x:Name="ChildApplyingOverlay"
                                        x:Load="{x:Bind IsApplying, Mode=OneWay}"
                                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource CardCornerRadius}">
                                        <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                                    </Border>

                                    <ContentControl
                                        Content="{x:Bind}"
                                        ContentTemplate="{StaticResource IncludeBoxTemplate}"
                                        x:Name="ChildIncludeBox"
                                        x:Load="{x:Bind ShowIncludeCheckbox, Mode=OneWay}"
                                        IsTabStop="False"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="54,0,0,0"/>
                                </Grid>

                                <controls:SettingsCard
                                    x:Name="ChildTilesCard"
                                    x:Load="{x:Bind ShowsOptionTiles}"
                                    IsTabStop="False"
                                    IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                                    AutomationProperties.LocalizedControlType="setting"
                                    CornerRadius="{x:Bind BrowseRowCornerRadius, Mode=OneWay}"
                                    BorderThickness="1,0,1,1"
                                    MinHeight="{x:Bind ChildMinHeight, Mode=OneWay}"
                                    Padding="{x:Bind ChildCardPadding, Mode=OneWay}">
                                    <controls:SettingsCard.Header>
                                        <TextBlock Text="{x:Bind BrowseRowHeader}" VerticalAlignment="Center"/>
                                    </controls:SettingsCard.Header>
                                    <commonControls:SettingTileSelection Setting="{x:Bind}" Part="Browse"
                                        IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"/>
                                </controls:SettingsCard>

                                <ContentControl
                                    x:Name="ChildRowsCard"
                                    x:Load="{x:Bind HasRows, Mode=OneWay}"
                                    IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                    IsTabStop="False"
                                    HorizontalContentAlignment="Stretch">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="{StaticResource JoinedCardCornerRadius}"
                                        Margin="{StaticResource JoinedCardMargin}"
                                        Padding="54,8,52,12">
                                        <StackPanel Spacing="{StaticResource ItemStackSpacing}">
                                            <!-- Nested: a SettingsListView item, the parent setting's card -->
                                            <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ListRowTemplate}" IsTabStop="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="{StaticResource ItemStackSpacing}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <commonControls:QuietInfoBar
                                                x:Name="ChildPasswordBanner"
                                                x:Load="{x:Bind ShowPasswordBanner, Mode=OneWay}"
                                                Style="{StaticResource SettingCardBannerStyle}"
                                                Severity="Informational"
                                                Message="{x:Bind SavePasswordsNote, Mode=OneWay}">
                                                <CheckBox
                                                    Content="{x:Bind SavePasswordsLabel, Mode=OneWay}"
                                                    IsChecked="{x:Bind SavePasswords, Mode=TwoWay}"
                                                    Margin="{StaticResource BlockBottomMargin}"/>
                                            </commonControls:QuietInfoBar>
                                        </StackPanel>
                                    </Border>
                                </ContentControl>

                                <!-- Technical Details panel -->
                                <commonControls:TechnicalDetailsPanel
                                    x:Name="ChildTechnicalDetails"
                                    x:Load="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay}"
                                    Matrix="{x:Bind TechnicalDetailMatrix, Mode=OneWay}"
                                    IsExpanded="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                                    HeaderLabel="{x:Bind TechnicalDetailsLabel, Mode=OneWay}"
                                    BarCornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                                    ToggleCommand="{x:Bind ToggleTechnicalDetailsCommand}"
                                    RegeditCommand="{x:Bind OpenRegeditCommand}"/>

                                <ContentControl
                                    x:Name="ChildCardBanners"
                                    x:Load="{x:Bind ShowsCardBanners(HasStatusBanner, HasReviewBanners, ShowWallpaperExportBanner), Mode=OneWay}"
                                    Content="{x:Bind}"
                                    ContentTemplate="{StaticResource SettingCardBannersTemplate}"
                                    IsTabStop="False"
                                    HorizontalContentAlignment="Stretch"/>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ListViewItem container style for settings lists - removes default padding/margins -->
    <Style x:Key="SettingsListViewItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="{StaticResource SettingsContentMargin}"/>
        <Setter Property="MaxWidth" Value="{StaticResource SettingsContentMaxWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default header container adds padding, a 44px minimum and a divider line under every group. -->
    <Style x:Key="SettingsListViewHeaderItemContainerStyle" TargetType="ListViewHeaderItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="{StaticResource SettingsContentMargin}"/>
        <Setter Property="MaxWidth" Value="{StaticResource SettingsContentMaxWidth}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewHeaderItem">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group header template for settings lists -->
    <DataTemplate x:Key="SettingsGroupHeaderTemplate" x:DataType="viewModels:SettingsGroup">
        <TextBlock
            Text="{x:Bind Key}"
            Visibility="{x:Bind HasVisibleItems, Mode=OneWay}"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
    </DataTemplate>

</ResourceDictionary>
