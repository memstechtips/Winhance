<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Each key names a FluentIcons.Common.Icon member. -->

    <x:String x:Key="SoftwareAppsIconSymbol">Apps</x:String>
    <x:String x:Key="OptimizeIconSymbol">Gauge</x:String>
    <x:String x:Key="CustomizeIconSymbol">DesignIdeas</x:String>

    <!-- Has to match the glyph the Unattend nav button draws -->
    <x:String x:Key="AutounattendIconSymbol">TextBulletListSquareSparkle</x:String>

    <!-- Optimize Section Icons -->
    <x:String x:Key="PrivacyIconSymbol">LockClosed</x:String>
    <x:String x:Key="PowerIconSymbol">Power</x:String>
    <x:String x:Key="GamingIconSymbol">Games</x:String>
    <x:String x:Key="NotificationIconSymbol">AlertOn</x:String>
    <x:String x:Key="UpdateIconSymbol">ArrowSync</x:String>
    <x:String x:Key="SoundIconSymbol">Speaker2</x:String>

    <!-- Customize Section Icons -->
    <x:String x:Key="WindowsThemeIconSymbol">PaintBrush</x:String>
    <x:String x:Key="TaskbarIconSymbol">PanelBottom</x:String>
    <x:String x:Key="StartMenuIconSymbol">TableSimple</x:String>
    <x:String x:Key="TimeRegionLanguageIconSymbol">GlobeSearch</x:String>
    <x:String x:Key="ContextMenuIconSymbol">CursorClick</x:String>
    <x:String x:Key="ExplorerIconSymbol">Folder</x:String>

    <!-- Software & Apps Icons. The External Apps tab draws the same glyph. -->
    <x:String x:Key="ExternalAppsIconSymbol">ArrowDownload</x:String>

</ResourceDictionary>
