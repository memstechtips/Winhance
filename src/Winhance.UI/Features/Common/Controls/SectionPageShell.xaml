<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SectionPageShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Winhance.UI.Features.Common.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:winControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:vm="using:Winhance.UI.Features.Common.ViewModels"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:helpers="using:Winhance.UI.Features.Common.Helpers"
    x:DefaultBindMode="OneWay">

    <Grid Padding="0,0,12,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowHeightStates">
                <VisualState x:Name="TallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="{StaticResource ShortWindowHeight}"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ShortState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavRow.Margin" Value="0,8,0,8"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- NavRow -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header with Icon (title left, search right) -->
        <winControls:PageHeader
            Grid.Row="0"
            Icon="{x:Bind PageIcon}"
            Title="{x:Bind ViewModel.PageTitle}"
            Description="{x:Bind ViewModel.PageDescription}">
            <winControls:PageHeader.Actions>
                <Grid Width="220">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                        helpers:AutoSuggestBoxExtensions.PlaceholderEllipsis="True"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Bind ViewModel.SearchSuggestions}">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchSuggestionItem">
                                <Grid Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind SettingName, Mode=OneTime}" Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind SectionDisplayName, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </winControls:PageHeader.Actions>
        </winControls:PageHeader>

        <!-- Row 1: Navigation Bar -->
        <Grid x:Name="NavRow" Grid.Row="1" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- Breadcrumb -->
                <ColumnDefinition Width="Auto"/>  <!-- Quick Actions -->
                <ColumnDefinition Width="Auto"/>  <!-- View -->
            </Grid.ColumnDefinitions>

            <!-- Breadcrumb navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <!-- Page-root button - navigates back to the overview -->
                <Button
                    x:Name="BreadcrumbRoot"
                    AutomationProperties.Name="{x:Bind ViewModel.BreadcrumbRootText}"
                    Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,0,0">
                            <fluentIcons:FluentIcon Icon="{x:Bind PageIcon}" IconVariant="Color" />
                        </Viewbox>
                        <TextBlock Text="{x:Bind ViewModel.BreadcrumbRootText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Separator (visible only on detail pages) -->
                <fluentIcons:FluentIcon
                    x:Name="BreadcrumbSeparator"
                    Icon="ChevronRight"
                    IconVariant="Regular"
                    FontSize="{StaticResource BreadcrumbSeparatorFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"/>

                <!-- Current section dropdown with icon (visible only on detail pages) -->
                <DropDownButton
                    x:Name="BreadcrumbSection"
                    Visibility="Collapsed"
                    Padding="8,4">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,0,0">
                                <ContentControl Content="{x:Bind ViewModel.CurrentSectionItem.IconResourceKey, Mode=OneWay, Converter={StaticResource SectionIconConverter}}"/>
                            </Viewbox>
                            <TextBlock x:Name="BreadcrumbSectionText" VerticalAlignment="Center"/>
                            <InfoBadge VerticalAlignment="Center" Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                       Visibility="{x:Bind ViewModel.CurrentSectionItem.IsReviewSuccessBadgeVisible, Mode=OneWay}"/>
                            <InfoBadge VerticalAlignment="Center" Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                       Value="{x:Bind ViewModel.CurrentSectionItem.ReviewPendingCount, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.CurrentSectionItem.IsReviewPendingBadgeVisible, Mode=OneWay}"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="BreadcrumbFlyout" Placement="BottomEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.OverviewItems}" MinWidth="180">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SectionOverviewItemViewModel">
                                        <Button Click="SectionFlyoutItem_Click" Tag="{x:Bind SectionKey, Mode=OneTime}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderThickness="0" Padding="8,5">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <ContentControl Content="{x:Bind IconResourceKey, Mode=OneTime, Converter={StaticResource SectionIconConverter}}"/>
                                                </Viewbox>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Text="{x:Bind Feature.DisplayName, Mode=OneWay}"/>
                                                <InfoBadge Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                                           Visibility="{x:Bind IsReviewSuccessBadgeVisible, Mode=OneWay}"/>
                                                <InfoBadge Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                                           Value="{x:Bind ReviewPendingCount, Mode=OneWay}"
                                                           Visibility="{x:Bind IsReviewPendingBadgeVisible, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Quick Actions dropdown -->
            <DropDownButton x:Name="QuickActionsButton" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                        <TextBlock x:Name="QuickActionsLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="ApplyRecommendedItem">
                            <MenuFlyoutItem.Icon>
                                <FontIcon x:Name="ApplyRecommendedIcon" Glyph="&#xE735;" FontSize="14"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ResetDefaultsItem">
                            <MenuFlyoutItem.Icon>
                                <PathIcon x:Name="ResetDefaultsIcon" Data="{StaticResource WindowsLogoIconPath}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="IncludeActionsSeparator" Visibility="Collapsed"/>
                        <MenuFlyoutItem x:Name="IncludeAllItem" Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExcludeAllItem" Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- View dropdown -->
            <DropDownButton x:Name="ViewMenuButton" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,0">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                        <TextBlock x:Name="ViewMenuLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <ToggleMenuFlyoutItem x:Name="TechnicalDetailsToggleItem">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="InfoBadgesToggleItem">
                            <ToggleMenuFlyoutItem.Icon>
                                <PathIcon Data="{StaticResource BookInformationVariantIconPath}"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="NewBadgesToggleItem">
                            <ToggleMenuFlyoutItem.Icon>
                                <PathIcon Data="{StaticResource NewBoxIconPath}"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="StateFilterSeparator"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterAllItem"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterRecommendedItem"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterWindowsDefaultItem"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterCustomItem"/>
                        <MenuFlyoutSeparator x:Name="ShowOnlyChangesSeparator" Visibility="Collapsed"/>
                        <ToggleMenuFlyoutItem x:Name="ShowOnlyChangesToggleItem" Visibility="Collapsed">
                            <ToggleMenuFlyoutItem.Icon>
                                <PathIcon Data="{StaticResource CogTransferIconPath}"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

        </Grid>

        <!-- Row 2: Content Container with rounded corners and lighter background -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
            CornerRadius="8"
            Margin="0,0,0,12">
            <Grid>
                <!-- Overview Content (visible when not on detail page) -->
                <Grid x:Name="OverviewContent">
                    <!-- A page with one section sets SectionContent, which is drawn here in place of the cards. -->
                    <ContentPresenter
                        Content="{x:Bind SectionContent}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>

                    <Grid x:Name="OverviewCards">
                    <!-- Loading State -->
                    <winControls:RocketLoader
                        IsActive="{x:Bind ViewModel.IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- Overview Cards -->
                    <ScrollView x:Name="OverviewScrollView" Visibility="{x:Bind ViewModel.IsNotLoading}">
                        <!-- Wrap StackPanel in Grid to avoid visual glitches with MaxWidth -->
                        <Grid>
                        <StackPanel Spacing="8" MaxWidth="{StaticResource SettingsContentMaxWidth}" Margin="{StaticResource SettingsContentMargin}" HorizontalAlignment="Stretch" Padding="0,12,0,12">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.OverviewItems}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SectionOverviewItemViewModel">
                                        <StackPanel Spacing="8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <winControls:ClickableSettingsCard
                                                    Description="{x:Bind Feature.GroupDescriptionText, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind Feature.DisplayName, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="{x:Bind SectionKey}"
                                                    HeaderIcon="{x:Bind IconResourceKey, Mode=OneTime, Converter={StaticResource SectionIconConverter}}"
                                                    Padding="{x:Bind CardPadding, Mode=OneWay}"
                                                    Tag="{x:Bind SectionKey, Mode=OneTime}"
                                                    Invoked="SectionCard_Click">
                                                    <winControls:ClickableSettingsCard.Header>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Feature.DisplayName, Mode=OneWay}" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource NewBadgeBorderStyle}"
                                                                    Visibility="{x:Bind IsNewBadgeVisible, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind NewBadgeText, Mode=OneWay}" Style="{StaticResource NewBadgeTextStyle}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </winControls:ClickableSettingsCard.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <InfoBadge Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                                                   Visibility="{x:Bind IsReviewSuccessBadgeVisible, Mode=OneWay}"/>
                                                        <InfoBadge Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                                                   Value="{x:Bind ReviewPendingCount, Mode=OneWay}"
                                                                   Visibility="{x:Bind IsReviewPendingBadgeVisible, Mode=OneWay}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                                    Visibility="{x:Bind ArePillsVisible, Mode=OneWay}">
                                                            <Border Style="{StaticResource BadgeRecommendedStyle}" Opacity="{x:Bind RecommendedOpacity, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <PathIcon Data="{StaticResource BadgeRecommendedIconPath}" Height="12" Width="12"
                                                                              VerticalAlignment="Center" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                                    <TextBlock Text="{x:Bind RecommendedText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                                                               Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource BadgeDefaultStyle}" Opacity="{x:Bind DefaultOpacity, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                                              VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                                    <TextBlock Text="{x:Bind DefaultText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                                                               Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </winControls:ClickableSettingsCard>
                                                <!-- Declared after the card so it sits above it: a click lands on the box, not on
                                                     the card's navigation. -->
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            Visibility="{x:Bind ShowIncludeBox, Mode=OneWay}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <CheckBox
                                                        IsChecked="{x:Bind IncludeState, Mode=TwoWay}"
                                                        IsThreeState="False"
                                                        AutomationProperties.Name="{x:Bind IncludeAutomationName, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind IncludeToolTip, Mode=OneWay}"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"/>
                                                    <Grid Width="16" Height="16" VerticalAlignment="Center"
                                                          Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}">
                                                        <fluentIcons:FluentIcon Icon="Link" IconVariant="Regular" FontSize="16"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Visibility="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <fluentIcons:FluentIcon Icon="LinkOff" IconVariant="Regular" FontSize="16"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Visibility="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <winControls:FeatureOutcomeBanner SectionKey="{x:Bind SectionKey, Mode=OneTime}"
                                                                        NavigationRequested="OnOutcomeBannerNavigationRequested"
                                                                        Feature="{x:Bind Feature, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Grid>
                    </ScrollView>
                    </Grid>
                </Grid>

                <!-- Detail Page Frame (visible when on detail page) -->
                <Frame
                    x:Name="InnerContentFrame"
                    Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
