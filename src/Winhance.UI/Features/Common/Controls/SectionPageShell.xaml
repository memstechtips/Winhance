<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SectionPageShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Winhance.UI.Features.Common.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:winControls="using:Winhance.UI.Features.Common.Controls"
    xmlns:vm="using:Winhance.UI.Features.Common.ViewModels"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:helpers="using:Winhance.UI.Features.Common.Helpers"
    x:DefaultBindMode="OneWay">

    <Grid Padding="{StaticResource PageRootPadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowHeightStates">
                <VisualState x:Name="TallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="{StaticResource ShortWindowHeight}"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ShortState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavRow.Margin" Value="0,8,0,8"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- NavRow -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header with Icon (title left, search right) -->
        <winControls:PageHeader
            Grid.Row="0"
            Icon="{x:Bind PageIcon}"
            Title="{x:Bind ViewModel.PageTitle}"
            Description="{x:Bind ViewModel.PageDescription}">
            <winControls:PageHeader.Actions>
                <Grid Width="220">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                        helpers:AutoSuggestBoxExtensions.PlaceholderEllipsis="True"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Bind ViewModel.SearchSuggestions}">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchSuggestionItem">
                                <StackPanel Padding="4,2">
                                    <TextBlock Text="{x:Bind SettingName, Mode=OneTime}" Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind SectionDisplayName, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </winControls:PageHeader.Actions>
        </winControls:PageHeader>

        <!-- Row 1: Navigation Bar -->
        <Grid x:Name="NavRow" Grid.Row="1" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- Breadcrumb -->
                <ColumnDefinition Width="Auto"/>  <!-- Active filter -->
                <ColumnDefinition Width="Auto"/>  <!-- Quick Actions -->
                <ColumnDefinition Width="Auto"/>  <!-- View -->
            </Grid.ColumnDefinitions>

            <!-- Breadcrumb navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <!-- Page-root button - navigates back to the overview -->
                <Button
                    x:Name="BreadcrumbRoot"
                    AutomationProperties.Name="{x:Bind ViewModel.BreadcrumbRootText}"
                    Padding="{StaticResource BreadcrumbButtonPadding}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,0,0">
                            <fluentIcons:FluentIcon Icon="{x:Bind PageIcon}" IconVariant="Color" />
                        </Viewbox>
                        <TextBlock Text="{x:Bind ViewModel.BreadcrumbRootText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Separator (built only on detail pages) -->
                <fluentIcons:FluentIcon
                    x:Name="BreadcrumbSeparator"
                    x:Load="{x:Bind ViewModel.IsInDetailPage, Mode=OneWay}"
                    Icon="ChevronRight"
                    IconVariant="Regular"
                    FontSize="{StaticResource BreadcrumbSeparatorFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>

                <!-- Current section dropdown with icon (built only on detail pages) -->
                <winControls:SectionBreadcrumbButton
                    x:Name="BreadcrumbSection"
                    x:Load="{x:Bind ViewModel.IsInDetailPage, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel}"
                    ItemClicked="SectionFlyoutItem_Click"/>
            </StackPanel>

            <!-- The View filter hides cards from a menu the user may not reopen, so its state stays in sight here -->
            <Button x:Name="ActiveStateFilterButton" Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ToolbarButtonMargin}"
                    x:Load="{x:Bind ViewModel.IsStateFilterActive, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ShowAllSettingsCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ClearStateFilterTooltip}"
                    AutomationProperties.Name="{x:Bind ViewModel.ActiveStateFilterText}"
                    AutomationProperties.HelpText="{x:Bind ViewModel.ClearStateFilterTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource CompactIconLabelSpacing}">
                    <fluentIcons:FluentIcon Icon="FilterDismiss" IconVariant="Regular" FontSize="{StaticResource ButtonIconFontSize}"/>
                    <TextBlock Text="{x:Bind ViewModel.ActiveStateFilterText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Quick Actions dropdown -->
            <DropDownButton x:Name="QuickActionsButton" Grid.Column="2" VerticalAlignment="Center" Margin="{StaticResource ToolbarButtonMargin}">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource CompactIconLabelSpacing}">
                        <fluentIcons:FluentIcon Icon="Flash" IconVariant="Regular" FontSize="{StaticResource ButtonIconFontSize}"/>
                        <TextBlock x:Name="QuickActionsLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="ApplyRecommendedItem">
                            <MenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon x:Name="ApplyRecommendedIcon" Icon="Star" IconVariant="Filled" FontSize="{StaticResource ButtonIconFontSize}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ResetDefaultsItem">
                            <MenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="Apps" IconVariant="Regular" FontSize="{StaticResource ButtonIconFontSize}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="IncludeActionsSeparator" Visibility="Collapsed"/>
                        <MenuFlyoutItem x:Name="IncludeAllItem" Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="Checkmark" IconVariant="Regular" FontSize="{StaticResource ButtonIconFontSize}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExcludeAllItem" Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="{StaticResource ButtonIconFontSize}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- View dropdown -->
            <DropDownButton x:Name="ViewMenuButton" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,0,0">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource CompactIconLabelSpacing}">
                        <fluentIcons:FluentIcon Icon="Eye" IconVariant="Regular" FontSize="{StaticResource ButtonIconFontSize}"/>
                        <TextBlock x:Name="ViewMenuLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <ToggleMenuFlyoutItem x:Name="TechnicalDetailsToggleItem">
                            <ToggleMenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="Code" IconVariant="Regular"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="InfoBadgesToggleItem">
                            <ToggleMenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="BookInformation" IconVariant="Regular"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="NewBadgesToggleItem">
                            <ToggleMenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="New" IconVariant="Regular"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="StateFilterSeparator"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterAllItem"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterRecommendedItem"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterWindowsDefaultItem"/>
                        <RadioMenuFlyoutItem x:Name="StateFilterCustomItem"/>
                        <MenuFlyoutSeparator x:Name="ShowOnlyChangesSeparator" Visibility="Collapsed"/>
                        <ToggleMenuFlyoutItem x:Name="ShowOnlyChangesToggleItem" Visibility="Collapsed">
                            <ToggleMenuFlyoutItem.Icon>
                                <fluentIcons:FluentIcon Icon="ArrowSwap" IconVariant="Regular"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

        </Grid>

        <!-- Row 2: Content Container with rounded corners and lighter background -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
            CornerRadius="{StaticResource SectionBandCornerRadius}"
            Margin="0,0,0,12">
            <Grid>
                <!-- Overview Content (built only when not on detail page) -->
                <Grid x:Name="OverviewContent" x:Load="{x:Bind helpers:LoadWhen.Not(ViewModel.IsInDetailPage)}">
                    <!-- A page with one section sets SectionContent, which is drawn here in place of the cards. -->
                    <ContentPresenter
                        Content="{x:Bind SectionContent}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>

                    <Grid x:Name="OverviewCards" x:Load="{x:Bind HasNoSectionContent(SectionContent)}">
                    <!-- Loading State -->
                    <winControls:RocketLoader
                        IsActive="{x:Bind ViewModel.IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- Overview Cards -->
                    <ScrollViewer x:Name="OverviewScrollViewer" Visibility="{x:Bind ViewModel.IsNotLoading}" Loaded="OverviewScrollViewer_Loaded">
                        <!-- Wrap StackPanel in Grid to avoid visual glitches with MaxWidth -->
                        <Grid>
                        <StackPanel Spacing="{StaticResource ItemStackSpacing}" MaxWidth="{StaticResource SettingsContentMaxWidth}" Margin="{StaticResource SettingsContentMargin}" HorizontalAlignment="Stretch" Padding="0,12,0,12">
                            <!-- Bounded: one card per section the page defines -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.OverviewItems}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SectionOverviewItemViewModel">
                                        <StackPanel Spacing="{StaticResource ItemStackSpacing}" Margin="{StaticResource BlockBottomMargin}" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <winControls:ClickableSettingsCard
                                                    Description="{x:Bind Feature.GroupDescriptionText, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind Feature.DisplayName, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="{x:Bind SectionKey}"
                                                    HeaderIcon="{x:Bind IconResourceKey, Mode=OneTime, Converter={StaticResource IconConverter}, ConverterParameter=FeatureIcon}"
                                                    Padding="{x:Bind CardPadding, Mode=OneWay}"
                                                    Tag="{x:Bind SectionKey, Mode=OneTime}"
                                                    Invoked="SectionCard_Click">
                                                    <winControls:ClickableSettingsCard.Header>
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderTagSpacing}">
                                                            <TextBlock Text="{x:Bind Feature.DisplayName, Mode=OneWay}" VerticalAlignment="Center"/>
                                                            <Border x:Name="OverviewNewBadge" Style="{StaticResource NewBadgeBorderStyle}"
                                                                    x:Load="{x:Bind IsNewBadgeVisible, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind NewBadgeText, Mode=OneWay}" Style="{StaticResource NewBadgeTextStyle}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </winControls:ClickableSettingsCard.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BadgeRowSpacing}">
                                                        <InfoBadge x:Name="OverviewReviewedBadge" Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                                                   x:Load="{x:Bind IsReviewSuccessBadgeVisible, Mode=OneWay}"/>
                                                        <InfoBadge x:Name="OverviewPendingBadge" Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                                                   Value="{x:Bind ReviewPendingCount, Mode=OneWay}"
                                                                   x:Load="{x:Bind IsReviewPendingBadgeVisible, Mode=OneWay}"/>
                                                        <StackPanel x:Name="OverviewPills" Orientation="Horizontal" Spacing="{StaticResource PillSpacing}"
                                                                    x:Load="{x:Bind ArePillsVisible, Mode=OneWay}">
                                                            <Border Style="{StaticResource BadgeRecommendedStyle}" Opacity="{x:Bind RecommendedOpacity, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillSpacing}">
                                                                    <fluentIcons:FluentIcon Style="{StaticResource BadgeRecommendedIcon}"/>
                                                                    <TextBlock Text="{x:Bind RecommendedText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                                                               Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource BadgeDefaultStyle}" Opacity="{x:Bind DefaultOpacity, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillSpacing}">
                                                                    <fluentIcons:FluentIcon Style="{StaticResource BadgeDefaultIcon}"/>
                                                                    <TextBlock Text="{x:Bind DefaultText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                                                               Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </winControls:ClickableSettingsCard>
                                                <!-- Declared after the card so it sits above it: a click lands on the box, not on
                                                     the card's navigation. -->
                                                <StackPanel x:Name="OverviewIncludeBox" Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}"
                                                            x:Load="{x:Bind ShowIncludeBox, Mode=OneWay}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{StaticResource IncludeBoxMargin}">
                                                    <CheckBox
                                                        IsChecked="{x:Bind IncludeState, Mode=TwoWay}"
                                                        IsThreeState="False"
                                                        AutomationProperties.Name="{x:Bind IncludeAutomationName, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind IncludeToolTip, Mode=OneWay}"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"/>
                                                    <fluentIcons:FluentIcon Icon="{x:Bind IncludeIcon, Mode=OneWay}" IconVariant="Regular" FontSize="{StaticResource CardIconFontSize}"
                                                                            Width="16" Height="16" VerticalAlignment="Center"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource BoolToDimOpacityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                            <winControls:FeatureOutcomeBanner SectionKey="{x:Bind SectionKey, Mode=OneTime}"
                                                                        NavigationRequested="OnOutcomeBannerNavigationRequested"
                                                                        Feature="{x:Bind Feature, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Empty, so it draws and hit-tests nothing, until a section is navigated into it; the overview is
                     unloaded while it holds one. -->
                <Frame x:Name="InnerContentFrame"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
