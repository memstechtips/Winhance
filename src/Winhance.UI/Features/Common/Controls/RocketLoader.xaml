<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.RocketLoader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="72"
    Height="72"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <!-- The streaks leave from the exhaust and fall away behind the rocket, one after another. -->
        <Storyboard x:Name="FlightStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RocketHover" Storyboard.TargetProperty="X" Duration="0:0:1.2" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="2.5"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RocketHover" Storyboard.TargetProperty="Y" Duration="0:0:1.2" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-2.5"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlameScale" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.8"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlameScale" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1.3"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="Streak1Move" Storyboard.TargetProperty="Y" From="16" To="40" Duration="0:0:0.9" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Streak1" Storyboard.TargetProperty="Opacity" Duration="0:0:0.9" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Streak2Move" Storyboard.TargetProperty="Y" From="16" To="40" Duration="0:0:0.9" BeginTime="0:0:0.3" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Streak2" Storyboard.TargetProperty="Opacity" Duration="0:0:0.9" BeginTime="0:0:0.3" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Streak3Move" Storyboard.TargetProperty="Y" From="16" To="40" Duration="0:0:0.9" BeginTime="0:0:0.6" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Streak3" Storyboard.TargetProperty="Opacity" Duration="0:0:0.9" BeginTime="0:0:0.6" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Turned 45 degrees so "down" here is down-left on screen: straight back along the rocket's flight. -->
        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform Angle="45"/>
            </Grid.RenderTransform>
            <Rectangle x:Name="Streak1" Width="2" Height="12" RadiusX="1" RadiusY="1" Opacity="0"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="Streak1Move" X="-7"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Streak2" Width="2" Height="16" RadiusX="1" RadiusY="1" Opacity="0"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="Streak2Move" X="0"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Streak3" Width="2" Height="12" RadiusX="1" RadiusY="1" Opacity="0"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="Streak3Move" X="7"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Grid Width="48" Height="48">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RocketHover"/>
            </Grid.RenderTransform>
            <!-- The website's download-button flame, sat on the artwork's nozzle. -->
            <Ellipse Width="18" Height="18" Margin="3,27,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="FlameScale"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFD27A" Offset="0"/>
                        <GradientStop Color="#99FF8C32" Offset="0.45"/>
                        <GradientStop Color="#00FF8C32" Offset="0.72"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Vector, traced from winhance-rocket-black-transparent-bg.png: a bitmap waits on the UI thread to decode,
                 so it stays blank for as long as a long page is building. -->
            <Path Fill="{x:Bind Foreground, Mode=OneWay}"
                  Data="F0 M22.83,39.93 L22.45,39.87 L22.17,39.61 L21.62,37.90 L20.93,36.27 L20.06,34.64 L18.99,33.01 L18.97,32.70 L19.09,32.39 L19.88,31.79 L20.37,31.15 L20.61,30.52 L20.66,29.93 L18.72,31.71 L17.01,33.02 L14.52,34.52 L13.98,34.59 L13.56,34.25 L13.41,33.79 L13.95,32.54 L15.83,29.59 L17.81,27.26 L17.24,27.31 L16.70,27.54 L16.06,28.04 L15.53,28.76 L14.99,28.92 L11.73,27.00 L10.10,26.31 L8.31,25.74 L8.00,25.40 L7.98,24.93 L8.78,24.00 L10.02,22.81 L12.74,20.80 L14.21,19.96 L15.92,19.17 L19.11,18.15 L20.80,15.53 L22.70,13.36 L24.93,11.40 L27.57,9.70 L30.14,8.53 L31.84,7.97 L33.55,7.58 L36.66,7.28 L38.60,7.35 L40.00,7.57 L40.33,7.92 L40.57,9.71 L40.58,12.04 L40.41,13.67 L40.10,15.30 L39.57,17.17 L38.94,18.80 L38.17,20.35 L36.53,22.91 L34.65,25.09 L32.31,27.13 L29.71,28.82 L28.77,31.84 L27.92,33.71 L27.22,34.95 L26.28,36.35 L25.11,37.83 L23.77,39.23 L23.15,39.80 L22.83,39.93 Z M22.53,29.75 L24.54,29.39 L26.80,28.69 L29.05,27.68 L30.83,26.59 L32.47,25.34 L34.19,23.69 L35.60,21.98 L36.99,19.81 L37.85,18.02 L38.38,16.62 L38.86,14.91 L39.10,13.51 L34.17,8.82 L32.23,9.21 L30.14,9.92 L28.04,10.93 L26.17,12.10 L24.62,13.33 L22.80,15.15 L21.34,17.01 L20.41,18.49 L19.47,20.43 L18.76,22.37 L18.30,24.23 L18.07,25.86 L19.03,26.04 L21.13,24.37 L23.07,23.12 L24.08,22.59 L24.39,22.59 L24.68,22.76 L24.97,23.22 L24.87,23.84 L23.41,26.41 L21.80,28.58 L21.96,29.75 L22.53,29.75 Z M31.92,14.72 L28.86,14.68 L29.18,13.59 L29.85,12.66 L30.68,12.03 L31.92,11.63 L31.92,14.72 Z M35.81,14.69 L32.74,14.68 L32.78,11.64 L33.94,12.00 L34.84,12.66 L35.53,13.67 L35.81,14.69 Z M31.92,18.60 L30.68,18.21 L29.82,17.55 L29.10,16.47 L28.89,15.50 L31.96,15.53 L31.92,18.60 Z M32.93,18.57 L32.78,18.60 L32.74,18.49 L32.74,15.53 L35.81,15.52 L35.50,16.62 L34.87,17.53 L34.02,18.20 L32.93,18.57 Z M10.17,40.55 L8.00,40.48 L7.50,40.16 L7.34,39.38 L7.35,37.59 L7.83,35.42 L8.75,33.48 L9.45,32.47 L10.25,31.57 L11.11,30.81 L12.35,29.96 L13.44,29.42 L13.98,29.40 L14.24,29.59 L14.37,29.90 L14.21,30.43 L12.58,31.35 L11.45,32.23 L10.32,33.48 L9.55,34.80 L13.28,38.27 L14.45,37.54 L15.69,36.40 L16.57,35.26 L17.30,33.86 L17.55,33.60 L17.94,33.51 L18.25,33.62 L18.50,33.94 L18.52,34.33 L17.81,35.73 L17.11,36.74 L16.03,37.90 L15.07,38.70 L12.97,39.87 L11.50,40.34 L10.17,40.55 Z"/>
        </Grid>
    </Grid>
</UserControl>
