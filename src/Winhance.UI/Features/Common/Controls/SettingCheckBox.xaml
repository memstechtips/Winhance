<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingCheckBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Common.Controls">

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <local:SettingQuickSetButtons
            Setting="{x:Bind Setting, Mode=OneWay}"
            Mode="Single"
            Kind="TwoState"/>

        <!-- AnimatedIcon.State: the check glyph mirrors the nearest ancestor's state and the card moves its own
             on hover, which drew a check into an unticked box. -->
        <Grid VerticalAlignment="Center" AnimatedIcon.State="Normal">
            <!-- MinWidth 0 drops the width the stock style reserves for content; this box has none. -->
            <CheckBox
                IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                Checked="OnChanged"
                Unchecked="OnChanged"
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind SettingName, Mode=OneWay}"
                Opacity="{x:Bind BoxOpacity, Mode=OneWay}"
                IsHitTestVisible="{x:Bind BoxInteractive, Mode=OneWay}"
                IsTabStop="{x:Bind BoxInteractive, Mode=OneWay}"
                AutomationProperties.AccessibilityView="{x:Bind BoxAccessibilityView, Mode=OneWay}"/>

            <local:SettingOutcomeOverlay
                Setting="{x:Bind Setting, Mode=OneWay}"
                Mode="Single"
                IsInteractive="True"
                IsTwoState="True"/>
        </Grid>
    </StackPanel>
</UserControl>
