<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.TechnicalDetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winhance.UI.Features.Common.Controls"
    xmlns:utilities="using:Winhance.UI.Features.Common.Utilities"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:td="using:Winhance.Core.Features.Common.TechnicalDetails"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">


    <StackPanel>
        <!-- Toggle bar, seamlessly attached below the settings card -->
        <Border Visibility="{x:Bind IsBarVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="{x:Bind BarCornerRadius, Mode=OneWay}"
                Margin="0,-1,0,0">
            <Button Command="{x:Bind ToggleCommand, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind HeaderLabel, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <FontIcon Grid.Column="0" Glyph="&#xE946;"
                              FontSize="{StaticResource TechnicalDetailsIconFontSize}" Margin="0,0,6,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind HeaderLabel, Mode=OneWay}" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;"
                              FontSize="{StaticResource TechnicalDetailsChevronFontSize}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE70E;"
                              FontSize="{StaticResource TechnicalDetailsChevronFontSize}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Button>
        </Border>

        <!-- Expanded content -->
        <Border Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,4,4"
                Padding="12,6">
            <controls:OptionMatrixView Matrix="{x:Bind Matrix, Mode=OneWay}"
                                       RegeditCommand="{x:Bind RegeditCommand, Mode=OneWay}"/>
        </Border>
    </StackPanel>
</UserControl>
