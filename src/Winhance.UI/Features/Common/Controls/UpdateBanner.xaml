<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.UpdateBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <InfoBar x:Name="UpdateInfoBar"
             IsOpen="True"
             Title="{x:Bind ViewModel.UpdateInfoBarTitle, Mode=OneWay}"
             Message="{x:Bind ViewModel.UpdateInfoBarMessage, Mode=OneWay}"
             Severity="{x:Bind ViewModel.UpdateInfoBarSeverity, Mode=OneWay}"
             IsClosable="True"
             Closed="UpdateInfoBar_Closed"/>
</UserControl>
