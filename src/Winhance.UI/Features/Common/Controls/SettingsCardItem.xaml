<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingsCardItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Winhance.UI.Features.Optimize.ViewModels"
    xmlns:selectors="using:Winhance.UI.Features.Common.TemplateSelectors"
    xmlns:interfaces="using:Winhance.Core.Features.Common.Interfaces"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:local="using:Winhance.UI.Features.Common.Controls">

    <!--
    This UserControl handles selecting and displaying the appropriate input control
    based on the Setting's InputType. It should be placed INSIDE a SettingsCard,
    not used as a standalone item in SettingsExpander.ItemTemplate.

    Every control type (except Action / CheckBox / PowerPlan) is preceded by a pair
    of Quick-Set buttons: a green "Set to Recommended" and a grey "Set to Default"
    side-by-side. Visibility is driven by per-type ShowXQuickSetButtons flags on the
    ViewModel. The icons inside the buttons carry their own Foreground brush so the
    default Button.ContentPresenter ButtonForegroundPointerOver override does not
    wipe out the green/grey on hover — only the background hover tint renders.
    -->

    <UserControl.Resources>
        <!-- ComboBoxEx needs explicit style inheritance to maintain rounded corners -->
        <Style TargetType="local:ComboBoxEx" BasedOn="{StaticResource DefaultComboBoxStyle}"/>

        <!-- Template for Toggle settings -->
        <!-- WHEN A CONTROL GETS ITS OWN UserControl, AND WHEN IT STAYS INLINE
             (the rule, so the mix below reads as a decision rather than as drift)

             Extract to a shared control when EITHER is true:
               1. The same control is declared more than once. Selection and Numeric each had four
                  declarations across the single / AC-only / AC+DC layouts, and the outcome overlay was
                  added to one and forgotten on the rest. One declaration, one place to change.
               2. Its behaviour cannot live beside its markup. The toggle has only ONE declaration, so
                  rule 1 does not apply - it was extracted because its knob animation sat in this file's
                  code-behind and had to walk the visual tree to find its own icon, since x:Name is not
                  reachable inside a DataTemplate.

             Otherwise leave it inline. CheckBox, PowerPlan and Action are each a single declaration whose
             behaviour is fully expressed here, so wrapping them would buy symmetry and cost a file, a
             pair of dependency properties and a hop to read them. Symmetry is not a benefit.

             Either way, CardTemplateOutcomeCoverageTests enforces that any template hosting an input
             control also reports a value Winhance could not place - so correctness never depends on
             which side of this rule a control falls. -->

        <DataTemplate x:Key="ToggleSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <local:SettingToggleSwitch Setting="{x:Bind}"/>
        </DataTemplate>

        <!-- Template for Selection settings -->
        <!-- Selection and Numeric settings come in three flavours - one value, or a powercfg setting split into
             plugged-in and on-battery values. Each is ONE control (local:SettingComboBox / local:SettingNumberBox)
             owning its Quick-Set pair, its input and its outcome overlay; the AC-only and AC+DC layouts are one
             template apiece, with the battery column bound to HasBattery. -->

        <DataTemplate x:Key="SelectionSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <local:SettingComboBox Setting="{x:Bind}" Mode="Single"/>
        </DataTemplate>

        <DataTemplate x:Key="NumericSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <local:SettingNumberBox Setting="{x:Bind}" Mode="Single"/>
        </DataTemplate>

        <!-- Power selection: the on-battery column only exists on a machine with a battery. The 120px pin
             stops two columns growing to their widest item and squeezing the badges out of the row. -->
        <DataTemplate x:Key="PowerSelectionSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind PluggedInText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"
                               Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <local:SettingComboBox Setting="{x:Bind}" Mode="Ac"
                                           PinnedWidth="{x:Bind PowerColumnWidth(HasBattery), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Spacing="4"
                            Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind OnBatteryText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/>
                    <local:SettingComboBox Setting="{x:Bind}" Mode="Dc"
                                           PinnedWidth="{x:Bind PowerColumnWidth(HasBattery), Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PowerNumericSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind PluggedInText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"
                               Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <local:SettingNumberBox Setting="{x:Bind}" Mode="Ac"/>
                </StackPanel>
                <StackPanel Spacing="4"
                            Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind OnBatteryText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/>
                    <local:SettingNumberBox Setting="{x:Bind}" Mode="Dc"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- The power plan dropdown sources its options at runtime, so it keeps its own control - but it
             still reports an unplaceable state the same way every other input does. -->
        <DataTemplate x:Key="PowerPlanSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <Grid>
                <local:PowerPlanComboBox
                    ItemsSource="{x:Bind ComboBoxOptions}"
                    SelectedValue="{x:Bind SelectedValue, Mode=OneWay}"
                    Loaded="OnPowerPlanComboBoxLoaded"
                    Tag="{x:Bind}"
                    HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="{x:Bind SelectionOutcomeTooltip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"/>
                <local:SettingOutcomeOverlay Setting="{x:Bind}" Mode="Single" Margin="12,0,34,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <!-- The ONE input template with no outcome overlay, by design: an action button runs a task,
                 it does not display a detected state, so there is nothing for detection to fail to place.
                 CardTemplateOutcomeCoverageTests exempts this template by name. -->
            <Button
                Content="{x:Bind ActionButtonText}"
                Command="{x:Bind RunActionCommand}"
                AutomationProperties.Name="{x:Bind A11yName(ActionButtonText), Mode=OneWay}"/>
        </DataTemplate>

        <!-- Template Selector -->
        <selectors:SettingTemplateSelector
            x:Key="SettingTemplateSelector"
            ToggleTemplate="{StaticResource ToggleSettingTemplate}"
            SelectionTemplate="{StaticResource SelectionSettingTemplate}"
            PowerPlanTemplate="{StaticResource PowerPlanSettingTemplate}"
            NumericTemplate="{StaticResource NumericSettingTemplate}"
            ActionTemplate="{StaticResource ActionSettingTemplate}"
            PowerSelectionTemplate="{StaticResource PowerSelectionSettingTemplate}"
            PowerNumericTemplate="{StaticResource PowerNumericSettingTemplate}"/>
    </UserControl.Resources>

    <!-- Just the content control that selects the appropriate input control -->
    <ContentControl
        Content="{x:Bind Setting, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource SettingTemplateSelector}"
        IsTabStop="False"
        HorizontalContentAlignment="Stretch"/>
</UserControl>
