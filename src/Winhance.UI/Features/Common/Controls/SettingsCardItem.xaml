<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingsCardItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Place this INSIDE a SettingsCard, not as a standalone item in SettingsExpander.ItemTemplate.

    Every control type (except Action) is preceded by a pair
    of Quick-Set buttons: a green "Set to Recommended" and a grey "Set to Default"
    side-by-side. Visibility is driven by per-type ShowXQuickSetButtons flags on the
    ViewModel. The icons inside the buttons carry their own Foreground brush so the
    default Button.ContentPresenter ButtonForegroundPointerOver override does not
    wipe out the green/grey on hover — only the background hover tint renders.
    -->

    <!-- A locked setting stays readable: its control is greyed in place and the unlock button sits beside it. -->
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button
            Visibility="{x:Bind Setting.IsLocked, Mode=OneWay}"
            Command="{x:Bind Setting.UnlockCommand, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Setting.ClickToUnlockText, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Setting.ClickToUnlockText, Mode=OneWay}"
            VerticalAlignment="Center"
            Padding="8">
            <Grid>
                <Viewbox Width="16" Height="16" Visibility="{x:Bind Setting.HasFields, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform"/>
                </Viewbox>
                <FontIcon Glyph="&#xE70F;" FontSize="16" Visibility="{x:Bind Setting.HasFields, Mode=OneWay}"/>
            </Grid>
        </Button>
        <ContentControl
            Content="{x:Bind Setting, Mode=OneWay}"
            ContentTemplateSelector="{StaticResource SettingTemplateSelector}"
            IsEnabled="{x:Bind Setting.IsLocked, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
            IsTabStop="False"
            HorizontalContentAlignment="Stretch"/>
    </StackPanel>
</UserControl>
