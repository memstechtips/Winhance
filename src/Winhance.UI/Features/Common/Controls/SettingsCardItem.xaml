<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingsCardItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Winhance.UI.Features.Optimize.ViewModels"
    xmlns:selectors="using:Winhance.UI.Features.Common.TemplateSelectors"
    xmlns:interfaces="using:Winhance.Core.Features.Common.Interfaces"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:local="using:Winhance.UI.Features.Common.Controls">

    <!--
    This UserControl handles selecting and displaying the appropriate input control
    based on the Setting's InputType. It should be placed INSIDE a SettingsCard,
    not used as a standalone item in SettingsExpander.ItemTemplate.

    Every control type (except Action / CheckBox / PowerPlan) is preceded by a pair
    of Quick-Set buttons: a green "Set to Recommended" and a grey "Set to Default"
    side-by-side. Visibility is driven by per-type ShowXQuickSetButtons flags on the
    ViewModel. The icons inside the buttons carry their own Foreground brush so the
    default Button.ContentPresenter ButtonForegroundPointerOver override does not
    wipe out the green/grey on hover — only the background hover tint renders.
    -->

    <UserControl.Resources>
        <!-- ComboBoxEx needs explicit style inheritance to maintain rounded corners -->
        <Style TargetType="local:ComboBoxEx" BasedOn="{StaticResource DefaultComboBoxStyle}"/>

        <!-- Template for Toggle settings -->
        <DataTemplate x:Key="ToggleSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            Visibility="{x:Bind ShowToggleQuickSetButtons, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button
                        Style="{StaticResource QuickSetRecommendedButtonStyle}"
                        Command="{x:Bind SetToggleToRecommendedCommand}"
                        ToolTipService.ToolTip="{x:Bind ToggleRecommendedTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind A11yName(ToggleRecommendedTooltip), Mode=OneWay}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE735;" FontSize="14"
                                  Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                    </Button>
                    <Button
                        Style="{StaticResource QuickSetDefaultButtonStyle}"
                        Command="{x:Bind SetToggleToDefaultCommand}"
                        ToolTipService.ToolTip="{x:Bind ToggleDefaultTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind A11yName(ToggleDefaultTooltip), Mode=OneWay}">
                        <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                  Foreground="{ThemeResource BadgeDefaultForeground}"/>
                    </Button>
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <!-- The real ToggleSwitch is ALWAYS measured, in every state - it is what gives this
                         column its width, so the Quick-Set buttons land in the same place on an unresolved
                         row as on a normal one. It used to be Collapsed-swapped for the overlay, and the
                         overlay's hard-coded MinWidth="154" is far wider than a ToggleSwitch actually renders
                         (~72px), which shoved the Quick-Set buttons ~80px left (docs/Winhance.png).
                         While the setting is unresolved the switch stays in layout but goes invisible
                         (Opacity 0) and drops out of hit-testing, the tab order and the automation tree, so
                         the overlay above it is the only thing a pointer, the keyboard or Narrator reaches. -->
                    <ToggleSwitch
                        IsOn="{x:Bind IsSelected, Mode=OneWay}"
                        Toggled="{x:Bind OnToggleSwitchToggled}"
                        OnContent="{x:Bind OnText}"
                        OffContent="{x:Bind OffText}"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        Opacity="{x:Bind ToggleOpacityFor(Outcome), Mode=OneWay}"
                        IsHitTestVisible="{x:Bind ToggleInteractiveFor(Outcome), Mode=OneWay}"
                        IsTabStop="{x:Bind ToggleInteractiveFor(Outcome), Mode=OneWay}"
                        AutomationProperties.AccessibilityView="{x:Bind ToggleAccessibilityViewFor(Outcome), Mode=OneWay}"/>
                    <!-- Neutral detection-outcome overlay: a track-only stand-in for the ToggleSwitch,
                         drawn 2px larger than the stock 40x20 track (Marco's sizing feedback), with that
                         outcome's colour icon as the knob - the SAME icon the banner and the selection
                         adornment show, from one map in the VM - plus its matching short glyph
                         ("?" / "!" / "x") in the On/Off-content slot for column uniformity. Button chrome is
                         cleared (hover/pressed backgrounds transparent) so it reads as a toggle control, not
                         a pressable button. It carries NO size of its own: it stretches over the invisible
                         ToggleSwitch behind it, so the overlay's footprint IS the toggle's footprint and the
                         whole control area stays clickable. The knob grows slightly on pointer-over
                         (code-behind storyboards, mirroring the native ToggleSwitch); PointerExited,
                         PointerCanceled and PointerCaptureLost all shrink it back so it cannot stick
                         enlarged. The tooltip is the SAME string as that outcome's banner so the two can
                         never drift; the automation name is the outcome's STATE text.
                         Deliberately NOT a third selectable position (no accent color).
                         Clicking opens the Enabled/Disabled/Cancel dialog - EXCEPT for Undetermined, where
                         the VM's IsActionable gate makes the click a no-op, because we could not read the
                         current value and must not write blind over it. -->
                    <Button
                        Visibility="{x:Bind OverlayVisibilityFor(Outcome), Mode=OneWay}"
                        Click="{x:Bind OnCustomToggleClicked}"
                        PointerEntered="OnCustomOverlayPointerEntered"
                        PointerExited="OnCustomOverlayPointerExited"
                        PointerCanceled="OnCustomOverlayPointerExited"
                        PointerCaptureLost="OnCustomOverlayPointerExited"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Right"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind CustomStateToggleTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind CustomStateText, Mode=OneWay}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                        </Button.Resources>
                        <!-- Same order as the real toggles in this app: label LEFT, track flush at the
                             card's right edge (see docs screenshot 2026-07-24). -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind CustomStateShortLabel, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Border Width="42" Height="22" CornerRadius="11"
                                    Background="{ThemeResource ControlFillColorDisabledBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <fluentIcons:FluentIcon Icon="{x:Bind CustomStateIcon, Mode=OneWay}" IconVariant="Color" FontSize="16"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5">
                                    <fluentIcons:FluentIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </fluentIcons:FluentIcon.RenderTransform>
                                </fluentIcons:FluentIcon>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Template for Selection settings -->
        <!-- ==========================================================================================
             Selection and Numeric settings. Both come in three flavours - one value, or a powercfg
             setting split into plugged-in and on-battery values - and each flavour used to be its own
             hand-written template: four ComboBox declarations and four NumberBox declarations across
             eight templates. The overlay that reports a setting Winhance could not place had been added
             to one of them and forgotten on the other seven, which is how a powercfg dropdown ended up
             rendering blank with no explanation.

             They are now instances of ONE control each (local:SettingComboBox / local:SettingNumberBox),
             which owns its Quick-Set pair, its input, and its outcome overlay together. The AC-only and
             AC+DC layouts are one template apiece, with the battery column bound to HasBattery rather
             than split across two nearly identical copies.
             ========================================================================================== -->

        <DataTemplate x:Key="SelectionSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <local:SettingComboBox Setting="{x:Bind}" Mode="Single"/>
        </DataTemplate>

        <DataTemplate x:Key="NumericSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <local:SettingNumberBox Setting="{x:Bind}" Mode="Single"/>
        </DataTemplate>

        <!-- Power selection: the on-battery column only exists on a machine with a battery. The 120px pin
             stops two columns growing to their widest item and squeezing the badges out of the row. -->
        <DataTemplate x:Key="PowerSelectionSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind PluggedInText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"
                               Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <local:SettingComboBox Setting="{x:Bind}" Mode="Ac"
                                           PinnedWidth="{x:Bind PowerColumnWidth(HasBattery), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Spacing="4"
                            Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind OnBatteryText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/>
                    <local:SettingComboBox Setting="{x:Bind}" Mode="Dc"
                                           PinnedWidth="{x:Bind PowerColumnWidth(HasBattery), Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PowerNumericSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind PluggedInText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"
                               Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <local:SettingNumberBox Setting="{x:Bind}" Mode="Ac"/>
                </StackPanel>
                <StackPanel Spacing="4"
                            Visibility="{x:Bind HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind OnBatteryText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/>
                    <local:SettingNumberBox Setting="{x:Bind}" Mode="Dc"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- The power plan dropdown sources its options at runtime, so it keeps its own control - but it
             still reports an unplaceable state the same way every other input does. -->
        <DataTemplate x:Key="PowerPlanSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <Grid>
                <local:PowerPlanComboBox
                    ItemsSource="{x:Bind ComboBoxOptions}"
                    SelectedValue="{x:Bind SelectedValue, Mode=OneWay}"
                    Loaded="OnPowerPlanComboBoxLoaded"
                    Tag="{x:Bind}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"/>
                <local:SettingOutcomeOverlay Setting="{x:Bind}" Mode="Single" Margin="12,0,34,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <!-- The ONE input template with no outcome overlay, by design: an action button runs a task,
                 it does not display a detected state, so there is nothing for detection to fail to place.
                 CardTemplateOutcomeCoverageTests exempts this template by name. -->
            <Button
                Content="{x:Bind ActionButtonText}"
                Command="{x:Bind RunActionCommand}"
                AutomationProperties.Name="{x:Bind A11yName(ActionButtonText), Mode=OneWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxSettingTemplate" x:DataType="viewModels:SettingItemViewModel">
            <Grid>
                <CheckBox
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    Click="{x:Bind OnCheckBoxClick}"
                    Opacity="{x:Bind ToggleOpacityFor(Outcome), Mode=OneWay}"
                    IsHitTestVisible="{x:Bind ToggleInteractiveFor(Outcome), Mode=OneWay}"
                    IsTabStop="{x:Bind ToggleInteractiveFor(Outcome), Mode=OneWay}"
                    AutomationProperties.AccessibilityView="{x:Bind ToggleAccessibilityViewFor(Outcome), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"/>
                <local:SettingOutcomeOverlay Setting="{x:Bind}" Mode="Single" IsToggleLike="True"/>
            </Grid>
        </DataTemplate>


        <!-- Template Selector -->
        <selectors:SettingTemplateSelector
            x:Key="SettingTemplateSelector"
            ToggleTemplate="{StaticResource ToggleSettingTemplate}"
            SelectionTemplate="{StaticResource SelectionSettingTemplate}"
            PowerPlanTemplate="{StaticResource PowerPlanSettingTemplate}"
            NumericTemplate="{StaticResource NumericSettingTemplate}"
            ActionTemplate="{StaticResource ActionSettingTemplate}"
            CheckBoxTemplate="{StaticResource CheckBoxSettingTemplate}"
            PowerSelectionTemplate="{StaticResource PowerSelectionSettingTemplate}"
            PowerNumericTemplate="{StaticResource PowerNumericSettingTemplate}"/>
    </UserControl.Resources>

    <!-- Just the content control that selects the appropriate input control -->
    <ContentControl
        Content="{x:Bind Setting, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource SettingTemplateSelector}"
        IsTabStop="False"
        HorizontalContentAlignment="Stretch"/>
</UserControl>
