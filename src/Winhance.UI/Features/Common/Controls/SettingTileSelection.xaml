<?xml version="1.0" encoding="utf-8"?>
<local:SettingBoundControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingTileSelection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Common.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:viewModels="using:Winhance.UI.Features.Common.ViewModels">

    <local:SettingBoundControl.Resources>
        <DataTemplate x:Key="PictureTileTemplate" x:DataType="viewModels:OptionTileViewModel">
            <Button
                Width="96"
                Height="54"
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Click="{x:Bind Choose}"
                ToolTipService.ToolTip="{x:Bind Label}"
                AutomationProperties.Name="{x:Bind Label}">
                <Grid>
                    <Image
                        Source="{x:Bind Thumbnail}"
                        Stretch="UniformToFill"/>
                    <Border
                        x:Name="PictureSelectionBorder"
                        x:Load="{x:Bind IsSelected, Mode=OneWay}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ColorTileTemplate" x:DataType="viewModels:OptionTileViewModel">
            <Button
                Width="40"
                Height="40"
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Click="{x:Bind Choose}"
                AutomationProperties.Name="{x:Bind Label}">
                <Grid>
                    <Border
                        Background="{x:Bind Brush}"
                        CornerRadius="{StaticResource TileCornerRadius}"/>
                    <Border
                        x:Name="ColorSelectionBorder"
                        x:Load="{x:Bind IsSelected, Mode=OneWay}"
                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource TileCornerRadius}"/>
                    <fluentIcons:FluentIcon
                        x:Name="ColorSelectionCheck"
                        x:Load="{x:Bind IsSelected, Mode=OneWay}"
                        Icon="Checkmark"
                        IconVariant="Regular"
                        FontSize="{StaticResource CaptionIconFontSize}"
                        Foreground="White"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"/>
                </Grid>
            </Button>
        </DataTemplate>
    </local:SettingBoundControl.Resources>

    <Grid>
        <!-- Non-virtualising ItemsControl + UniformWrapPanel, not ItemsRepeater + UniformGridLayout: that pair
             produced a measure cycle that snapped the page's ScrollViewer to the top. -->
        <Grid x:Name="TileGrid" x:Load="{x:Bind local:SettingTileSelection.ShowsTiles(Part), Mode=OneWay}">
            <!-- Bounded: the setting's 3 Windows pictures, the shown picture and Windows' 5 recent ones, at most 9 -->
            <ItemsControl
                ItemsSource="{x:Bind Setting.Tiles, Mode=OneWay}"
                x:Name="PictureTiles"
                x:Load="{x:Bind local:SettingTileSelection.IsPictures(Setting), Mode=OneWay}"
                ItemTemplate="{StaticResource PictureTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:UniformWrapPanel ItemWidth="96" ItemHeight="54" ColumnSpacing="{StaticResource TileSpacing}" RowSpacing="{StaticResource TileSpacing}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Bounded: Windows' 24 background colours -->
            <ItemsControl
                ItemsSource="{x:Bind Setting.Tiles, Mode=OneWay}"
                x:Name="ColorTiles"
                x:Load="{x:Bind local:SettingTileSelection.IsColors(Setting), Mode=OneWay}"
                ItemTemplate="{StaticResource ColorTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:UniformWrapPanel ItemWidth="40" ItemHeight="40" ColumnSpacing="{StaticResource TileSpacing}" RowSpacing="{StaticResource TileSpacing}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <StackPanel
            x:Name="BrowsePanel"
            x:Load="{x:Bind local:SettingTileSelection.ShowsBrowse(Part), Mode=OneWay}"
            Orientation="Horizontal"
            Spacing="{StaticResource ControlGroupSpacing}"
            HorizontalAlignment="Right">
            <local:SettingOutcomeOverlay
                Setting="{x:Bind Setting, Mode=OneWay}"
                Mode="Single"
                VerticalAlignment="Center"/>

            <Button
                x:Name="BrowseButton"
                x:Load="{x:Bind local:SettingTileSelection.IsPictures(Setting), Mode=OneWay}"
                MinWidth="140"
                Content="{x:Bind Setting.BrowseLabel, Mode=OneWay}"
                Click="OnBrowseClick"
                AutomationProperties.Name="{x:Bind Setting.Name, Mode=OneWay}"/>

            <Button
                x:Name="ColorButton"
                x:Load="{x:Bind local:SettingTileSelection.IsColors(Setting), Mode=OneWay}"
                MinWidth="140"
                Content="{x:Bind Setting.BrowseLabel, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Setting.Name, Mode=OneWay}">
                <Button.Flyout>
                    <Flyout Closed="OnColorFlyoutClosed">
                        <ColorPicker
                            IsAlphaEnabled="False"
                            IsMoreButtonVisible="True"
                            Color="{x:Bind local:SettingTileSelection.ColorFor(Setting.SelectedValue), Mode=OneWay}"/>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</local:SettingBoundControl>
