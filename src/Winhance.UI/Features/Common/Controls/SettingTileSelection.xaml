<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingTileSelection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Common.Controls"
    xmlns:viewModels="using:Winhance.UI.Features.Common.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="PictureTileTemplate" x:DataType="viewModels:OptionTileViewModel">
            <Button
                Width="96"
                Height="54"
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Click="{x:Bind Choose}"
                ToolTipService.ToolTip="{x:Bind Label}"
                AutomationProperties.Name="{x:Bind Label}">
                <Grid>
                    <Image
                        Source="{x:Bind Thumbnail}"
                        Stretch="UniformToFill"/>
                    <Border
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ColorTileTemplate" x:DataType="viewModels:OptionTileViewModel">
            <Button
                Width="40"
                Height="40"
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Click="{x:Bind Choose}"
                AutomationProperties.Name="{x:Bind Label}">
                <Grid>
                    <Border
                        Background="{x:Bind Brush}"
                        CornerRadius="4"/>
                    <Border
                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <FontIcon
                        Glyph="&#xE73E;"
                        FontSize="12"
                        Foreground="White"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Non-virtualising ItemsControl + UniformWrapPanel, not ItemsRepeater + UniformGridLayout: that pair
             produced a measure cycle that snapped the page's ScrollViewer to the top. -->
        <Grid Visibility="{x:Bind TilesVisibility, Mode=OneWay}">
            <ItemsControl
                ItemsSource="{x:Bind Tiles, Mode=OneWay}"
                ItemTemplate="{StaticResource PictureTileTemplate}"
                Visibility="{x:Bind PictureVisibility, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:UniformWrapPanel ItemWidth="96" ItemHeight="54" ColumnSpacing="8" RowSpacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl
                ItemsSource="{x:Bind Tiles, Mode=OneWay}"
                ItemTemplate="{StaticResource ColorTileTemplate}"
                Visibility="{x:Bind ColorVisibility, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:UniformWrapPanel ItemWidth="40" ItemHeight="40" ColumnSpacing="8" RowSpacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <StackPanel
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Right"
            Visibility="{x:Bind BrowseVisibility, Mode=OneWay}">
            <local:SettingOutcomeOverlay
                Setting="{x:Bind Setting, Mode=OneWay}"
                Mode="Single"
                VerticalAlignment="Center"/>

            <Button
                MinWidth="140"
                Content="{x:Bind BrowseLabel, Mode=OneWay}"
                Click="OnBrowseClick"
                Visibility="{x:Bind PictureVisibility, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind SettingName, Mode=OneWay}"/>

            <Button
                MinWidth="140"
                Content="{x:Bind BrowseLabel, Mode=OneWay}"
                Visibility="{x:Bind ColorVisibility, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind SettingName, Mode=OneWay}">
                <Button.Flyout>
                    <Flyout Closed="OnColorFlyoutClosed">
                        <ColorPicker
                            IsAlphaEnabled="False"
                            IsMoreButtonVisible="True"
                            Color="{x:Bind PickedColor, Mode=TwoWay}"/>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
