<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.FeatureOutcomeBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Common.Controls">

    <!--
    Names the settings Winhance could not place on a feature's overview card, each a link to that
    setting. Margin -9 closes the parent StackPanel's 8px gap and overlaps the card border by 1.

    Severity stays Informational and the per-outcome colour lives on each ROW: colouring the whole bar
    by the worst outcome made the other kinds disappear.

    Rows are built in code because each is one wrapping TextBlock whose Inlines mix text with Hyperlink
    runs - TextBlock.Inlines cannot be data-bound, and a panel of link buttons would not reflow.
    -->
    <Border Visibility="{x:Bind BannerVisibility, Mode=OneWay}" Margin="0,-9,0,0">
        <local:QuietInfoBar
            IsOpen="{x:Bind IsBannerOpen, Mode=OneWay}"
            Severity="Informational"
            Message="{x:Bind BannerMessage, Mode=OneWay}"
            IsClosable="False"
            IsTabStop="True"
            UseSystemFocusVisuals="True"
            CornerRadius="0,0,4,4">
            <StackPanel x:Name="FragmentHost" Spacing="2" Margin="0,0,0,6"/>
        </local:QuietInfoBar>
    </Border>
</UserControl>
