<?xml version="1.0" encoding="utf-8"?>
<local:SettingBoundControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Common.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:interfaces="using:Winhance.Core.Features.Common.Interfaces"
    xmlns:selectors="using:Winhance.UI.Features.Common.TemplateSelectors">

    <!--
    A settings-card dropdown: its Quick-Set pair, the ComboBox itself, and its detection-outcome overlay,
    in ONE place. Every dropdown in the app is an instance of this - registry selections and the AC and DC
    halves of a powercfg selection alike - so "a combo box" is one thing, and a change to how a dropdown
    reports its state is a change to one file.
    -->
    <local:SettingBoundControl.Resources>
        <Style TargetType="local:ComboBoxEx" BasedOn="{StaticResource DefaultComboBoxStyle}"/>

        <DataTemplate x:Key="ComboBoxOptionSelectionTemplate" x:DataType="interfaces:ComboBoxDisplayOption">
            <TextBlock Text="{x:Bind DisplayText}" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="ComboBoxOptionRowTemplate" x:DataType="interfaces:ComboBoxDisplayOption">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse
                    x:Name="StatusIndicator"
                    x:Load="{x:Bind ShowsStatus}"
                    Grid.Column="0"
                    Width="8"
                    Height="8"
                    Margin="{StaticResource LeadingIconMargin}"
                    VerticalAlignment="Center"
                    Fill="{x:Bind local:SettingComboBox.StatusBrush(ExistsOnSystem)}"
                    ToolTipService.ToolTip="{x:Bind StatusTooltip}"/>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayText}" VerticalAlignment="Center"/>
                    <TextBlock
                        x:Name="ActiveBadge"
                        x:Load="{x:Bind IsActive}"
                        Text="{x:Bind ActiveBadgeText}"
                        FontSize="{StaticResource CaptionTextBlockFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 20x20 so the row keeps the default ComboBoxItem height. -->
                <Button
                    x:Name="DeleteButton"
                    x:Load="{x:Bind CanDelete}"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    MinWidth="20"
                    MinHeight="20"
                    Padding="0"
                    Margin="{StaticResource InlineLeadingMargin}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Click="OnDeleteButtonClick"
                    ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                    AutomationProperties.Name="{x:Bind DeleteTooltip}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#C42B1C</SolidColorBrush>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed">#B22A1C</SolidColorBrush>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver">White</SolidColorBrush>
                        <SolidColorBrush x:Key="ButtonForegroundPressed">White</SolidColorBrush>
                    </Button.Resources>
                    <Viewbox Width="14" Height="14" Margin="-5,-2,0,0">
                        <fluentIcons:FluentIcon Icon="Delete" IconVariant="Regular" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Viewbox>
                </Button>
            </Grid>
        </DataTemplate>

        <selectors:ComboBoxOptionTemplateSelector
            x:Key="ComboBoxOptionTemplateSelector"
            RowTemplate="{StaticResource ComboBoxOptionRowTemplate}"
            SelectionTemplate="{StaticResource ComboBoxOptionSelectionTemplate}"/>
    </local:SettingBoundControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="{StaticResource QuickSetSpacing}" VerticalAlignment="Center">
        <local:SettingQuickSetButtons
            Setting="{x:Bind Setting, Mode=OneWay}"
            Mode="{x:Bind Mode, Mode=OneWay}"
            Kind="Selection"/>

        <!-- HorizontalAlignment="Stretch" is load-bearing: a WinUI ComboBox measures its SELECTED item,
             not its widest, so with nothing selected it collapses to chevron-width. The overlay is
             measured, so the Grid takes the larger of the two and hands that width back here. -->
        <Grid>
            <local:ComboBoxEx
                x:Name="Input"
                ItemsSource="{x:Bind Setting.ComboBoxOptions, Mode=OneWay}"
                SelectedIndex="{x:Bind local:SettingComboBox.IndexFor(Setting, Mode, Setting.SelectedValue, Setting.AcValue, Setting.DcValue, Setting.ComboBoxOptions), Mode=OneWay}"
                SelectionChanged="OnSelectionChanged"
                DropDownClosed="OnDropDownClosed"
                KeyDown="OnInputKeyDown"
                Loaded="OnInputLoaded"
                Unloaded="OnInputUnloaded"
                ItemTemplateSelector="{StaticResource ComboBoxOptionTemplateSelector}"
                SelectedValuePath="Value"
                HorizontalAlignment="Stretch"
                ToolTipService.ToolTip="{x:Bind local:SettingComboBox.OutcomeTooltip(Setting, Mode, Setting.Outcome, Setting.SelectedValue, Setting.AcValue, Setting.DcValue), Mode=OneWay}"
                Width="{x:Bind PinnedWidth, Mode=OneWay}"
                MinWidth="{x:Bind local:SettingComboBox.MinWidthFor(PinnedWidth, Setting.ShowsOptionStatus), Mode=OneWay}"
                MaxWidth="{x:Bind local:SettingComboBox.MaxWidthForPin(PinnedWidth), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind local:SettingBoundControl.InputAutomationName(Setting, Mode, Setting.Name), Mode=OneWay}"/>
            <!-- Left margin matches the ComboBox's content inset so the text lands where a selected
                 item's text would; the right reserves the chevron's column. -->
            <local:SettingOutcomeOverlay
                Setting="{x:Bind Setting, Mode=OneWay}"
                Mode="{x:Bind Mode, Mode=OneWay}"
                Margin="12,0,34,0"/>
        </Grid>
    </StackPanel>
</local:SettingBoundControl>
