<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winhance.UI.Features.Common.Controls.SettingComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winhance.UI.Features.Common.Controls"
    xmlns:interfaces="using:Winhance.Core.Features.Common.Interfaces">

    <!--
    A settings-card dropdown: its Quick-Set pair, the ComboBox itself, and its detection-outcome overlay,
    in ONE place. Every dropdown in the app is an instance of this - registry selections and the AC and DC
    halves of a powercfg selection alike - so "a combo box" is one thing, and a change to how a dropdown
    reports its state is a change to one file.
    -->
    <UserControl.Resources>
        <Style TargetType="local:ComboBoxEx" BasedOn="{StaticResource DefaultComboBoxStyle}"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <local:SettingQuickSetButtons
            Setting="{x:Bind Setting, Mode=OneWay}"
            Mode="{x:Bind Mode, Mode=OneWay}"
            Kind="Selection"/>

        <!-- HorizontalAlignment="Stretch" is load-bearing: a WinUI ComboBox measures its SELECTED item,
             not its widest, so with nothing selected it collapses to chevron-width. The overlay is
             measured, so the Grid takes the larger of the two and hands that width back here. -->
        <Grid>
            <local:ComboBoxEx
                x:Name="Input"
                ItemsSource="{x:Bind Options, Mode=OneWay}"
                SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
                SelectionChanged="OnSelectionChanged"
                DropDownClosed="OnDropDownClosed"
                DropDownOpened="OnDropDownOpened"
                SelectedValuePath="Value"
                HorizontalAlignment="Stretch"
                ToolTipService.ToolTip="{x:Bind OutcomeTooltip, Mode=OneWay}"
                Width="{x:Bind PinnedWidth, Mode=OneWay}"
                MinWidth="{x:Bind PinnedMinWidth, Mode=OneWay}"
                MaxWidth="{x:Bind PinnedMaxWidth, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind InputAutomationName, Mode=OneWay}">
                <!-- The status dot, the Active badge and the delete button stay collapsed until the code-behind
                     turns them on per item. -->
                <local:ComboBoxEx.ItemTemplate>
                    <DataTemplate x:DataType="interfaces:ComboBoxDisplayOption">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                x:Name="StatusIndicator"
                                Grid.Column="0"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"/>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayText}" VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Name="ActiveBadge"
                                    Text=""
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- 20x20 so the row keeps the default ComboBoxItem height. -->
                            <Button
                                x:Name="DeleteButton"
                                Grid.Column="2"
                                Width="20"
                                Height="20"
                                MinWidth="20"
                                MinHeight="20"
                                Padding="0"
                                Margin="4,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#C42B1C</SolidColorBrush>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed">#B22A1C</SolidColorBrush>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver">White</SolidColorBrush>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed">White</SolidColorBrush>
                                </Button.Resources>
                                <Viewbox Width="14" Height="14" Margin="-5,-2,0,0">
                                    <PathIcon Data="{StaticResource DeleteForeverIconPath}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </local:ComboBoxEx.ItemTemplate>
            </local:ComboBoxEx>
            <!-- Left margin matches the ComboBox's content inset so the text lands where a selected
                 item's text would; the right reserves the chevron's column. -->
            <local:SettingOutcomeOverlay
                Setting="{x:Bind Setting, Mode=OneWay}"
                Mode="{x:Bind Mode, Mode=OneWay}"
                Margin="12,0,34,0"/>
        </Grid>
    </StackPanel>
</UserControl>
